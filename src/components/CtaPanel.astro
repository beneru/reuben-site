---
import { BOOKING } from '../../shared/booking';
---
<section id="demo" class="cta" aria-labelledby="cta-heading" data-reveal>
  <div class="cta-copy">
    <h2 id="cta-heading">Your market moves fast. <span>Your marketing systems should lead it.</span></h2>
    <p>Let's find where AI direction can multiply your content output and inbound leads. The audit is free and takes {BOOKING.slotMinutes} minutes.</p>
  </div>
  <div class="cta-actions">
    <a href="/#demo" class="btn btn-primary" data-open-booking>
      Book an audit <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
    <a href="https://instagram.com/Beneru.ai" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Chat on Instagram</a>
  </div>
</section>

<style>
  .cta {
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 28px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(103, 0, 255, 0.16) 0%, transparent 58%),
      var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-tint-border);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: end;
    gap: 2rem;
    scroll-margin-top: 96px;
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin-bottom: 1rem;
  }

  h2 span { color: var(--accent-ink); }

  p {
    color: var(--ink-2);
    font-size: var(--step-1);
    max-width: 48ch;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .btn-ghost { background: var(--glass-bg); }

  @media (max-width: 860px) {
    .cta { grid-template-columns: 1fr; align-items: start; }
    .cta-actions { justify-content: flex-start; }
  }

  @media (max-width: 420px) {
    .cta-actions .btn { flex: 1 1 100%; }
  }
</style>
