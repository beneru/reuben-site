---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { INSTAGRAM_URL } from '../../shared/socials';
import { CTA_COPY } from '../data/site';
---
<section id={CTA_COPY.id} class="cta" aria-labelledby="cta-heading" data-reveal>
  <div class="cta-copy">
    <h2 id="cta-heading">
      {CTA_COPY.headingLead}<span>{CTA_COPY.headingAccent}</span>
    </h2>
    <p>{CTA_COPY.body}</p>
  </div>
  <div class="cta-actions">
    <a href={spawntelFunnelUrl('cta')} class="btn btn-primary" data-spawntel-cta="cta">
      {CTA_COPY.primaryCtaLabel} <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
    <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
      {CTA_COPY.secondaryCtaLabel} ({CTA_COPY.secondaryCtaHandle})
    </a>
  </div>
</section>

<style>
  .cta {
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 28px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(103, 0, 255, 0.16) 0%, transparent 58%),
      var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-tint-border);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: end;
    gap: 2rem;
    scroll-margin-top: 96px;
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin-bottom: 1rem;
  }

  h2 span { color: var(--accent-ink); }

  p {
    color: var(--ink-2);
    font-size: var(--step-1);
    max-width: 52ch;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .btn-ghost { background: var(--glass-bg); }

  @media (max-width: 860px) {
    .cta { grid-template-columns: 1fr; align-items: start; }
    .cta-actions { justify-content: flex-start; }
  }

  @media (max-width: 420px) {
    .cta-actions .btn { flex: 1 1 100%; }
  }
</style>
