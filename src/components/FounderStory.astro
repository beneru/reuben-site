---
import { FOUNDER_COPY, SITE_IDENTITY } from '../data/site';

const photo = FOUNDER_COPY.photos[0];
---

<section class="section-block about-section has-float" id="about" aria-labelledby="about-heading" data-stage-section>
  <div class="float-scene" aria-hidden="true">
    <span
      class="float-pill float-pill--dark"
      data-pill-side="right"
      style="right: clamp(22px, 3vw, 64px); bottom: 52px;"
    >
      <span class="float-pill__dot"></span>
      Zero Fake Prices
    </span>
  </div>

  <div class="site-wrap">
    <div class="bento" data-stage-frames>
      <article class="bento-card bento-story theme-dark" data-frame-slide="left" data-shine="dark" style="--fi: 0">
        <h2 class="bento-eyebrow" id="about-heading">Who's behind Beneru</h2>
        <p class="bento-lead">{FOUNDER_COPY.lead}</p>
        <details class="story-more">
          <summary>Read the full story</summary>
          {FOUNDER_COPY.paragraphs.map((para) => (
            <p class="story-para">{para}</p>
          ))}
        </details>
      </article>

      <figure class="bento-card bento-photo theme-dark" data-frame-slide="right" data-shine="dark" style="--fi: 1">
        <p class="bento-photo__line">Understand it.<br />Then build it.</p>
        <div class="bento-photo__frame">
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <strong>{SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName})</strong>
          <span>{SITE_IDENTITY.role}, {SITE_IDENTITY.companyName}</span>
        </figcaption>
      </figure>

      <article class="bento-card bento-team theme-dark" data-frame-slide="left" data-shine="dark" style="--fi: 1.5">
        <p class="bento-eyebrow">The team</p>
        <h3>Built together with the <strong>Spawntel</strong> team.</h3>
        <ul class="team-chips">
          {FOUNDER_COPY.teamMembers.map((member) => (
            <li>{member}</li>
          ))}
        </ul>
      </article>

      <article class="bento-card bento-rules theme-dark" data-frame-slide="right" data-shine="dark" style="--fi: 2">
        <p class="bento-eyebrow">{FOUNDER_COPY.principlesHeading}</p>
        <ul class="principles-list">
          {FOUNDER_COPY.principles.map((rule) => (
            <li>
              <span class="principle-dot" aria-hidden="true"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.9fr);
    grid-template-areas:
      'story story photo'
      'team rules photo';
    gap: 16px;
    max-width: 1180px;
    margin-inline: auto;
  }

  .bento-card {
    margin: 0;
    border-radius: 28px;
    background: #15111E;
    padding: clamp(24px, 2.8vw, 36px);
    box-shadow: 0 16px 34px -22px rgba(13, 8, 20, 0.42);
  }

  .bento-eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    line-height: 1.3;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #C2AAFF;
  }

  .bento-story {
    grid-area: story;
    background:
      radial-gradient(65% 85% at 0% 0%, rgba(103, 0, 255, 0.22), transparent 62%),
      #0D0814;
  }

  .bento-lead {
    margin: 0 0 20px;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.7rem);
    font-weight: 500;
    line-height: 1.34;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    text-wrap: pretty;
  }

  .story-para {
    margin: 0;
    max-width: 70ch;
    font-size: 15.5px;
    line-height: 1.7;
    color: #C2BCD4;
  }

  .story-more summary {
    width: fit-content;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    color: #C2AAFF;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(194, 170, 255, 0.4);
  }

  .story-more summary::-webkit-details-marker {
    display: none;
  }

  .story-more[open] summary {
    margin-bottom: 16px;
  }

  .story-para + .story-para {
    margin-top: 14px;
  }

  .bento-photo {
    grid-area: photo;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background:
      radial-gradient(95% 90% at 100% 0%, rgba(183, 155, 255, 0.34), transparent 58%),
      linear-gradient(160deg, #6700FF 0%, #240D54 62%, #15111E 100%);
    box-shadow: 0 18px 38px -22px rgba(103, 0, 255, 0.46);
  }

  .bento-photo__line {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }

  .bento-photo__frame {
    aspect-ratio: 1 / 1;
    border-radius: 22px;
    overflow: hidden;
    background: #0D0814;
    box-shadow: 0 22px 44px -24px rgba(13, 8, 20, 0.65);
  }

  .bento-photo__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .bento-photo figcaption {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    color: #C2BCD4;
  }

  .bento-photo figcaption strong {
    font-size: 15px;
    color: #FFFFFF;
  }

  .bento-team {
    grid-area: team;
  }

  .bento-rules {
    grid-area: rules;
  }

  .bento-team h3 {
    margin: 0 0 18px;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.6rem);
    font-weight: 500;
    line-height: 1.25;
    color: #FFFFFF;
  }

  .bento-team h3 strong {
    font-weight: 700;
  }

  .team-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .team-chips li {
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: #FFFFFF;
    font-size: 13.5px;
    font-weight: 600;
    color: #0D0814;
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .principles-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.45;
    color: #FFFFFF;
  }

  .principle-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #B79BFF;
    margin-top: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 1020px) {
    .bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'story story'
        'photo team'
        'photo rules';
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'story'
        'photo'
        'team'
        'rules';
    }

    .bento-photo__frame {
      min-height: 0;
      aspect-ratio: 1 / 1;
    }
  }
</style>
