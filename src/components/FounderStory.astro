---
import { FOUNDER_COPY } from '../data/site';
---

<section class="section-block about-section" id="about" aria-labelledby="about-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{FOUNDER_COPY.pill}</span>
      <h2 class="grad-title" id="about-heading">{FOUNDER_COPY.heading}</h2>
    </div>

    <div class="story-spotlight" data-reveal>
      <blockquote class="story-quote">{FOUNDER_COPY.lead}</blockquote>
    </div>

    <div class="story-grid">
      <div class="story-copy" data-reveal>
        {FOUNDER_COPY.paragraphs.map((para) => (
          <p class="story-para">{para}</p>
        ))}

        <div class="story-block">
          <h3>{FOUNDER_COPY.teamHeading}</h3>
          <ul class="team-chips">
            {FOUNDER_COPY.teamMembers.map((member) => (
              <li>{member}</li>
            ))}
          </ul>
        </div>

        <div class="story-block">
          <h3>{FOUNDER_COPY.principlesHeading}</h3>
          <ul class="principles-list">
            {FOUNDER_COPY.principles.map((rule) => (
              <li>
                <span class="principle-dot" aria-hidden="true"></span>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="story-gallery" data-reveal style="--i: 1">
        {FOUNDER_COPY.photos.map((photo, idx) => (
          <figure class={`story-photo ${idx === 0 ? 'story-photo--square' : 'story-photo--tall'}`}>
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story-spotlight {
    max-width: 960px;
    margin: 0 auto clamp(40px, 5.5vw, 68px);
    text-align: center;
  }

  .story-quote {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 1.05rem + 1.5vw, 2.35rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4.5vw, 64px);
    align-items: start;
  }

  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 28px;
    border: 1px solid var(--border);
    background: linear-gradient(165deg, rgba(22, 22, 27, 0.9), rgba(14, 14, 18, 0.96));
  }

  .story-para {
    margin: 0;
    font-size: 16px;
    line-height: 1.72;
    color: #D2D2DA;
  }

  .story-block {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .story-block h3 {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--violet-soft);
  }

  .team-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .team-chips li {
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .principles-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 15px;
    line-height: 1.5;
    color: #E2E2E8;
  }

  .principle-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 12px rgba(103, 0, 255, 0.9);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .story-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .story-photo {
    margin: 0;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #141418;
    position: relative;
  }

  .story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-photo--square img {
    aspect-ratio: 4 / 5;
    object-position: center 15%;
  }

  .story-photo--tall img {
    aspect-ratio: 4 / 5;
    object-position: center 20%;
  }

  .story-photo figcaption {
    padding: 12px 14px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--ink-2);
    background: #141418;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .story-spotlight {
      text-align: left;
      margin-bottom: 28px;
    }

    .story-quote {
      font-size: 1.25rem;
      line-height: 1.4;
    }
  }

  @media (max-width: 560px) {
    .story-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
