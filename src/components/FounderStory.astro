---
import { FOUNDER_COPY, SITE_IDENTITY } from '../data/site';

const photo = FOUNDER_COPY.photos[0];
---

<section class="section-block about-section" id="about" aria-labelledby="about-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{FOUNDER_COPY.pill}</span>
      <h2 class="grad-title" id="about-heading">{FOUNDER_COPY.heading}</h2>
    </div>

    <div class="story-spotlight" data-reveal>
      <blockquote class="story-quote">{FOUNDER_COPY.lead}</blockquote>
    </div>

    <div class="bento">
      <article class="bento-card bento-story" data-reveal>
        <p class="bento-label">The short version</p>
        {FOUNDER_COPY.paragraphs.map((para) => (
          <p class="story-para">{para}</p>
        ))}
      </article>

      <figure class="bento-card bento-photo" data-reveal style="--i: 1">
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <strong>{SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName})</strong>
          <span>{SITE_IDENTITY.role}, {SITE_IDENTITY.companyName}</span>
        </figcaption>
      </figure>

      <article class="bento-card bento-team" data-reveal style="--i: 2">
        <h3>{FOUNDER_COPY.teamHeading}</h3>
        <ul class="team-chips">
          {FOUNDER_COPY.teamMembers.map((member) => (
            <li>{member}</li>
          ))}
        </ul>
      </article>

      <article class="bento-card bento-rules" data-reveal style="--i: 3">
        <h3>{FOUNDER_COPY.principlesHeading}</h3>
        <ul class="principles-list">
          {FOUNDER_COPY.principles.map((rule) => (
            <li>
              <span class="principle-dot" aria-hidden="true"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .story-spotlight {
    max-width: 960px;
    margin: 0 auto clamp(40px, 5.5vw, 68px);
    text-align: center;
  }

  .story-quote {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 1.05rem + 1.5vw, 2.35rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  /* Bento: story wide, portrait tall, team and principles underneath */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.86fr);
    grid-template-areas:
      'story story photo'
      'team rules photo';
    gap: 16px;
  }

  .bento-card {
    margin: 0;
    border-radius: 26px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    box-shadow: var(--glass-rim);
    padding: clamp(22px, 2.6vw, 34px);
  }

  .bento-story {
    grid-area: story;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bento-label {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--violet-soft);
  }

  .story-para {
    margin: 0;
    max-width: 68ch;
    font-size: 16px;
    line-height: 1.72;
    color: #D2D2DA;
  }

  .bento-photo {
    grid-area: photo;
    position: relative;
    padding: 0;
    overflow: hidden;
    min-height: 420px;
  }

  .bento-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .bento-photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 56px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: linear-gradient(transparent, rgba(11, 11, 12, 0.92) 55%);
    font-size: 13px;
    color: var(--ink-2);
  }

  .bento-photo figcaption strong {
    font-size: 15px;
    color: #FFFFFF;
  }

  .bento-team {
    grid-area: team;
  }

  .bento-rules {
    grid-area: rules;
  }

  .bento-team h3,
  .bento-rules h3 {
    margin: 0 0 16px;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 600;
    color: var(--ink);
  }

  .team-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .team-chips li {
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .principles-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 15px;
    line-height: 1.5;
    color: #E2E2E8;
  }

  .principle-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 12px rgba(103, 0, 255, 0.9);
    margin-top: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 1020px) {
    .bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'story story'
        'photo team'
        'photo rules';
    }
  }

  @media (max-width: 640px) {
    .story-spotlight {
      text-align: left;
      margin-bottom: 28px;
    }

    .story-quote {
      font-size: 1.25rem;
      line-height: 1.4;
    }

    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'story'
        'photo'
        'team'
        'rules';
    }

    .bento-photo {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }
</style>
