---
import { FOUNDER_COPY } from '../data/site';
---

<section class="section-block about-section" id="about" aria-labelledby="about-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{FOUNDER_COPY.pill}</span>
      <h2 class="section-title" id="about-heading">
        Who's behind <span class="accent-word">Beneru</span>
      </h2>
    </div>

    <div class="story-grid">
      <div class="story-copy" data-reveal>
        <p class="story-lead">{FOUNDER_COPY.lead}</p>

        {FOUNDER_COPY.paragraphs.map((para) => (
          <p class="story-para">{para}</p>
        ))}

        <div class="story-block">
          <h3>{FOUNDER_COPY.teamHeading}</h3>
          <ul class="team-chips">
            {FOUNDER_COPY.teamMembers.map((member) => (
              <li>{member}</li>
            ))}
          </ul>
        </div>

        <div class="story-block">
          <h3>{FOUNDER_COPY.principlesHeading}</h3>
          <ul class="principles-list">
            {FOUNDER_COPY.principles.map((rule) => (
              <li>
                <span class="principle-dot" aria-hidden="true"></span>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="story-gallery" data-reveal style="--i: 1">
        {FOUNDER_COPY.photos.map((photo) => (
          <figure class="story-photo">
            <div class="story-photo-frame">
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 3.2vw, 38px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-1);
  }

  .story-lead {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.38rem);
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .story-para {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .story-block {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .story-block h3 {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--violet-soft);
  }

  .team-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .team-chips li {
    padding: 6px 13px;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-body);
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .principles-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-body);
  }

  .principle-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 10px rgba(103, 0, 255, 0.85);
    margin-top: 9px;
    flex-shrink: 0;
  }

  .story-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .story-photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-1);
  }

  .story-photo-frame {
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
  }

  .story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .story-photo figcaption {
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-muted);
    background: var(--surface-1);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .story-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
