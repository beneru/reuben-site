---
import { OUTCOMES_SECTION_COPY, OUTCOME_ITEMS } from '../data/site';
---

<section class="section-block" id="outcomes" aria-labelledby="outcomes-title">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{OUTCOMES_SECTION_COPY.pill}</span>
      <h2 class="grad-title" id="outcomes-title">{OUTCOMES_SECTION_COPY.heading}</h2>
    </div>

    <ol class="oc" data-oc-list>
      {OUTCOME_ITEMS.map((item) => (
        <li class="oc-row">
          <span class="oc-check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 12.5l4 4 8-9" />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const ocList = document.querySelector<HTMLElement>('[data-oc-list]');
  if (ocList) {
    const rows = Array.from(ocList.children) as HTMLElement[];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      rows.forEach((r) => r.setAttribute('data-on', 'true'));
    } else {
      let lit = 0;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const idx = rows.indexOf(entry.target as HTMLElement);
              lit = Math.max(lit, idx + 1);
              rows.forEach((r, i) => {
                if (i < lit) r.setAttribute('data-on', 'true');
              });
            }
          }
        },
        { rootMargin: '0px 0px -28% 0px', threshold: 0.1 },
      );
      rows.forEach((r) => io.observe(r));
    }
  }
</script>

<style>
  .oc {
    list-style: none;
    margin: clamp(16px, 2.5vw, 32px) auto 0;
    padding: 0;
    max-width: 1160px;
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 5vw, 68px);
  }

  .oc-row {
    display: grid;
    grid-template-columns: clamp(44px, 4.2vw, 58px) minmax(0, 1fr) minmax(0, 32ch);
    align-items: center;
    gap: clamp(18px, 2.6vw, 38px);
    opacity: 0.32;
    transition: opacity 0.65s var(--ease-out);
  }

  .oc-row[data-on='true'],
  :global(html:not(.js)) .oc-row {
    opacity: 1;
  }

  .oc-check {
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(103, 0, 255, 0.16);
    color: #BEA0FF;
    display: grid;
    place-items: center;
    transition: background-color 0.65s ease, box-shadow 0.65s ease, color 0.65s ease;
  }

  .oc-row[data-on='true'] .oc-check,
  :global(html:not(.js)) .oc-row .oc-check {
    background: var(--primary);
    color: #FFFFFF;
    box-shadow: 0 0 42px -4px rgba(103, 0, 255, 0.82);
  }

  .oc-check svg {
    width: 46%;
    height: 46%;
  }

  .oc-row h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 1.15rem + 2.8vw, 3.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .oc-row p {
    margin: 0;
    color: var(--ink-2);
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .oc-row {
      grid-template-columns: 44px minmax(0, 1fr);
      row-gap: 10px;
      align-items: start;
    }

    .oc-row p {
      grid-column: 2;
      max-width: 38ch;
    }
  }
</style>
