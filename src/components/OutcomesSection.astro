---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { OUTCOMES_SECTION_COPY, OUTCOME_ITEMS } from '../data/site';
---

<section class="section-block" id="outcomes" aria-labelledby="outcomes-title">
  <div class="site-wrap">
    <div class="oc-split">
      <div class="oc-intro" data-reveal>
        <span class="pill-tag">{OUTCOMES_SECTION_COPY.pill}</span>
        <h2 class="section-title" id="outcomes-title">
          What changes when marketing runs on <span class="accent-word">systems</span>
        </h2>
        <p class="section-sub">
          You keep creative direction and final approval. Your systems carry the repeat extraction, qualification, and follow-up.
        </p>
        <div class="oc-cta">
          <a href={spawntelFunnelUrl('problem')} class="cta-btn" data-spawntel-cta="problem">
            <span>Map your workflow</span>
            <span class="cta-btn__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      <ol class="oc-list">
        {OUTCOME_ITEMS.map((item, idx) => (
          <li class="oc-item" data-reveal style={`--i: ${idx}`}>
            <span class="oc-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 12.5l4 4 8-9" />
              </svg>
            </span>
            <div class="oc-copy">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .oc-split {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .oc-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    position: sticky;
    top: calc(var(--nav-h) + 28px);
  }

  .oc-cta {
    margin-top: 8px;
  }

  .oc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .oc-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: clamp(20px, 2.5vw, 28px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-1);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .oc-item:hover {
    border-color: var(--border-violet);
    background: var(--surface-2);
  }

  .oc-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--primary);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .oc-icon svg {
    width: 20px;
    height: 20px;
  }

  .oc-copy h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.55rem);
    font-weight: 700;
    color: var(--ink);
  }

  .oc-copy p {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .oc-split {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .oc-intro {
      position: static;
    }
  }
</style>
