---
import data from '../data/credentials.json';

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const credentials = [...data.credentials].sort((a, b) => b.date.localeCompare(a.date));
---

<section class="section-block cr" id="credentials" aria-labelledby="cr-title">
  <div class="site-wrap">
    <div class="cr-head" data-reveal>
      <h2 class="cr-title" id="cr-title">Credentials</h2>
      <p class="cr-sub">Earned through Google programs on Coursera. Each one links to its public verification page.</p>
    </div>

    <ul class="cr-grid">
      {credentials.map((c, i) => (
        <li class="cr-card" data-reveal style={`--i: ${i}`}>
          <p class="cr-kind">{c.kind}</p>
          <h3>{c.title}</h3>
          <p class="cr-detail">{c.detail}</p>
          <p class="cr-meta">
            <span>{c.issuer}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{c.platform}</span>
            <span aria-hidden="true">&middot;</span>
            <time datetime={c.date}>{fmt.format(new Date(`${c.date}T00:00:00Z`))}</time>
          </p>
          <div class="cr-actions">
            <a class="cr-btn cr-btn--solid" href={`/credentials/${c.slug}.pdf`} target="_blank" rel="noopener">
              View certificate
            </a>
            <a class="cr-btn" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
              Verify on Coursera <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cr-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  .cr-title {
    margin: 0;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .cr-sub {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .cr-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 18px;
  }

  .cr-card {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.8vw, 34px);
    border-radius: 26px;
    background: #FFFFFF;
    box-shadow: 0 26px 50px -32px rgba(103, 0, 255, 0.45);
  }

  .cr-kind {
    margin: 0;
    width: fit-content;
    padding: 5px 12px;
    border-radius: 999px;
    background: linear-gradient(155deg, #6700FF 0%, #8F4DFF 100%);
    color: #FFFFFF;
    font-size: 12.5px;
    font-weight: 600;
  }

  .cr-card h3 {
    margin: 18px 0 0;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .cr-detail {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .cr-meta {
    margin: 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .cr-actions {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    background: #F0EDF7;
    color: #0D0814;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.16s ease, transform 0.2s var(--ease-out);
  }

  .cr-btn:hover {
    background: #D7C8FF;
    transform: translateY(-1px);
  }

  .cr-btn--solid {
    background: #0D0814;
    color: #FFFFFF;
  }

  .cr-btn--solid:hover {
    background: #15111E;
    color: #FFFFFF;
  }
</style>
