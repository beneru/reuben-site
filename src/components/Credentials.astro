---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import data from '../data/credentials.json';

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const credentials = [...data.credentials]
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((c) => ({
    ...c,
    hasPreview: existsSync(join(process.cwd(), 'public', 'credentials', `${c.slug}.webp`)),
  }));
---

<section class="section-block cr has-float" id="credentials" aria-labelledby="cr-title" data-stage-section>
  <div class="float-scene" aria-hidden="true">
    <img
      class="side-cloud side-cloud--left"
      src="/images/clouds/side-cloud-left-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="top: 10%;"
    />
    <img
      class="side-cloud side-cloud--right"
      src="/images/clouds/side-cloud-right-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="bottom: 6%;"
    />
  </div>

  <div class="site-wrap">
    <div class="cr-head" data-reveal>
      <h2 class="cr-title" id="cr-title">Credentials</h2>
      <p class="cr-sub">Completed through Google on Coursera. Click any certificate to verify it online.</p>
    </div>

    <ul class="cr-grid" data-stage-frames>
      {credentials.map((c, i) => (
        <li
          class="cr-card"
          data-frame-slide={i % 2 === 0 ? 'left' : 'right'}
          data-shine="light"
          style={`--fi: ${i}`}
        >
          {c.hasPreview && (
            <a
              class="cr-tray"
              href={`/credentials/${c.slug}.pdf`}
              target="_blank"
              rel="noopener"
              aria-label={`Open ${c.title} certificate PDF`}
            >
              <span class="cr-kind">{c.kind}</span>
              <div class="cr-sheet">
                <img
                  src={`/credentials/${c.slug}.webp`}
                  alt={`${c.title} certificate issued by ${c.issuer} through ${c.platform}`}
                  width="960"
                  height="742"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>
          )}

          <div class="cr-body">
            {!c.hasPreview && <p class="cr-kind cr-kind--inline">{c.kind}</p>}
            <h3>{c.title}</h3>
            <p class="cr-detail">{c.detail}</p>
            <p class="cr-meta">
              <span class="cr-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <span>{c.issuer}</span>
              <span aria-hidden="true">&middot;</span>
              <span>{c.platform}</span>
              <span aria-hidden="true">&middot;</span>
              <time datetime={c.date}>{fmt.format(new Date(`${c.date}T00:00:00Z`))}</time>
            </p>
            <div class="cr-actions">
              <a class="cr-btn cr-btn--solid" href={`/credentials/${c.slug}.pdf`} target="_blank" rel="noopener">
                View certificate
              </a>
              <a class="cr-btn" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
                Verify on Coursera <span aria-hidden="true">&nearr;</span>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cr-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  .cr-title {
    margin: 0;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .cr-sub {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .cr-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 22px;
  }

  .cr-card {
    display: flex;
    flex-direction: column;
    border-radius: 28px;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 0 16px 34px -22px rgba(103, 0, 255, 0.32);
    transition: transform 0.24s var(--ease-expo);
  }

  .cr-card:hover {
    transform: translate3d(0, -4px, 0);
  }

  /* Flat brand-gradient preview tray: zero borders, real PDF certificate sheet */
  .cr-tray {
    position: relative;
    display: block;
    padding: clamp(20px, 2.4vw, 28px);
    background: var(--frame-bg);
    overflow: hidden;
  }

  .cr-kind {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #FFFFFF;
    color: #0D0814;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 10px 24px -14px rgba(13, 8, 20, 0.45);
  }

  .cr-kind--inline {
    margin: 0 0 14px;
    width: fit-content;
    background: #F0EDF7;
    box-shadow: none;
  }

  .cr-sheet {
    margin-top: 16px;
    border-radius: 14px;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 0 14px 28px -16px rgba(13, 8, 20, 0.38);
    transition: transform 0.3s var(--ease-expo);
  }

  .cr-card:hover .cr-sheet {
    transform: translate3d(0, -4px, 0);
  }

  .cr-sheet img {
    display: block;
    width: 100%;
    height: auto;
  }

  .cr-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.8vw, 32px);
  }

  .cr-body h3 {
    margin: 0;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #0D0814;
  }

  .cr-detail {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .cr-meta {
    margin: 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 600;
    color: #0D0814;
  }

  .cr-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #6700FF;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .cr-check svg {
    width: 11px;
    height: 11px;
  }

  .cr-actions {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    background: #F0EDF7;
    color: #0D0814;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.16s ease, transform 0.2s var(--ease-out);
  }

  .cr-btn:hover {
    background: #D7C8FF;
    transform: translateY(-1px);
  }

  .cr-btn--solid {
    background: #0D0814;
    color: #FFFFFF;
  }

  .cr-btn--solid:hover {
    background: #15111E;
    color: #FFFFFF;
  }
</style>
