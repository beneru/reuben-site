---
/**
 * Booking modal: calendar -> time slot -> details -> confirmation.
 * Open it from any element with the attribute `data-open-booking`,
 * or by visiting the page with #book in the URL.
 * Talks to the Worker API: GET /api/slots, POST /api/book.
 */
import { BOOKING, GOALS, MEETING_TYPES } from '../../shared/booking';
---

<dialog id="bookingModal" class="bm force-light" aria-labelledby="bmTitle">
  <div class="bm-card">
    <button type="button" class="bm-close" data-bm-close aria-label="Close booking">&times;</button>

    <header class="bm-header">
      <span class="bm-badge">Free {BOOKING.slotMinutes}-minute AI marketing audit</span>
      <h3 id="bmTitle">Book your AI marketing audit</h3>
      <ol class="bm-steps" aria-label="Booking steps">
        <li data-bm-ind="1" class="is-active">Date &amp; time</li>
        <li data-bm-ind="2">Your details</li>
        <li data-bm-ind="3">Confirmed</li>
      </ol>
    </header>

    <!-- Step 1: date + time -->
    <section data-bm-step="1">
      <div class="bm-grid">
        <div class="bm-cal">
          <div class="bm-cal-head">
            <button type="button" class="bm-nav" data-bm-prev aria-label="Previous month">&#8249;</button>
            <strong data-bm-month aria-live="polite"></strong>
            <button type="button" class="bm-nav" data-bm-next aria-label="Next month">&#8250;</button>
          </div>
          <div class="bm-weekdays" aria-hidden="true">
            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
          </div>
          <div class="bm-days" data-bm-days></div>
        </div>

        <div class="bm-slots">
          <div class="bm-slots-header">
            <p class="bm-slots-title" data-bm-slots-title>Available times</p>
            <p class="bm-tz">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {BOOKING.slotMinutes}-min call &bull; {BOOKING.timezoneLabel}
            </p>
          </div>

          <div class="bm-slot-container" data-bm-slots-container>
            <!-- Morning group -->
            <div class="bm-slot-section">
              <div class="bm-slot-section-title">
                <span class="bm-slot-time-badge">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                  Morning
                </span>
                <small>9:00 AM to 11:30 AM</small>
              </div>
              <div class="bm-slot-grid" data-bm-slots-morning>
                <p class="bm-hint">Loading times...</p>
              </div>
            </div>

            <!-- Afternoon group -->
            <div class="bm-slot-section">
              <div class="bm-slot-section-title">
                <span class="bm-slot-time-badge">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 10V2"/><path d="m4.93 10.93 1.41-1.41"/><path d="M2 18h2"/><path d="M20 18h2"/><path d="m19.07 10.93-1.41-1.41"/><path d="M22 22H2"/><path d="m16 6-4-4-4 4"/><path d="M16 18a4 4 0 0 0-8 0"/></svg>
                  Afternoon
                </span>
                <small>1:00 PM to 5:30 PM</small>
              </div>
              <div class="bm-slot-grid" data-bm-slots-afternoon>
                <p class="bm-hint">Loading times...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="bm-error" data-bm-error1 role="alert" hidden></p>
      <div class="bm-actions">
        <button type="button" class="bm-btn bm-btn-primary" data-bm-continue disabled>Select a time above</button>
      </div>
    </section>

    <!-- Step 2: details -->
    <section data-bm-step="2" hidden>
      <div class="bm-picked">
        <div class="bm-picked-info">
          <span class="bm-picked-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
          <span data-bm-picked></span>
        </div>
        <button type="button" class="bm-link" data-bm-back>Change date or time</button>
      </div>

      <form class="bm-form" data-bm-form novalidate>
        <div class="bm-row">
          <label class="bm-field">
            <span>Your name</span>
            <input name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Juan Dela Cruz" />
          </label>
          <label class="bm-field">
            <span>Business name</span>
            <input name="business" type="text" autocomplete="organization" required maxlength="160" placeholder="Cafe Luna" />
          </label>
        </div>
        <div class="bm-row">
          <label class="bm-field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@business.ph" />
          </label>
          <label class="bm-field">
            <span>Phone / Viber <em>(optional)</em></span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="0917 123 4567" />
          </label>
        </div>
        <div class="bm-row">
          <label class="bm-field">
            <span>What do you want to direct with AI first?</span>
            <select name="goal" required>
              {Object.entries(GOALS).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label class="bm-field">
            <span>Meeting Format</span>
            <select name="meeting_type" required>
              {Object.entries(MEETING_TYPES).map(([value, label]) => (
                <option value={value} selected={value === 'google_meet'}>{label}</option>
              ))}
            </select>
          </label>
        </div>
        <label class="bm-field">
          <span>Anything I should know? <em>(optional)</em></span>
          <textarea name="notes" rows="3" maxlength="2000" placeholder="e.g. We want to repurpose founder video to IG/LinkedIn and qualify inbound leads automatically in DMs."></textarea>
        </label>

        <!-- Honeypot. Hidden from people, bots fill it. -->
        <label class="bm-hp" aria-hidden="true">
          Website <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <p class="bm-error" data-bm-error2 role="alert" hidden></p>
        <button type="submit" class="bm-btn bm-btn-primary bm-submit" data-bm-submit>Confirm booking &rarr;</button>
      </form>
    </section>

    <!-- Step 3: done -->
    <section data-bm-step="3" hidden class="bm-done">
      <div class="bm-done-card">
        <span class="bm-check" aria-hidden="true">&#10003;</span>
        <h4>You're all booked!</h4>
        <p class="bm-done-intro">Your free AI marketing audit has been scheduled with Ben.</p>

        <div class="bm-done-details">
          <div class="bm-done-item">
            <span class="bm-done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
            </span>
            <div>
              <strong data-bm-done-datetime>Loading schedule...</strong>
              <small>Philippine Time (PHT, UTC+8)</small>
            </div>
          </div>
          <div class="bm-done-item">
            <span class="bm-done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            </span>
            <div>
              <strong data-bm-done-meeting>Google Meet</strong>
              <small>Meeting link or call details will be provided before our session</small>
            </div>
          </div>
          <div class="bm-done-item">
            <span class="bm-done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div>
              <strong>{BOOKING.slotMinutes} minutes</strong>
              <small>Live 1-on-1 marketing direction audit</small>
            </div>
          </div>
          <div class="bm-done-item">
            <span class="bm-done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <div>
              <strong>Confirmation sent</strong>
              <small data-bm-done-email-note>Details recorded for reubenmagallanes91@gmail.com</small>
            </div>
          </div>
        </div>

        <p class="bm-muted">Add this to your calendar so you don't miss our audit:</p>

        <div class="bm-done-actions">
          <a class="bm-btn bm-btn-primary" data-bm-gcal href="#" target="_blank" rel="noopener noreferrer">
            Add to Google Calendar
          </a>
          <a class="bm-btn bm-btn-ghost" data-bm-ics href="#" download="beneru-ai-marketing-audit.ics">
            Download .ics Calendar
          </a>
        </div>

        <div class="bm-done-footer">
          <button type="button" class="bm-btn bm-btn-close" data-bm-close>Done &amp; Close</button>
        </div>
      </div>
    </section>
  </div>
</dialog>

<script>
  import {
    BOOKING,
    addDays,
    findFirstOpenDate,
    formatDateLabel,
    formatSlotLabel,
    isBookableDate,
    manilaNow,
  } from '../../shared/booking';

  type Slot = { time: string; label: string; available: boolean };

  const modal = document.getElementById('bookingModal') as HTMLDialogElement | null;

  if (modal) {
    const $ = <T extends Element>(sel: string) => modal.querySelector(sel) as T;

    const monthLabel = $<HTMLElement>('[data-bm-month]');
    const daysEl = $<HTMLElement>('[data-bm-days]');
    const prevBtn = $<HTMLButtonElement>('[data-bm-prev]');
    const nextBtn = $<HTMLButtonElement>('[data-bm-next]');
    const slotsTitle = $<HTMLElement>('[data-bm-slots-title]');
    const morningGrid = $<HTMLElement>('[data-bm-slots-morning]');
    const afternoonGrid = $<HTMLElement>('[data-bm-slots-afternoon]');
    const continueBtn = $<HTMLButtonElement>('[data-bm-continue]');
    const backBtn = $<HTMLButtonElement>('[data-bm-back]');
    const pickedEl = $<HTMLElement>('[data-bm-picked]');
    const form = $<HTMLFormElement>('[data-bm-form]');
    const submitBtn = $<HTMLButtonElement>('[data-bm-submit]');
    const error1 = $<HTMLElement>('[data-bm-error1]');
    const error2 = $<HTMLElement>('[data-bm-error2]');
    const doneDatetime = $<HTMLElement>('[data-bm-done-datetime]');
    const doneMeeting = $<HTMLElement>('[data-bm-done-meeting]');
    const doneEmailNote = $<HTMLElement>('[data-bm-done-email-note]');
    const gcalLink = $<HTMLAnchorElement>('[data-bm-gcal]');
    const icsLink = $<HTMLAnchorElement>('[data-bm-ics]');

    const today = manilaNow().date;
    const lastDay = addDays(today, BOOKING.maxDaysAhead);
    const minMonth = today.slice(0, 7);
    const maxMonth = lastDay.slice(0, 7);

    let viewMonth = minMonth; // YYYY-MM
    let selectedDate: string | null = null;
    let selectedTime: string | null = null;
    let slotRequest = 0;

    const showError = (el: HTMLElement, msg: string | null) => {
      el.textContent = msg ?? '';
      el.hidden = !msg;
    };

    const goToStep = (step: 1 | 2 | 3) => {
      modal.querySelectorAll<HTMLElement>('[data-bm-step]').forEach((s) => {
        s.hidden = s.dataset.bmStep !== String(step);
      });
      modal.querySelectorAll<HTMLElement>('[data-bm-ind]').forEach((li) => {
        const n = Number(li.dataset.bmInd);
        li.classList.toggle('is-active', n === step);
        li.classList.toggle('is-done', n < step);
      });
    };

    const shiftMonth = (ym: string, delta: number) => {
      const [y, m] = ym.split('-').map(Number);
      const d = new Date(Date.UTC(y, m - 1 + delta, 1));
      return d.toISOString().slice(0, 7);
    };

    function renderCalendar() {
      const [y, m] = viewMonth.split('-').map(Number);
      const first = new Date(Date.UTC(y, m - 1, 1));
      const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
      monthLabel.textContent = first.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
      prevBtn.disabled = viewMonth <= minMonth;
      nextBtn.disabled = viewMonth >= maxMonth;

      daysEl.innerHTML = '';
      for (let i = 0; i < first.getUTCDay(); i++) {
        daysEl.appendChild(document.createElement('span'));
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const date = `${viewMonth}-${String(day).padStart(2, '0')}`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bm-day';
        btn.textContent = String(day);
        btn.dataset.date = date;
        const open = isBookableDate(date);
        btn.disabled = !open;
        if (open) btn.classList.add('is-open');
        if (date === today) btn.classList.add('is-today');
        if (date === selectedDate) btn.classList.add('is-selected');
        btn.setAttribute('aria-label', `${formatDateLabel(date)}${open ? '' : ', unavailable'}`);
        btn.setAttribute('aria-pressed', String(date === selectedDate));
        btn.addEventListener('click', () => selectDate(date));
        daysEl.appendChild(btn);
      }
    }

    function createSlotButton(slot: Slot): HTMLElement {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bm-slot';
      btn.textContent = slot.label;
      btn.disabled = !slot.available;
      if (!slot.available) {
        btn.classList.add('is-taken');
        btn.setAttribute('aria-label', `${slot.label}, booked`);
        btn.title = 'Already booked';
      }
      if (slot.time === selectedTime) {
        btn.classList.add('is-selected');
        btn.textContent = `✓ ${slot.label}`;
      }
      btn.setAttribute('aria-pressed', String(slot.time === selectedTime));

      btn.addEventListener('click', () => {
        selectedTime = slot.time;
        continueBtn.disabled = false;
        continueBtn.textContent = `Continue with ${slot.label} →`;

        modal.querySelectorAll('.bm-slot').forEach((b) => {
          const isTarget = b === btn;
          b.classList.toggle('is-selected', isTarget);
          b.setAttribute('aria-pressed', String(isTarget));
          const labelText = b.textContent?.replace(/^✓\s*/, '') || '';
          b.textContent = isTarget ? `✓ ${labelText}` : labelText;
        });
      });
      return btn;
    }

    function renderSlots(slots: Slot[]) {
      morningGrid.innerHTML = '';
      afternoonGrid.innerHTML = '';

      const available = slots.filter((s) => s.available);
      if (!slots.length || !available.length) {
        morningGrid.innerHTML = '<p class="bm-hint">No open morning slots on this day.</p>';
        afternoonGrid.innerHTML = '<p class="bm-hint">No open afternoon slots on this day. Try selecting another date on the calendar.</p>';
        return;
      }

      const morningSlots = slots.filter((s) => {
        const [h] = s.time.split(':').map(Number);
        return h < 12;
      });

      const afternoonSlots = slots.filter((s) => {
        const [h] = s.time.split(':').map(Number);
        return h >= 12;
      });

      if (morningSlots.length > 0) {
        morningSlots.forEach((s) => morningGrid.appendChild(createSlotButton(s)));
      } else {
        morningGrid.innerHTML = '<p class="bm-hint">No morning slots available today.</p>';
      }

      if (afternoonSlots.length > 0) {
        afternoonSlots.forEach((s) => afternoonGrid.appendChild(createSlotButton(s)));
      } else {
        afternoonGrid.innerHTML = '<p class="bm-hint">No afternoon slots available today.</p>';
      }
    }

    async function loadSlots(date: string) {
      const req = ++slotRequest;
      morningGrid.innerHTML = '<p class="bm-hint">Checking availability...</p>';
      afternoonGrid.innerHTML = '';
      showError(error1, null);
      try {
        const res = await fetch(`/api/slots?date=${date}`, { headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (req !== slotRequest) return; // a newer date was clicked
        if (!res.ok || !data.ok) throw new Error(data.error || 'Could not load times.');
        renderSlots(data.slots as Slot[]);
      } catch (err) {
        if (req !== slotRequest) return;
        morningGrid.innerHTML = '';
        afternoonGrid.innerHTML = '';
        showError(error1, 'Could not load available times. Please check your internet connection.');
        console.error(err);
      }
    }

    function selectDate(date: string) {
      selectedDate = date;
      selectedTime = null;
      continueBtn.disabled = true;
      continueBtn.textContent = 'Select a time above';
      slotsTitle.textContent = formatDateLabel(date);
      renderCalendar();
      loadSlots(date);
    }

    prevBtn.addEventListener('click', () => {
      viewMonth = shiftMonth(viewMonth, -1);
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      viewMonth = shiftMonth(viewMonth, 1);
      renderCalendar();
    });

    continueBtn.addEventListener('click', () => {
      if (!selectedDate || !selectedTime) return;
      pickedEl.textContent = `${formatDateLabel(selectedDate)} at ${formatSlotLabel(selectedTime)} (PHT)`;
      showError(error2, null);
      goToStep(2);
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });

    backBtn.addEventListener('click', () => goToStep(1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!selectedDate || !selectedTime) return goToStep(1);
      if (!form.reportValidity()) return;

      const fd = new FormData(form);
      const payload = {
        date: selectedDate,
        time: selectedTime,
        name: fd.get('name'),
        business: fd.get('business'),
        email: fd.get('email'),
        phone: fd.get('phone'),
        goal: fd.get('goal'),
        meeting_type: fd.get('meeting_type'),
        notes: fd.get('notes'),
        website: fd.get('website'),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Securing your slot...';
      showError(error2, null);

      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (res.status === 409) {
          // Slot was just taken or expired.
          selectedTime = null;
          continueBtn.disabled = true;
          continueBtn.textContent = 'Select a time above';
          goToStep(1);
          if (Array.isArray(data.slots)) renderSlots(data.slots);
          showError(error1, data.error || 'That slot was just booked by someone else. Please choose another time.');
          return;
        }
        if (!res.ok || !data.ok) {
          showError(error2, data.error || 'Could not complete the booking. Please try again.');
          return;
        }

        const b = data.booking;
        doneDatetime.textContent = `${b.dateLabel} at ${b.timeLabel}`;
        doneMeeting.textContent = b.meetingLabel;
        if (payload.email) {
          doneEmailNote.textContent = `Notification sent to Ben (reubenmagallanes91@gmail.com) and ${payload.email}`;
        }
        gcalLink.href = b.googleCalendarUrl;
        icsLink.href = b.icsUrl;
        icsLink.setAttribute('download', 'beneru-automation-audit.ics');
        goToStep(3);
        form.reset();
      } catch (err) {
        console.error(err);
        showError(error2, 'Network error. Your booking was not sent. Please try again.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirm booking \u2192';
      }
    });

    const resetFlow = () => {
      selectedTime = null;
      continueBtn.disabled = true;
      continueBtn.textContent = 'Select a time above';
      showError(error1, null);
      showError(error2, null);
      goToStep(1);
      // Auto-select the first available open date
      const initialDate = findFirstOpenDate();
      viewMonth = initialDate.slice(0, 7);
      selectDate(initialDate);
    };

    const open = () => {
      // If previous booking was completed or nothing selected yet, start fresh with auto-picked date
      if (!modal.querySelector<HTMLElement>('[data-bm-step="3"]')!.hidden || !selectedDate) {
        resetFlow();
      }
      modal.showModal();
    };

    document.querySelectorAll<HTMLElement>('[data-open-booking]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      }),
    );
    modal.querySelectorAll('[data-bm-close]').forEach((el) => el.addEventListener('click', () => modal.close()));
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Auto-select the first bookable date initially
    const initialDate = findFirstOpenDate();
    viewMonth = initialDate.slice(0, 7);
    selectDate(initialDate);

    if (location.hash === '#book') open();
  }
</script>

<style is:global>
  .bm {
    border: none;
    padding: 0;
    background: transparent;
    width: min(780px, 95vw);
    max-width: none;
    max-height: 92vh;
    overflow: visible;
  }
  .bm::backdrop {
    background: rgba(16, 10, 32, 0.44);
    -webkit-backdrop-filter: saturate(150%) blur(12px);
    backdrop-filter: saturate(150%) blur(12px);
  }
  .bm-card {
    position: relative;
    background: rgba(252, 250, 255, 0.86);
    -webkit-backdrop-filter: saturate(185%) blur(24px);
    backdrop-filter: saturate(185%) blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 26px;
    padding: 2.2rem 2.4rem;
    max-height: 92vh;
    overflow-y: auto;
    text-align: left;
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.96),
      0 28px 72px rgba(28, 10, 68, 0.28),
      0 0 0 1px rgba(103, 0, 255, 0.12);
    color: var(--ink);
  }
  .bm-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    border: none;
    background: transparent;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--ink-2);
    cursor: pointer;
    padding: 0.25rem 0.6rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }
  .bm-close:hover { background: rgba(0, 0, 0, 0.06); color: var(--ink); }

  .bm-badge {
    display: inline-block;
    font-size: 0.75rem;
