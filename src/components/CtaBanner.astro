---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { CTA_COPY, SITE_IDENTITY } from '../data/site';

const instagram = SOCIAL_LINKS.find((s) => s.id === 'instagram');
---

<section class="cx theme-dark" id={CTA_COPY.id} aria-labelledby="cx-title" data-cx>
  <div class="cx-clouds" aria-hidden="true">
    <div class="cx-cloud cx-cloud--left" data-cx-cloud="-1">
      <img src="/images/clouds/cta-cloud-left-v2.webp" alt="" width="1376" height="768" loading="lazy" decoding="async" />
    </div>
    <div class="cx-cloud cx-cloud--right" data-cx-cloud="1">
      <img src="/images/clouds/cta-cloud-right-v2.webp" alt="" width="1376" height="768" loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="cx-scrim" aria-hidden="true"></div>

  <div class="site-wrap cx-inner" data-reveal>
    <h2 class="cx-title" id="cx-title">{CTA_COPY.accessibleTitle}</h2>
    <p class="cx-sub">{CTA_COPY.barPrompt}. Tell me where content, DMs, or follow-ups are slowing you down, and we will map out the fix together.</p>

    <div class="cta-row cx-actions">
      <a href={spawntelFunnelUrl('cta-bar')} class="cta-btn" data-spawntel-cta="cta-bar">
        <span>{CTA_COPY.primaryCtaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
      {instagram && (
        <a href={instagram.url} class="cta-btn-dark" target="_blank" rel="noopener noreferrer">
          <span>{CTA_COPY.secondaryCtaLabel} ({CTA_COPY.secondaryCtaHandle})</span>
        </a>
      )}
    </div>

    <a class="cx-mail" href={SITE_IDENTITY.mailto}>Or email {SITE_IDENTITY.email}</a>
  </div>
</section>

<script>
  /*
   * Clouds enter from the sides and close behind the headline.
   * Delayed start waits until the CTA section is genuinely on screen, then scroll
   * sets a target and the clouds glide toward it with heavy frame-rate-independent
   * exponential damping (tau 700ms) and quintic easing so the close feels slow,
   * delayed, and cinematic. Only transform + opacity change (GPU composited),
   * positions are measured on load/resize, and the loop sleeps when settled.
   */
  const cx = document.querySelector<HTMLElement>('[data-cx]');
  if (cx) {
    const clouds = Array.from(cx.querySelectorAll<HTMLElement>('[data-cx-cloud]'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TAU = 700; // ms: slow atmospheric lag behind scroll
    let start = 0;
    let span = 1;
    let target = 0;
    let current = 0;
    let raf = 0;
    let last = 0;

    const measure = () => {
      const vh = window.innerHeight || 800;
      const rect = cx.getBoundingClientRect();
      const cxTop = rect.top + window.scrollY;
      const cxH = rect.height || vh * 0.78;
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - vh);
      const delayPx = Math.min(cxH * 0.28, vh * 0.22);
      const desiredSpan = Math.max(vh * 0.92, cxH * 1.1);
      start = cxTop - vh + delayPx;
      if (maxScroll - start < 140) {
        start = Math.max(0, maxScroll - Math.min(vh * 0.7, maxScroll));
      }
      span = Math.max(120, Math.min(desiredSpan, maxScroll - start - 16));
    };
    const targetNow = () => Math.min(1, Math.max(0, (window.scrollY - start) / span));

    const apply = (v: number) => {
      const p = v * v * v * (v * (v * 6 - 15) + 10);
      const scale = (1.1 - 0.1 * p).toFixed(4);
      const op = (0.28 + 0.72 * p).toFixed(3);
      for (const el of clouds) {
        const dir = Number(el.dataset.cxCloud || 0);
        el.style.transform = `translate3d(${((1 - p) * 58 * dir).toFixed(2)}%, 0, 0) scale(${scale})`;
        el.style.opacity = op;
      }
    };

    const step = (now: number) => {
      const dt = last ? Math.min(64, now - last) : 16.7;
      last = now;
      current += (target - current) * (1 - Math.exp(-dt / TAU));
      if (Math.abs(target - current) < 0.00025) {
        current = target;
        apply(current);
        raf = 0;
        last = 0;
        return;
      }
      apply(current);
      raf = requestAnimationFrame(step);
    };

    const kick = () => {
      target = targetNow();
      if (!raf) {
        last = 0;
        raf = requestAnimationFrame(step);
      }
    };

    measure();
    target = current = still ? 1 : targetNow();
    apply(current);

    if (!still) {
      window.addEventListener('scroll', kick, { passive: true });
      const remeasure = () => { measure(); kick(); };
      window.addEventListener('resize', remeasure, { passive: true });
      window.addEventListener('load', remeasure, { once: true });
      if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(document.body);
    }
  }
</script>

<style>
  .cx {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(560px, 78vh, 760px);
    display: grid;
    place-items: center;
  }

  /* Brand-violet sky the clouds part over */
  .cx {
    background:
      radial-gradient(55% 60% at 50% 45%, #8F4DFF 0%, rgba(143, 77, 255, 0) 70%),
      linear-gradient(180deg, #A068FF 0%, #6700FF 48%, #15111E 100%);
  }

  .cx-clouds {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    contain: strict;
  }

  .cx-cloud {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  .cx-cloud img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  /* Feather masks baked directly into cta-cloud-{left,right}-v2.webp for zero runtime mask shader cost */

  .cx-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(var(--cx-top-rgb, 13, 8, 20), 1.000) 0.0%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.966) 2.9%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.874) 5.8%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.741) 8.7%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.583) 11.6%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.417) 14.4%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.259) 17.3%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.126) 20.2%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.034) 23.1%, rgba(var(--cx-top-rgb, 13, 8, 20), 0.000) 26.0%),
      linear-gradient(180deg, rgba(7, 4, 11, 0.000) 78.0%, rgba(7, 4, 11, 0.034) 80.4%, rgba(7, 4, 11, 0.126) 82.9%, rgba(7, 4, 11, 0.259) 85.3%, rgba(7, 4, 11, 0.417) 87.8%, rgba(7, 4, 11, 0.583) 90.2%, rgba(7, 4, 11, 0.741) 92.7%, rgba(7, 4, 11, 0.874) 95.1%, rgba(7, 4, 11, 0.966) 97.6%, rgba(7, 4, 11, 1.000) 100.0%),
      radial-gradient(60% 55% at 50% 46%, rgba(13, 8, 20, 0.5), transparent 75%);
  }

  .cx-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(140px, 15vw, 220px);
  }

  .cx-title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-shadow: 0 6px 40px rgba(13, 8, 20, 0.45);
  }

  .cx-sub {
    margin: 20px 0 0;
    max-width: 48ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }

  .cx-actions {
    margin-top: 32px;
    justify-content: center;
  }

  .cx-mail {
    margin-top: 20px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 4px;
  }

  .cx-mail:hover {
    color: #FFFFFF;
  }
</style>
