---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { CTA_COPY, SITE_IDENTITY } from '../data/site';

const instagram = SOCIAL_LINKS.find((s) => s.id === 'instagram');
---

<section class="section-block cta-section" id={CTA_COPY.id} aria-labelledby="cx-title">
  <div class="site-wrap">
    <div class="cta-card" data-reveal>
      <div class="cta-copy">
        <span class="pill-tag">{CTA_COPY.pill}</span>
        <h2 class="cta-title" id="cx-title">
          Ready to systemize your marketing <span class="accent-word">for good?</span>
        </h2>
        <p class="cta-sub">
          {CTA_COPY.barPrompt}. We look at where manual work is slowing you down and map the exact workflow worth building first.
        </p>
      </div>

      <div class="cta-actions-col">
        <a
          class="cta-btn cta-main-btn"
          href={spawntelFunnelUrl('cta-bar')}
          data-spawntel-cta="cta-bar"
        >
          <span>{CTA_COPY.primaryCtaLabel} on Spawntel</span>
          <span class="cta-btn__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </span>
        </a>

        <div class="cta-alt-links">
          {instagram && (
            <a
              class="cta-link"
              href={instagram.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img class="cta-av" src="/PFP.webp" alt="" width="22" height="22" loading="lazy" />
              <span>{CTA_COPY.secondaryCtaLabel} ({CTA_COPY.secondaryCtaHandle})</span>
            </a>
          )}
          <a class="cta-link" href={SITE_IDENTITY.mailto}>
            <span>{SITE_IDENTITY.email}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: clamp(32px, 4vw, 56px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(28px, 4.2vw, 52px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-violet);
    background:
      radial-gradient(60% 90% at 85% 20%, rgba(103, 0, 255, 0.24), transparent 70%),
      var(--surface-1);
    box-shadow:
      inset 0 1px 0 rgba(215, 200, 255, 0.16),
      var(--shadow-card);
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .cta-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.95rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
    max-width: 17ch;
  }

  .cta-sub {
    margin: 0;
    max-width: 48ch;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .cta-actions-col {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }

  .cta-main-btn {
    height: 52px;
    font-size: 15.5px;
    justify-content: space-between;
    padding-inline: 24px;
  }

  .cta-alt-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(13, 8, 20, 0.55);
    border: 1px solid var(--border);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-body);
    overflow-wrap: anywhere;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .cta-link:hover {
    border-color: var(--border-violet);
    background: rgba(103, 0, 255, 0.14);
    color: #FFFFFF;
  }

  .cta-av {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .cta-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .cta-card {
      padding: 22px;
      border-radius: 22px;
    }
  }
</style>
