---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { CTA_COPY, SITE_IDENTITY } from '../data/site';
import SkyScene from './SkyScene.astro';

const instagram = SOCIAL_LINKS.find((s) => s.id === 'instagram');
---

<section class="cx theme-dark" id={CTA_COPY.id} aria-labelledby="cx-title">
  <SkyScene id="cta-sky" variant="dusk" trees={false} />
  <div class="cx-scrim" aria-hidden="true"></div>

  <div class="site-wrap cx-inner" data-reveal>
    <h2 class="cx-title" id="cx-title">{CTA_COPY.accessibleTitle}</h2>
    <p class="cx-sub">{CTA_COPY.barPrompt}. Tell me where content, DMs or lead follow-up keep breaking, and we map the fix together.</p>

    <div class="cta-row cx-actions">
      <a href={spawntelFunnelUrl('cta-bar')} class="cta-btn" data-spawntel-cta="cta-bar">
        <span>{CTA_COPY.primaryCtaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
      {instagram && (
        <a href={instagram.url} class="cta-btn-dark" target="_blank" rel="noopener noreferrer">
          <span>{CTA_COPY.secondaryCtaLabel} ({CTA_COPY.secondaryCtaHandle})</span>
        </a>
      )}
    </div>

    <a class="cx-mail" href={SITE_IDENTITY.mailto}>Or email {SITE_IDENTITY.email}</a>
  </div>
</section>

<style>
  .cx {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(560px, 78vh, 760px);
    display: grid;
    place-items: center;
    background: #1D1450;
  }

  .cx :global(.sky-scene) {
    z-index: -2;
  }

  .cx-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, #F6F3EE 0%, rgba(246, 243, 238, 0) 12%),
      radial-gradient(60% 55% at 50% 46%, rgba(18, 8, 52, 0.5), transparent 75%);
  }

  .cx-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(96px, 12vw, 160px);
  }

  .cx-title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-shadow: 0 6px 40px rgba(30, 10, 80, 0.45);
  }

  .cx-sub {
    margin: 20px 0 0;
    max-width: 48ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }

  .cx-actions {
    margin-top: 32px;
    justify-content: center;
  }

  .cx-mail {
    margin-top: 20px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 4px;
  }

  .cx-mail:hover {
    color: #FFFFFF;
  }
</style>
