---
const services = [
  {
    title: "AI Content Multiplication",
    description: "Turn one founder video, article, or insight into 20+ platform-native posts across Instagram, LinkedIn, X, and Facebook with automated scheduling.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="18" x="3" y="3" rx="1"/><rect width="8" height="10" x="13" y="11" rx="1"/><rect width="8" height="5" x="13" y="3" rx="1"/></svg>`,
    image: "/assets/marketing/content_multiplication.jpg",
    size: "wide"
  },
  {
    title: "Inbound DM Lead Capture",
    description: "Never let a warm prospect wait in chat. Custom AI qualifies buyer intent, captures contact details, and books calls directly to your calendar 24/7.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="m9 10 2 2 4-4"/></svg>`,
    image: "/assets/marketing/lead_capture.jpg",
    size: "tall"
  },
  {
    title: "Automated Ad Direction",
    description: "Rapidly test Meta ad creative hooks, generate direct response angles, and spot creative fatigue before ad spend leaks.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    image: "/assets/marketing/ad_direction.jpg",
    size: ""
  },
  {
    title: "Audience & Market Intel",
    description: "Research agents monitor competitor messaging, industry narratives, and viral formats so you always know what angle to take next.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>`,
    image: "/assets/marketing/market_intel.jpg",
    size: ""
  },
  {
    title: "Funnel & CRM Automation",
    description: "Connect your social accounts, landing pages, email nurture flows, and CRM into one pipeline with zero manual data entry.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    image: "/assets/marketing/funnel_automation.jpg",
    size: ""
  },
  {
    title: "Growth Intelligence",
    description: "Track customer acquisition cost, organic distribution velocity, and real conversion attribution in one executive view.",
    iconSvg: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/></svg>`,
    image: "/assets/marketing/growth_intelligence.jpg",
    size: "banner"
  }
];
---

<section id="solutions" class="solutions section" aria-labelledby="solutions-heading">
  <div class="section-head" data-reveal>
    <h2 id="solutions-heading" class="section-title">The systems behind your marketing.</h2>
    <p class="section-lead">Six workflows, built around how growing brands actually win customers.</p>
  </div>

  <div class="bento">
    {services.map((service, i) => (
      <article class:list={['tile', service.size]} data-reveal style={`--i:${i % 3}`}>
        <div class="tile-media" style={`background-image: url('${service.image}')`}></div>
        <div class="tile-content">
          <span class="tile-icon" set:html={service.iconSvg}></span>
          <div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .section-head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  /* 3-col bento, 6 cells, no gaps:
     row 1: wide(2) + tall(1, spans 2 rows) / row 2: two singles / row 3: single + banner(2) */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(260px, auto);
    gap: 1rem;
  }

  .tile.wide { grid-column: span 2; }
  .tile.tall { grid-row: span 2; }
  .tile.banner { grid-column: span 2; min-height: 260px; }

  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: rgba(21, 18, 28, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.28), var(--glass-shadow);
    color: #FFFFFF;
    isolation: isolate;
    transition: border-color 0.3s var(--ease-ios), box-shadow 0.35s var(--ease-ios);
  }

  .tile:hover {
    border-color: rgba(179, 140, 255, 0.45);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.4), 0 20px 44px -18px rgba(103, 0, 255, 0.36);
  }

  .tile-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-size: cover;
    background-position: center;
    transition: transform 0.9s var(--ease-ios);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(22, 14, 42, 0.2) 0%, rgba(16, 11, 30, 0.56) 45%, rgba(14, 10, 26, 0.92) 100%);
  }

  .tile.banner::after {
    background: linear-gradient(90deg, rgba(14, 10, 26, 0.93) 0%, rgba(16, 11, 30, 0.74) 45%, rgba(22, 14, 42, 0.22) 100%);
  }

  .tile:hover .tile-media { transform: scale(1.04); }

  .tile-content {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }

  .banner .tile-content { max-width: 52ch; justify-content: center; gap: 1.25rem; }

  .tile-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    display: inline-grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.42), 0 6px 16px rgba(0, 0, 0, 0.2);
    color: #FFFFFF;
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    transition: background-color 0.3s var(--ease-ios), border-color 0.3s var(--ease-ios), transform 0.4s var(--spring-ios);
  }

  .tile:hover .tile-icon {
    background: rgba(103, 0, 255, 0.78);
    border-color: rgba(255, 255, 255, 0.38);
    transform: scale(1.06);
  }

  h3 {
    color: #FFFFFF;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .tile p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  @media (max-width: 960px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile.wide { grid-column: 1 / -1; }
    .tile.tall { grid-row: auto; }
  }

  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: minmax(280px, auto); }
    .tile.wide, .tile.banner { grid-column: auto; }
    .tile.banner::after {
      background: linear-gradient(180deg, rgba(14, 11, 20, 0.2) 0%, rgba(14, 11, 20, 0.94) 100%);
    }
    .banner .tile-content { justify-content: space-between; }
  }
</style>
