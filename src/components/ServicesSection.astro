---
const services = [
  {
    id: "01",
    title: "AI Content Multiplication",
    description: "Turn one founder video, article, or insight into 20+ platform-native posts across Instagram, LinkedIn, X, and Facebook with automated scheduling.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="18" x="3" y="3" rx="1"/><rect width="8" height="10" x="13" y="11" rx="1"/><rect width="8" height="5" x="13" y="3" rx="1"/></svg>`,
    image: "/assets/marketing/content_multiplication.jpg"
  },
  {
    id: "02",
    title: "Inbound DM Lead Capture",
    description: "Never let a warm prospect wait in chat. Custom AI qualifies buyer intent, captures contact details, and books calls directly to your calendar 24/7.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="m9 10 2 2 4-4"/></svg>`,
    image: "/assets/marketing/lead_capture.jpg"
  },
  {
    id: "03",
    title: "Automated Ad Direction",
    description: "Rapidly test Meta ad creative hooks, generate high-converting direct response angles, and spot creative fatigue before ad spend leaks.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    image: "/assets/marketing/ad_direction.jpg"
  },
  {
    id: "04",
    title: "Audience & Market Intel",
    description: "Automated research agents monitor competitor messaging, industry narratives, and viral formats so you always know what angle to take next.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>`,
    image: "/assets/marketing/market_intel.jpg"
  },
  {
    id: "05",
    title: "Funnel & CRM Automation",
    description: "Bridge your social accounts, landing pages, email nurture flows, and CRM into one seamless pipeline with zero manual data entry.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    image: "/assets/marketing/funnel_automation.jpg"
  },
  {
    id: "06",
    title: "Growth Intelligence",
    description: "Track customer acquisition cost, organic distribution velocity, and real conversion attribution in one executive view.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>`,
    image: "/assets/marketing/growth_intelligence.jpg"
  }
];
---

<section id="solutions" class="solutions" aria-labelledby="solutions-heading">
  <div class="section-header">
    <h2 id="solutions-heading" class="title">We direct the systems behind your marketing.</h2>
    <p class="subtitle">Intelligent workflows built around how high-growth brands acquire customers.</p>
  </div>
  
  <div class="bento-grid">
    {services.map(service => (
      <article class={`solution-card ${service.image ? 'has-image' : ''}`} tabindex="0">
        {service.image && (
          <div class="card-image-bg" style={`background-image: url('${service.image}')`}>
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="card-content">
          <div class="card-header">
            <span class="card-id">{service.id}</span>
            <div class="card-icon" set:html={service.iconSvg}></div>
          </div>
          <div class="card-bottom">
            <h3 class="card-title">{service.title}</h3>
            <p class="card-text">{service.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .solutions {
    padding: 8rem 0;
  }
  
  .section-header {
    margin-bottom: 5rem;
  }

  .title {
    font-size: var(--step-3);
    margin-bottom: 1rem;
    max-width: 25ch;
  }

  .subtitle {
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
    grid-auto-rows: minmax(350px, auto);
  }

  .solution-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-lg, 20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    cursor: default;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    outline: none;
  }

  .solution-card:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(103, 0, 255, 0.16), inset 0 2px 6px rgba(255, 255, 255, 1);
  }

  .solution-card:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
    box-shadow: 0 12px 40px rgba(103, 0, 255, 0.22);
  }

  .has-image {
    color: var(--paper);
    border: none;
  }
  
  .has-image:hover {
    background: transparent;
    border-color: transparent;
  }

  .card-image-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solution-card:hover .card-image-bg {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(17,17,17,0.2) 0%, rgba(17,17,17,0.92) 100%);
  }

  .card-content {
    padding: 2.75rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .card-id {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-muted);
    font-family: monospace;
    letter-spacing: 0.05em;
  }
  
  .solution-card:not(.has-image):hover .card-id {
    color: var(--accent);
  }

  .has-image .card-id {
    color: rgba(255,255,255,0.75);
  }

  /* Refined SVG icon container - anti-slop, no raw emojis */
  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md, 12px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.8);
    color: var(--accent);
    box-shadow: 0 4px 12px rgba(103, 0, 255, 0.08);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solution-card:not(.has-image):hover .card-icon {
    background: var(--accent);
    color: #FFFFFF;
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 8px 24px rgba(103, 0, 255, 0.3);
  }

  .has-image .card-icon {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .has-image:hover .card-icon {
    background: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    transform: scale(1.05);
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .card-text {
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .solution-card:not(.has-image):hover .card-text {
    color: var(--ink);
  }

  .has-image .card-title, .has-image .card-text {
    color: var(--paper);
  }
  
  .has-image .card-text {
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-card,
    .card-icon,
    .card-image-bg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>