---
const services = [
  {
    id: "01",
    title: "AI Customer Service",
    description: "Automate Messenger, Instagram DMs, FAQs, and opening hours. Never leave a customer waiting.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h5"/></svg>`,
    image: "/assets/customer_service.jpg"
  },
  {
    id: "02",
    title: "Smart Reservations",
    description: "AI understands requests, checks availability, reserves tables, and sends confirmations automatically.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>`,
    image: "/assets/kitchen.jpg"
  },
  {
    id: "03",
    title: "AI Marketing",
    description: "Analyze sales, identify slow hours, and generate targeted campaigns with one click.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    image: "/assets/ai_marketing.jpg"
  },
  {
    id: "04",
    title: "Inventory Intelligence",
    description: "Know what you're running out of before you run out of it. Get low stock alerts instantly.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    image: "/assets/inventory.jpg"
  },
  {
    id: "05",
    title: "Review Automation",
    description: "Turn every customer interaction into useful feedback. Automatic thank yous and manager alerts.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    image: "/assets/review_automation.jpg"
  },
  {
    id: "06",
    title: "Business Intelligence",
    description: "Your business shouldn't just collect data. It should know what to do with it.",
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>`,
    image: "/assets/pos.jpg"
  }
];
---

<section id="solutions" class="solutions" aria-labelledby="solutions-heading">
  <div class="section-header">
    <h2 id="solutions-heading" class="title">We automate the work behind the food.</h2>
    <p class="subtitle">AI systems built around the way your business actually operates.</p>
  </div>
  
  <div class="bento-grid">
    {services.map(service => (
      <article class={`solution-card ${service.image ? 'has-image' : ''}`} tabindex="0">
        {service.image && (
          <div class="card-image-bg" style={`background-image: url('${service.image}')`}>
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="card-content">
          <div class="card-header">
            <span class="card-id">{service.id}</span>
            <div class="card-icon" set:html={service.iconSvg}></div>
          </div>
          <div class="card-bottom">
            <h3 class="card-title">{service.title}</h3>
            <p class="card-text">{service.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .solutions {
    padding: 8rem 0;
  }
  
  .section-header {
    margin-bottom: 5rem;
  }

  .title {
    font-size: var(--step-3);
    margin-bottom: 1rem;
    max-width: 25ch;
  }

  .subtitle {
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
    grid-auto-rows: minmax(350px, auto);
  }

  .solution-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-lg, 20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    cursor: default;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    outline: none;
  }

  .solution-card:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(103, 0, 255, 0.16), inset 0 2px 6px rgba(255, 255, 255, 1);
  }

  .solution-card:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
    box-shadow: 0 12px 40px rgba(103, 0, 255, 0.22);
  }

  .has-image {
    color: var(--paper);
    border: none;
  }
  
  .has-image:hover {
    background: transparent;
    border-color: transparent;
  }

  .card-image-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solution-card:hover .card-image-bg {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(17,17,17,0.2) 0%, rgba(17,17,17,0.92) 100%);
  }

  .card-content {
    padding: 2.75rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .card-id {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-muted);
    font-family: monospace;
    letter-spacing: 0.05em;
  }
  
  .solution-card:not(.has-image):hover .card-id {
    color: var(--accent);
  }

  .has-image .card-id {
    color: rgba(255,255,255,0.75);
  }

  /* Refined SVG icon container - anti-slop, no raw emojis */
  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md, 12px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.8);
    color: var(--accent);
    box-shadow: 0 4px 12px rgba(103, 0, 255, 0.08);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solution-card:not(.has-image):hover .card-icon {
    background: var(--accent);
    color: #FFFFFF;
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 8px 24px rgba(103, 0, 255, 0.3);
  }

  .has-image .card-icon {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .has-image:hover .card-icon {
    background: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    transform: scale(1.05);
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .card-text {
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .solution-card:not(.has-image):hover .card-text {
    color: var(--ink);
  }

  .has-image .card-title, .has-image .card-text {
    color: var(--paper);
  }
  
  .has-image .card-text {
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-card,
    .card-icon,
    .card-image-bg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>