---
import { SITE_IDENTITY } from '../data/site';
---

<section class="hero theme-dark" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-scene" aria-hidden="true">
    <div class="hero-sky"></div>
    <div class="hero-layer layer-bank" data-depth="0.30">
      <img src="/images/clouds/layer-bank.webp" alt="" width="1376" height="768" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-peak" data-depth="0.18">
      <img src="/images/clouds/layer-peak.webp" alt="" width="1376" height="768" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-hills" data-depth="0">
      <img src="/images/clouds/layer-hills.webp" alt="" width="1376" height="768" decoding="async" />
    </div>
    <div class="hero-tint"></div>
    <div class="hero-layer layer-mist" data-depth="-0.12">
      <img src="/images/clouds/layer-mist.webp" alt="" width="1376" height="768" decoding="async" />
    </div>
    <div class="hero-layer layer-forest layer-forest-left" data-depth="-0.26" data-spread="-0.14">
      <img src="/images/clouds/layer-forest-left.webp" alt="" width="646" height="653" decoding="async" />
    </div>
    <div class="hero-layer layer-forest layer-forest-right" data-depth="-0.22" data-spread="0.14">
      <img src="/images/clouds/layer-forest-right.webp" alt="" width="850" height="653" decoding="async" />
    </div>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="site-wrap hero-inner">
    <div class="hero-top" data-hero-top>
      <p class="hero-welcome">Welcome to</p>
      <h1 class="hero-mark" id="hero-title">
        <span class="sr-only">Beneru, AI Direction and Marketing Systems by {SITE_IDENTITY.personName}</span>
        <svg viewBox="0 0 820 168" aria-hidden="true" focusable="false">
          <text x="0" y="158" textLength="816" lengthAdjust="spacingAndGlyphs">BENERU</text>
        </svg>
      </h1>
    </div>
    <p class="hero-tag">{SITE_IDENTITY.niche}, built so business owners stop doing marketing by hand.</p>

  </div>
</section>

<script>
  /*
   * Depth on scroll, same mechanics as the reference: every layer slides at its own
   * rate. Positive depth = lags behind the page (far), negative = outruns it (near).
   * Transforms go on the wrappers; the inner images keep their own CSS drift loop.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('.hero-layer[data-depth]'));
    const top = hero.querySelector<HTMLElement>('[data-hero-top]');
    const tag = hero.querySelector<HTMLElement>('.hero-tag');
    let raf = 0;
    const paint = () => {
      raf = 0;
      const y = Math.min(window.scrollY, hero.offsetHeight);
      layers.forEach((el) => {
        const d = Number(el.dataset.depth || 0);
        const sx = Number(el.dataset.spread || 0);
        el.style.transform = `translate3d(${(y * sx).toFixed(1)}px, ${(y * d).toFixed(1)}px, 0)`;
      });
      if (top) {
        top.style.transform = `translate3d(0, ${(y * 0.4).toFixed(1)}px, 0)`;
        top.style.opacity = String(Math.max(0, 1 - y / (hero.offsetHeight * 0.75)));
      }
      if (tag) {
        tag.style.opacity = String(Math.max(0, 1 - y / (hero.offsetHeight * 0.4)));
      }
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    window.addEventListener('resize', paint, { passive: true });
    paint();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: max(100svh, 780px);
    display: flex;
    background: #0D0814;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    --lw: max(100%, 1180px);
  }

  .hero-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 34% at 50% 50%, rgba(240, 237, 247, 0.62), rgba(215, 200, 255, 0.18) 55%, transparent 75%),
      linear-gradient(180deg, #6700FF 0%, #7E26FF 26%, #A068FF 52%, #C2AAFF 74%, #D7C8FF 100%);
  }

  .hero-layer {
    position: absolute;
    left: 50%;
    width: var(--lw);
    margin-left: calc(var(--lw) / -2);
    will-change: transform;
  }

  .hero-layer img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Back to front: bank (blended), peak, hills, near mist (blended) */
  .layer-bank {
    z-index: 2;
    bottom: 4%;
    mix-blend-mode: screen;
    opacity: 0.95;
  }

  .layer-bank img,
  .layer-mist img {
    width: 108%;
    max-width: none;
    margin-left: -4%;
  }

  .layer-bank img {
    animation: hero-drift-a 38s ease-in-out infinite alternate;
  }

  .layer-peak {
    z-index: 3;
    bottom: 6%;
  }

  .layer-hills {
    z-index: 4;
    bottom: -2%;
  }

  .layer-mist {
    z-index: 5;
    isolation: auto;
    bottom: -16%;
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  .layer-mist img {
    animation: hero-drift-b 26s ease-in-out infinite alternate;
  }

  /* Closest layer: forest slopes framing both edges, open in the middle */
  .layer-forest {
    z-index: 6;
    bottom: -3%;
    margin-left: 0;
  }

  /* Base fades out so the rising slopes never show a hard bottom edge */
  .layer-forest img {
    -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
  }

  .layer-forest-left {
    left: 0;
    width: clamp(260px, 32vw, 560px);
  }

  .layer-forest-right {
    left: auto;
    right: 0;
    width: clamp(320px, 40vw, 720px);
  }

  /* Re-hues the grey haze (lavender mist over near-black hills) back to brand violet */
  .hero-tint {
    position: absolute;
    inset: 0;
    z-index: 5;
    mix-blend-mode: color;
    background: linear-gradient(180deg, transparent 35%, rgba(103, 0, 255, 0.55) 70%, rgba(143, 77, 255, 0.5) 100%);
  }

  @keyframes hero-drift-a {
    from { transform: translate3d(-2.5%, 0, 0); }
    to { transform: translate3d(2.5%, 0, 0); }
  }

  @keyframes hero-drift-b {
    from { transform: translate3d(3%, 0, 0); }
    to { transform: translate3d(-3%, 0, 0); }
  }

  /* Darkens the lower band so white copy stays readable over the ridges, then melts into cream */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
      linear-gradient(180deg, transparent 80%, rgba(240, 237, 247, 0.6) 94%, #F0EDF7 100%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    padding-top: calc(var(--nav-h) + clamp(28px, 6vh, 72px));
    padding-bottom: clamp(88px, 12vh, 140px);
  }

  .hero-top {
    position: relative;
    z-index: 1;
    will-change: transform, opacity;
  }

  .hero-tag {
    position: relative;
    z-index: 8;
  }

  .hero-welcome {
    margin: 0 0 0.4vw 0.6%;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 0.8rem + 1.4vw, 2rem);
    font-weight: 600;
    color: #FFFFFF;
    text-shadow: 0 2px 18px rgba(13, 8, 20, 0.35);
  }

  .hero-mark {
    margin: 0;
    line-height: 0;
  }

  .hero-mark svg {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 18px 40px rgba(13, 8, 20, 0.28));
  }

  .hero-mark text {
    font-family: 'Poppins', var(--font-heading);
    font-size: 200px;
    font-weight: 800;
    letter-spacing: -6px;
    fill: #FFFFFF;
  }

  .hero-tag {
    margin: clamp(14px, 1.6vw, 24px) 0 0 auto;
    max-width: 30ch;
    text-align: right;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 0.85rem + 1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    text-shadow: 0 2px 20px rgba(13, 8, 20, 0.45);
  }

  @media (max-width: 760px) {
    .hero {
      min-height: max(100svh, 720px);
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
        linear-gradient(180deg, transparent 80%, rgba(240, 237, 247, 0.6) 94%, #F0EDF7 100%);
    }

    .layer-forest-left {
      width: 80vw;
      left: -22vw;
      bottom: 7%;
    }

    .layer-forest-right {
      width: 92vw;
      right: -30vw;
      bottom: 5%;
    }

    .hero-tag {
      margin-left: 0;
      text-align: left;
      font-size: 1.15rem;
      text-shadow: 0 1px 2px rgba(13, 8, 20, 0.55), 0 4px 24px rgba(13, 8, 20, 0.6);
    }

  }
</style>
