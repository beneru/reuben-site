---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { FOOTER_COPY, HERO_COPY, SITE_IDENTITY } from '../data/site';

const buildIcons = [
  // Meta DM Qualifier: chat bubble with check
  '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="m9 12 2 2 4-4"/>',
  // Brand DNA Pipeline: sparkle
  '<path d="M12 3c.6 4.4 2.6 6.4 7 7-4.4.6-6.4 2.6-7 7-.6-4.4-2.6-6.4-7-7 4.4-.6 6.4-2.6 7-7Z"/><path d="M19 3v4M17 5h4"/>',
  // Marketing Brain: stacked layers
  '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
];
---

<section class="hero theme-dark" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-scene" aria-hidden="true">
    <div class="hero-sky"></div>
    <div class="hero-layer layer-bank" data-depth="0.30">
      <img src="/images/clouds/layer-bank.webp" alt="" width="1376" height="768" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-peak" data-depth="0.18">
      <img src="/images/clouds/layer-peak.webp" alt="" width="1376" height="768" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-hills" data-depth="0">
      <img src="/images/clouds/layer-hills.webp" alt="" width="1376" height="768" decoding="async" />
    </div>
    <div class="hero-layer layer-mist" data-depth="-0.12">
      <img src="/images/clouds/layer-mist.webp" alt="" width="1376" height="768" decoding="async" />
    </div>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="site-wrap hero-inner">
    <div class="hero-top" data-hero-top>
      <p class="hero-welcome">Welcome to</p>
      <h1 class="hero-mark" id="hero-title">
        <span class="sr-only">Beneru, AI Direction and Marketing Systems by {SITE_IDENTITY.personName}</span>
        <svg viewBox="0 0 820 168" aria-hidden="true" focusable="false">
          <text x="0" y="158" textLength="816" lengthAdjust="spacingAndGlyphs">BENERU</text>
        </svg>
      </h1>
    </div>
    <p class="hero-tag">{SITE_IDENTITY.niche}, built so business owners stop doing marketing by hand.</p>

    <ul class="hero-builds" aria-label="Documented builds">
      {FOOTER_COPY.buildLinks.map((link, i) => (
        <li>
          <a href={link.href}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={buildIcons[i]} />
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="hero-bottom">
      <div class="hero-copy">
        <p class="hero-statement">{HERO_COPY.headline}.</p>
        <p class="hero-sub">{HERO_COPY.subtitle}</p>
        <div class="cta-row hero-actions">
          <a href={spawntelFunnelUrl('hero')} class="cta-btn" data-spawntel-cta="hero">
            <span>{HERO_COPY.primaryCtaLabel}</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
          <a href={HERO_COPY.secondaryCtaHref} class="cta-btn-dark">
            <span>{HERO_COPY.secondaryCtaLabel}</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      <div class="hero-person">
        <img src="/images/founder/reuben-studio.webp" alt={HERO_COPY.portraitAlt} width="56" height="56" decoding="async" />
        <div>
          <strong>{SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName})</strong>
          <span>{SITE_IDENTITY.role}, {SITE_IDENTITY.companyName}</span>
          <ul class="hero-socials" aria-label="Beneru social profiles">
            {SOCIAL_LINKS.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (${s.handle})`} title={`${s.label} (${s.handle})`}>
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" set:html={s.iconSvg} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /*
   * Depth on scroll, same mechanics as the reference: every layer slides at its own
   * rate. Positive depth = lags behind the page (far), negative = outruns it (near).
   * Transforms go on the wrappers; the inner images keep their own CSS drift loop.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('.hero-layer[data-depth]'));
    const top = hero.querySelector<HTMLElement>('[data-hero-top]');
    const tag = hero.querySelector<HTMLElement>('.hero-tag');
    let raf = 0;
    const paint = () => {
      raf = 0;
      const y = Math.min(window.scrollY, hero.offsetHeight);
      layers.forEach((el) => {
        const d = Number(el.dataset.depth || 0);
        el.style.transform = `translate3d(0, ${(y * d).toFixed(1)}px, 0)`;
      });
      if (top) {
        top.style.transform = `translate3d(0, ${(y * 0.4).toFixed(1)}px, 0)`;
        top.style.opacity = String(Math.max(0, 1 - y / (hero.offsetHeight * 0.75)));
      }
      if (tag) {
        tag.style.opacity = String(Math.max(0, 1 - y / (hero.offsetHeight * 0.4)));
      }
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    window.addEventListener('resize', paint, { passive: true });
    paint();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: max(100svh, 780px);
    display: flex;
    background: #0D0814;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    --lw: max(100%, 1180px);
  }

  .hero-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 34% at 50% 50%, rgba(240, 237, 247, 0.62), rgba(215, 200, 255, 0.18) 55%, transparent 75%),
      linear-gradient(180deg, #6700FF 0%, #7E26FF 26%, #A068FF 52%, #C2AAFF 74%, #D7C8FF 100%);
  }

  .hero-layer {
    position: absolute;
    left: 50%;
    width: var(--lw);
    margin-left: calc(var(--lw) / -2);
    will-change: transform;
  }

  .hero-layer img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Back to front: bank (blended), peak, hills, near mist (blended) */
  .layer-bank {
    z-index: 2;
    bottom: 4%;
    mix-blend-mode: screen;
    opacity: 0.95;
  }

  .layer-bank img,
  .layer-mist img {
    width: 108%;
    max-width: none;
    margin-left: -4%;
  }

  .layer-bank img {
    animation: hero-drift-a 38s ease-in-out infinite alternate;
  }

  .layer-peak {
    z-index: 3;
    bottom: 6%;
  }

  .layer-hills {
    z-index: 4;
    bottom: -2%;
  }

  .layer-mist {
    z-index: 5;
    bottom: -16%;
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  .layer-mist img {
    animation: hero-drift-b 26s ease-in-out infinite alternate;
  }

  @keyframes hero-drift-a {
    from { transform: translate3d(-2.5%, 0, 0); }
    to { transform: translate3d(2.5%, 0, 0); }
  }

  @keyframes hero-drift-b {
    from { transform: translate3d(3%, 0, 0); }
    to { transform: translate3d(-3%, 0, 0); }
  }

  /* Darkens the lower band so white copy stays readable over the ridges, then melts into cream */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
      linear-gradient(180deg, transparent 62%, rgba(13, 8, 20, 0.35) 84%, rgba(13, 8, 20, 0.2) 93%, #F0EDF7 100%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding-top: calc(var(--nav-h) + clamp(28px, 6vh, 72px));
    padding-bottom: clamp(88px, 12vh, 140px);
  }

  .hero-top {
    position: relative;
    z-index: 1;
    will-change: transform, opacity;
  }

  .hero-tag,
  .hero-builds,
  .hero-bottom {
    position: relative;
    z-index: 7;
  }

  .hero-welcome {
    margin: 0 0 0.4vw 0.6%;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 0.8rem + 1.4vw, 2rem);
    font-weight: 600;
    color: #FFFFFF;
    text-shadow: 0 2px 18px rgba(13, 8, 20, 0.35);
  }

  .hero-mark {
    margin: 0;
    line-height: 0;
  }

  .hero-mark svg {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 18px 40px rgba(13, 8, 20, 0.28));
  }

  .hero-mark text {
    font-family: 'Poppins', var(--font-heading);
    font-size: 200px;
    font-weight: 800;
    letter-spacing: -6px;
    fill: #FFFFFF;
  }

  .hero-tag {
    margin: clamp(14px, 1.6vw, 24px) 0 0 auto;
    max-width: 30ch;
    text-align: right;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 0.85rem + 1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    text-shadow: 0 2px 20px rgba(13, 8, 20, 0.45);
  }

  .hero-builds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px clamp(14px, 3vw, 44px);
  }

  .hero-builds a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    border-radius: 999px;
    color: #FFFFFF;
    font-weight: 600;
    font-size: clamp(14px, 0.8rem + 0.3vw, 16px);
    background: rgba(13, 8, 20, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.26);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background-color 0.18s ease, transform 0.2s var(--ease-out);
  }

  .hero-builds a:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: translateY(-2px);
  }

  .hero-builds svg {
    width: 22px;
    height: 22px;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    flex-wrap: wrap;
  }

  .hero-copy {
    max-width: 640px;
  }

  .hero-statement {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.4rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    text-wrap: balance;
  }

  .hero-sub {
    margin: 16px 0 0;
    max-width: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.12rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-actions {
    margin-top: 26px;
    justify-content: flex-start;
  }

  .hero-person {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px 12px 12px;
    border-radius: 22px;
    background: rgba(13, 8, 20, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .hero-person img {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    object-fit: cover;
    object-position: center 15%;
  }

  .hero-person strong {
    display: block;
    font-size: 15px;
    color: #FFFFFF;
  }

  .hero-person span {
    display: block;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-socials {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }

  .hero-socials a {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.12);
    transition: background-color 0.16s ease;
  }

  .hero-socials a:hover {
    background: var(--primary);
  }

  @media (max-width: 760px) {
    .hero {
      min-height: max(100svh, 720px);
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
        linear-gradient(180deg, transparent 48%, rgba(13, 8, 20, 0.5) 66%, rgba(13, 8, 20, 0.55) 90%, #F0EDF7 100%);
    }

    .hero-tag {
      margin-left: 0;
      text-align: left;
      font-size: 1.15rem;
    }

    .hero-builds {
      justify-content: flex-start;
    }

    .hero-builds a {
      padding: 8px 13px 8px 10px;
      font-size: 13.5px;
    }

    .hero-builds svg {
      width: 18px;
      height: 18px;
    }
  }
</style>
