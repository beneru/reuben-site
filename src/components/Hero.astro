---
import { spawntelFunnelUrl } from '../../shared/funnel';
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow hero-in hero-text-in" style="--d:0">AI Direction &amp; Marketing Systems</p>
    <h1 id="hero-heading" class="headline hero-in hero-text-in" style="--d:1">
      Marketing shouldn't run on <span class="accent">manual hustle.</span>
    </h1>
    <p class="subtitle hero-in hero-text-in" style="--d:2">
      I build AI systems that repurpose content, qualify DMs and test ads, so your team stops doing it by hand.
    </p>
    <div class="hero-actions hero-in" style="--d:3">
      <a href={spawntelFunnelUrl('hero')} class="btn btn-primary" data-spawntel-cta="hero">
        Book on Spawntel <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="#work" class="btn btn-ghost">See the work</a>
    </div>
  </div>

  <figure class="hero-portrait">
    <div class="portrait-tilt" data-hero-tilt>
      <div class="portrait-frame">
        <picture class="portrait-media">
          <source srcset="/PFP-hero.webp" type="image/webp" />
          <img
            src="/PFP.png"
            alt="Reuben (Ben) Magallanes, founder of Beneru"
            width="880"
            height="880"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="portrait-sheen" aria-hidden="true"></div>
      </div>
    </div>
    <figcaption class="portrait-caption">
      <strong>Reuben Magallanes</strong>
      <span>Marketing Head &amp; Co-Founder, Spawntel</span>
    </figcaption>
  </figure>
</section>

<script>
  const tilt = document.querySelector<HTMLElement>('[data-hero-tilt]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (tilt && !reduceMotion && finePointer) {
    const frame = tilt.querySelector<HTMLElement>('.portrait-frame');
    let rafId = 0;
    let hovering = false;
    let rect: DOMRect | null = null;
    let targetRx = 0;
    let targetRy = 0;
    let targetGx = 50;
    let targetGy = 35;
    let curRx = 0;
    let curRy = 0;
    let curGx = 50;
    let curGy = 35;

    const tick = () => {
      const ease = hovering ? 0.14 : 0.1;
      curRx += (targetRx - curRx) * ease;
      curRy += (targetRy - curRy) * ease;
      curGx += (targetGx - curGx) * ease;
      curGy += (targetGy - curGy) * ease;

      if (!hovering && Math.abs(curRx) < 0.01 && Math.abs(curRy) < 0.01) {
        tilt.style.transform = '';
        rafId = 0;
        return;
      }

      tilt.style.transform = `perspective(960px) rotateX(${curRx.toFixed(2)}deg) rotateY(${curRy.toFixed(2)}deg)`;
      if (frame) {
        frame.style.setProperty('--glint-x', `${curGx.toFixed(1)}%`);
        frame.style.setProperty('--glint-y', `${curGy.toFixed(1)}%`);
      }

      rafId = requestAnimationFrame(tick);
    };

    const start = () => {
      if (!rafId) rafId = requestAnimationFrame(tick);
    };

    tilt.addEventListener('pointerenter', () => {
      hovering = true;
      rect = tilt.getBoundingClientRect();
      start();
    });

    tilt.addEventListener('pointermove', (e) => {
      if (!rect) rect = tilt.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      const y = Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height));
      targetRx = (0.5 - y) * 5.2;
      targetRy = (x - 0.5) * 5.6;
      targetGx = x * 100;
      targetGy = y * 100;
      start();
    });

    tilt.addEventListener('pointerleave', () => {
      hovering = false;
      rect = null;
      targetRx = 0;
      targetRy = 0;
      start();
    });

    window.addEventListener('resize', () => { rect = null; }, { passive: true });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: calc(100dvh - 68px);
    padding: clamp(2.5rem, 6vw, 5rem) 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.9rem;
    border-radius: var(--radius-full);
    background: var(--glass-tint);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-tint-border);
    box-shadow: var(--glass-highlight);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--accent-ink);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.4rem;
  }

  .headline {
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 16ch;
    margin: 0 0 1.5rem;
  }

  .headline .accent { color: var(--accent-ink); }

  .subtitle {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 44ch;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Portrait */
  .hero-portrait {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 420px;
  }

  .portrait-tilt {
    width: 100%;
    transform-style: preserve-3d;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 30px;
    overflow: hidden;
    background: var(--accent);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      0 2px 10px -2px rgba(19, 19, 40, 0.12),
      0 34px 68px -26px rgba(103, 0, 255, 0.52);
  }

  /* Crisp iOS glass inner rim highlight */
  .portrait-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 3;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.22),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.42);
  }

  /* One-shot entry light sweep across the portrait card */
  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      110deg,
      transparent 30%,
      rgba(255, 255, 255, 0.2) 48%,
      rgba(255, 255, 255, 0.04) 56%,
      transparent 68%
    );
    transform: translate3d(-115%, 0, 0);
    opacity: 0;
  }

  .portrait-media {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.02);
    transition: transform 0.75s var(--ease-ios);
  }

  .portrait-sheen {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    background: radial-gradient(
      340px circle at var(--glint-x, 50%) var(--glint-y, 35%),
      rgba(255, 255, 255, 0.16),
      transparent 68%
    );
    transition: opacity 0.45s var(--ease-ios);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-portrait:hover .portrait-frame img {
      transform: scale(1.045);
    }
    .hero-portrait:hover .portrait-sheen {
      opacity: 1;
    }
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 0.25rem 0;
    font-size: 0.9rem;
  }

  figcaption strong { font-weight: 600; letter-spacing: -0.01em; }
  figcaption span { color: var(--ink-muted); }

  /* Orchestrated iOS entrance: typography decelerates smoothly; card surfaces with spring depth */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      opacity: 0;
      animation:
        heroButtonsIn 0.8s var(--spring-ios) calc(var(--d) * 65ms + 50ms) both,
        heroFadeIn 0.4s var(--ease-ios) calc(var(--d) * 65ms + 50ms) both;
    }

    .hero-text-in {
      animation:
        heroSlideIn 0.72s var(--ease-ios) calc(var(--d) * 65ms + 40ms) both,
        heroFadeBlurIn 0.54s var(--ease-ios) calc(var(--d) * 65ms + 40ms) both;
    }

    .portrait-frame {
      opacity: 0;
      animation:
        portraitCardIn 0.88s var(--spring-ios) 0.08s both,
        heroFadeIn 0.42s var(--ease-ios) 0.08s both;
    }

    .portrait-media {
      animation: portraitMediaSettle 1.1s var(--ease-ios) 0.08s both;
    }

    .portrait-caption {
      opacity: 0;
      animation:
        heroSlideIn 0.68s var(--ease-ios) 0.34s both,
        heroFadeIn 0.46s var(--ease-ios) 0.34s both;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 861px) {
    .portrait-frame::after {
      animation: sheenSweep 1.05s var(--ease-ios) 0.44s both;
    }
  }

  /* Subtle iOS spatial depth on scroll exit (compositor-driven CSS View Timeline) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 861px) {
      .hero {
        view-timeline-name: --hero-stage;
        view-timeline-axis: block;
      }

      .hero-copy {
        animation: heroCopyExit 1ms linear both;
      }

      .hero-portrait {
        animation: heroPortraitExit 1ms linear both;
      }

      /* Separate rule prevents LightningCSS from merging animation-timeline into invalid animation shorthand */
      .hero > .hero-copy,
      .hero > .hero-portrait {
        animation-timeline: --hero-stage;
        animation-range: exit 0% exit 90%;
      }
    }
  }

  @keyframes heroSlideIn {
    from { transform: translate3d(0, 18px, 0) scale(0.988); }
    to { transform: none; }
  }

  @keyframes heroButtonsIn {
    from { transform: translate3d(0, 18px, 0) scale(0.97); }
    to { transform: none; }
  }

  @keyframes heroFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes heroFadeBlurIn {
    from {
      opacity: 0;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      filter: none;
    }
  }

  @keyframes portraitCardIn {
    from { transform: translate3d(0, 26px, 0) scale(0.92); }
    to { transform: none; }
  }

  @keyframes portraitMediaSettle {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }

  @keyframes sheenSweep {
    0% {
      opacity: 0;
      transform: translate3d(-115%, 0, 0);
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(115%, 0, 0);
    }
  }

  @keyframes heroCopyExit {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translate3d(0, -24px, 0);
      opacity: 0.25;
    }
  }

  @keyframes heroPortraitExit {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translate3d(0, 18px, 0) scale(0.95);
      opacity: 0.35;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 2rem;
      gap: 2.5rem;
    }
    .hero-portrait {
      justify-self: start;
      max-width: 100%;
      display: grid;
      grid-template-columns: 96px 1fr;
      align-items: center;
      gap: 1rem;
      order: -1;
    }
    .portrait-frame {
      aspect-ratio: 1;
      border-radius: 20px;
      box-shadow: none;
    }
    figcaption { padding: 0; }
    .eyebrow { margin-bottom: 1rem; }
  }

  @media (max-width: 420px) {
    .hero-actions .btn { flex: 1 1 100%; }
  }
</style>
