---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { HERO_COPY, SITE_IDENTITY } from '../data/site';
---

<section class="hero" id="hero" aria-label="Introduction">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
  </div>

  <div class="site-wrap">
    <div class="hero-card">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span class="hero-emblem" aria-hidden="true">
            <img src="/images/brand/spawntel-emblem.webp" alt="" width="24" height="24" decoding="async" />
          </span>
          <span>{SITE_IDENTITY.niche}</span>
        </div>

        <h1 class="hero-h1">Marketing shouldn't run on manual hustle.</h1>

        <p class="hero-sub">{HERO_COPY.subtitle}</p>

        <div class="cta-row hero-actions">
          <a
            href={spawntelFunnelUrl('hero')}
            class="cta-btn"
            data-spawntel-cta="hero"
          >
            <span>{HERO_COPY.primaryCtaLabel}</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>

          <a href={HERO_COPY.secondaryCtaHref} class="cta-btn-dark">
            <span>{HERO_COPY.secondaryCtaLabel}</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>

        <div class="hero-meta">
          <ul class="hero-socials" aria-label="Beneru social profiles">
            {SOCIAL_LINKS.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${s.label} (${s.handle})`}
                  title={`${s.label} (${s.handle})`}
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={s.iconSvg} />
                </a>
              </li>
            ))}
          </ul>
          <span class="hero-loc">{SITE_IDENTITY.locationPublic}</span>
        </div>
      </div>

      <figure class="hero-portrait-card">
        <span class="hero-status-chip">
          <span class="hero-status-dot" aria-hidden="true"></span>
          3 Verified Systems
        </span>
        <img
          src="/images/founder/reuben-studio.webp"
          alt={HERO_COPY.portraitAlt}
          width="900"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="hero-portrait-cap">
          <strong>{SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName})</strong>
          <span>{SITE_IDENTITY.role}, {SITE_IDENTITY.companyName}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(28px, 3.6vw, 48px);
    padding-bottom: clamp(28px, 4vw, 56px);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(52% 62% at 78% 24%, rgba(103, 0, 255, 0.28), transparent 68%),
      radial-gradient(45% 55% at 18% 12%, rgba(143, 77, 255, 0.16), transparent 68%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(183, 155, 255, 0.08) 1px, transparent 1px),
      linear-gradient(rgba(183, 155, 255, 0.06) 1px, transparent 1px);
    background-size: 112px 112px;
    -webkit-mask-image: radial-gradient(75% 75% at 50% 25%, #000 0%, transparent 90%);
    mask-image: radial-gradient(75% 75% at 50% 25%, #000 0%, transparent 90%);
  }

  /* Liquid Glass Hero Card */
  .hero-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.92fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding: clamp(24px, 3.8vw, 50px);
    border-radius: 32px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--blur-glass);
    backdrop-filter: var(--blur-glass);
    box-shadow: var(--glass-rim);
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(55% 65% at 86% 10%, rgba(183, 155, 255, 0.16), transparent 65%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 6px 7px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(103, 0, 255, 0.16));
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: var(--violet-pale);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-emblem {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--primary);
    flex-shrink: 0;
  }

  .hero-emblem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-h1 {
    margin: 20px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 1.35rem + 2.65vw, 3.65rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -0.03em;
    max-width: 15ch;
    padding-bottom: 0.06em;
    background-image: var(--grad-shimmer);
    background-size: var(--blob-bg-size);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: text-blob-drift 13s ease-in-out -2.4s infinite alternate;
  }

  .hero-sub {
    margin: 16px 0 0;
    max-width: 50ch;
    color: var(--ink-body);
    font-size: clamp(0.975rem, 0.93rem + 0.24vw, 1.08rem);
    line-height: 1.6;
  }

  .hero-actions {
    margin-top: 26px;
    justify-content: flex-start;
  }

  .hero-meta {
    width: 100%;
    margin-top: clamp(24px, 3vw, 34px);
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 20px;
  }

  .hero-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero-socials a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.03));
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
    color: var(--ink-body);
    display: grid;
    place-items: center;
    transition: background-color 0.16s ease, border-color 0.16s ease, transform 0.16s var(--ease-out);
  }

  .hero-socials a:hover {
    background: var(--primary);
    border-color: rgba(226, 210, 255, 0.4);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .hero-loc {
    font-size: 13px;
    color: var(--ink-muted);
    font-weight: 500;
  }

  /* Right Liquid-Bevel Portrait Frame */
  .hero-portrait-card {
    position: relative;
    z-index: 1;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: #1B0D36;
    aspect-ratio: 4 / 4.35;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 24px 58px -24px rgba(103, 0, 255, 0.56);
  }

  .hero-portrait-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 14%;
  }

  .hero-status-chip {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, rgba(24, 20, 38, 0.68), rgba(11, 10, 16, 0.56));
    -webkit-backdrop-filter: var(--blur-sm);
    backdrop-filter: var(--blur-sm);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
  }

  .hero-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--violet-bright);
    box-shadow: 0 0 10px var(--violet-bright);
  }

  .hero-portrait-cap {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 13px 16px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(22, 18, 34, 0.68), rgba(11, 10, 16, 0.62));
    -webkit-backdrop-filter: var(--blur-sm);
    backdrop-filter: var(--blur-sm);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-portrait-cap strong {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .hero-portrait-cap span {
    font-size: 13px;
    color: var(--violet-pale);
    line-height: 1.35;
  }

  @media (max-width: 960px) {
    .hero-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .hero-h1 {
      max-width: 18ch;
    }

    .hero-portrait-card {
      max-width: 440px;
      width: 100%;
      margin-inline: auto;
      aspect-ratio: 4 / 4.2;
    }
  }

  @media (max-width: 520px) {
    .hero-card {
      padding: 20px;
      border-radius: 24px;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .cta-btn,
    .hero-actions .cta-btn-dark {
      height: 44px;
      padding: 0 7px 0 16px;
      font-size: 13.5px;
      gap: 9px;
    }

    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
