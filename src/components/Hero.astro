---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { HERO_COPY, SITE_IDENTITY } from '../data/site';
---

<section class="hero" id="hero" aria-label="Introduction">
  <div class="site-wrap">
    <div class="hero-card">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span class="hero-emblem" aria-hidden="true">
            <img src="/images/brand/spawntel-emblem.webp" alt="" width="22" height="22" decoding="async" />
          </span>
          <span>{SITE_IDENTITY.niche}</span>
        </div>

        <h1 class="hero-h1">
          Marketing shouldn't run on <span class="accent-word">manual hustle.</span>
        </h1>

        <p class="hero-sub">{HERO_COPY.subtitle}</p>

        <div class="cta-row hero-actions">
          <a
            href={spawntelFunnelUrl('hero')}
            class="cta-btn"
            data-spawntel-cta="hero"
          >
            <span>{HERO_COPY.primaryCtaLabel}</span>
            <span class="cta-btn__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>

          <a href={HERO_COPY.secondaryCtaHref} class="cta-btn-dark">
            <span>{HERO_COPY.secondaryCtaLabel}</span>
            <span class="cta-btn__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>

        <div class="hero-meta-bar">
          <ul class="hero-socials" aria-label="Beneru social profiles">
            {SOCIAL_LINKS.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${s.label} (${s.handle})`}
                  title={`${s.label} (${s.handle})`}
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={s.iconSvg} />
                </a>
              </li>
            ))}
          </ul>
          <span class="hero-location">{SITE_IDENTITY.locationPublic}</span>
        </div>
      </div>

      <figure class="hero-portrait-card">
        <span class="hero-live-chip">
          <span class="hero-live-dot" aria-hidden="true"></span>
          3 Documented Systems
        </span>
        <img
          src="/images/founder/reuben-studio.webp"
          alt={HERO_COPY.portraitAlt}
          width="900"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="hero-portrait-cap">
          <strong>{SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName})</strong>
          <span>{SITE_IDENTITY.role}, {SITE_IDENTITY.companyName}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(20px, 2.6vw, 32px);
  }

  .hero-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.92fr);
    gap: clamp(28px, 4vw, 52px);
    align-items: center;
    padding: clamp(24px, 3.6vw, 48px);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(183, 155, 255, 0.16);
    background:
      radial-gradient(65% 80% at 88% 12%, rgba(103, 0, 255, 0.2), transparent 65%),
      linear-gradient(155deg, #171124 0%, #120D1C 58%, #0F0A18 100%);
    box-shadow:
      inset 0 1px 0 rgba(215, 200, 255, 0.14),
      var(--shadow-card);
    overflow: hidden;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 6px 7px;
    border-radius: var(--radius-full);
    background: rgba(103, 0, 255, 0.14);
    border: 1px solid rgba(183, 155, 255, 0.22);
    color: var(--violet-pale);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-emblem {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--primary);
    flex-shrink: 0;
  }

  .hero-emblem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-h1 {
    margin: 20px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 1.35rem + 2.55vw, 3.55rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -0.03em;
    color: var(--ink);
    max-width: 15ch;
  }

  .hero-sub {
    margin: 18px 0 0;
    max-width: 50ch;
    color: var(--ink-2);
    font-size: clamp(0.975rem, 0.94rem + 0.2vw, 1.08rem);
    line-height: 1.62;
  }

  .hero-actions {
    margin-top: 26px;
  }

  .hero-meta-bar {
    width: 100%;
    margin-top: clamp(24px, 3vw, 34px);
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 20px;
  }

  .hero-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero-socials a {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    color: var(--ink-body);
    display: grid;
    place-items: center;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s var(--ease-out);
  }

  .hero-socials a:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .hero-location {
    font-size: 13px;
    color: var(--ink-muted);
    font-weight: 500;
  }

  /* Right Portrait Frame */
  .hero-portrait-card {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(183, 155, 255, 0.24);
    background: #1C0D38;
    aspect-ratio: 4 / 4.45;
    box-shadow: 0 20px 50px -24px rgba(103, 0, 255, 0.45);
  }

  .hero-portrait-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 14%;
  }

  .hero-live-chip {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(13, 8, 20, 0.84);
    border: 1px solid rgba(183, 155, 255, 0.28);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
  }

  .hero-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--violet-bright);
    box-shadow: 0 0 10px var(--violet-bright);
  }

  .hero-portrait-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 44px 18px 16px;
    background: linear-gradient(transparent, rgba(13, 8, 20, 0.88) 46%, rgba(13, 8, 20, 0.96) 100%);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-portrait-cap strong {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .hero-portrait-cap span {
    font-size: 13px;
    color: var(--violet-pale);
    line-height: 1.35;
  }

  @media (max-width: 960px) {
    .hero-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .hero-h1 {
      max-width: 18ch;
    }

    .hero-portrait-card {
      max-width: 440px;
      width: 100%;
      margin-inline: auto;
      aspect-ratio: 4 / 4.2;
    }
  }

  @media (max-width: 520px) {
    .hero-card {
      padding: 20px;
      border-radius: 22px;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .cta-btn,
    .hero-actions .cta-btn-dark {
      flex: 1 1 auto;
      height: 44px;
      padding: 0 16px;
      font-size: 14px;
    }

    .hero-meta-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
