---
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow hero-in" style="--d:0">AI Direction &amp; Marketing Systems</p>
    <h1 id="hero-heading" class="headline hero-in" style="--d:1">
      Marketing shouldn't run on <span class="accent">manual hustle.</span>
    </h1>
    <p class="subtitle hero-in" style="--d:2">
      I build AI systems that repurpose content, qualify DMs and test ads, so your team stops doing it by hand.
    </p>
    <div class="hero-actions hero-in" style="--d:3">
      <a href="#demo" class="btn btn-primary" data-open-booking>
        Book an audit <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="#work" class="btn btn-ghost">See the work</a>
    </div>
  </div>

  <figure class="hero-portrait">
    <div class="portrait-frame">
      <picture>
        <source srcset="/PFP-hero.webp" type="image/webp" />
        <img
          src="/PFP.png"
          alt="Reuben (Ben) Magallanes, founder of Beneru"
          width="880"
          height="880"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <figcaption>
      <strong>Reuben Magallanes</strong>
      <span>Marketing Head &amp; Co-Founder, Spawntel</span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: calc(100dvh - 68px);
    padding: clamp(2.5rem, 6vw, 5rem) 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent-ink);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .headline {
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 16ch;
    margin: 0 0 1.5rem;
  }

  .headline .accent { color: var(--accent-ink); }

  .subtitle {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 44ch;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Portrait */
  .hero-portrait {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 420px;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: var(--accent);
    box-shadow: 0 30px 60px -30px rgba(103, 0, 255, 0.55);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease-out);
  }

  .hero-portrait:hover .portrait-frame img { transform: scale(1.05); }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 0.25rem 0;
    font-size: 0.9rem;
  }

  figcaption strong { font-weight: 600; letter-spacing: -0.01em; }
  figcaption span { color: var(--ink-muted); }

  /* Load-in: draws the eye top to bottom, then to the portrait */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      opacity: 0;
      transform: translateY(14px);
      animation: heroIn 0.8s var(--ease-out) forwards;
      animation-delay: calc(var(--d) * 90ms + 80ms);
    }
    .portrait-frame {
      clip-path: inset(8% 8% 8% 8% round 28px);
      animation: portraitIn 1.1s var(--ease-out) 0.15s forwards;
    }
  }

  @keyframes heroIn { to { opacity: 1; transform: none; } }
  @keyframes portraitIn { to { clip-path: inset(0 0 0 0 round 28px); } }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 2rem;
      gap: 2.5rem;
    }
    .hero-portrait {
      justify-self: start;
      max-width: 100%;
      display: grid;
      grid-template-columns: 96px 1fr;
      align-items: center;
      gap: 1rem;
      order: -1;
    }
    .portrait-frame {
      aspect-ratio: 1;
      border-radius: 20px;
      box-shadow: none;
    }
    figcaption { padding: 0; }
    .eyebrow { margin-bottom: 1rem; }
  }

  @media (max-width: 420px) {
    .hero-actions .btn { flex: 1 1 100%; }
  }
</style>
