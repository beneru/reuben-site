---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { HERO_COPY, SITE_IDENTITY } from '../data/site';
---

<section class="hero theme-dark" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-scene" aria-hidden="true">
    <div class="hero-sky"></div>
    <div class="hero-layer layer-bank" data-depth="0.30">
      <img src="/images/clouds/layer-bank.webp" alt="" width="1024" height="572" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-peak" data-depth="0.18">
      <img src="/images/clouds/layer-peak.webp" alt="" width="1376" height="768" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-glow" data-depth="0">
      <img src="/images/clouds/layer-glow.webp" alt="" width="688" height="384" decoding="async" />
    </div>
    <div class="hero-layer layer-hills" data-depth="0">
      <img src="/images/clouds/layer-mountains.webp" alt="" width="1376" height="768" decoding="async" />
    </div>
    <div class="hero-layer layer-mist" data-depth="-0.12">
      <img src="/images/clouds/layer-mist.webp" alt="" width="1024" height="572" decoding="async" />
    </div>
    <div class="hero-layer layer-forest layer-forest-left" data-depth="-0.26" data-spread="-0.14">
      <img src="/images/clouds/layer-forest-left.webp" alt="" width="646" height="653" decoding="async" />
    </div>
    <div class="hero-layer layer-forest layer-forest-right" data-depth="-0.22" data-spread="0.14">
      <img src="/images/clouds/layer-forest-right.webp" alt="" width="850" height="653" decoding="async" />
    </div>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="site-wrap hero-inner">
    <div class="hero-top" data-hero-top>
      <p class="hero-kicker">{SITE_IDENTITY.niche}</p>
      <h1 class="hero-title" id="hero-title">Marketing shouldn't run on manual hustle.</h1>
      <p class="hero-sub">{HERO_COPY.subtitle}</p>
      <a href={spawntelFunnelUrl('hero')} class="cta-btn hero-cta" data-spawntel-cta="hero">
        <span>{HERO_COPY.primaryCtaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  /*
   * Depth on scroll: every layer slides at its own rate (positive depth = lags, far;
   * negative = outruns the page, near). Scroll only sets a target; one shared value
   * glides toward it with frame-rate-independent exponential damping (~0.22s), so all
   * objects move together, smoothly and slightly delayed. Only transform + opacity are
   * written (GPU composited), the hero height is cached on resize, and the loop sleeps
   * as soon as the motion settles.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('.hero-layer[data-depth]')).map((el) => ({
      el,
      d: Number(el.dataset.depth || 0),
      sx: Number(el.dataset.spread || 0),
    }));
    const top = hero.querySelector<HTMLElement>('[data-hero-top]');
    const TAU = 220;
    let heroH = hero.offsetHeight;
    let target = 0;
    let current = 0;
    let raf = 0;
    let last = 0;

    const apply = (y: number) => {
      for (const { el, d, sx } of layers) {
        el.style.transform = `translate3d(${(y * sx).toFixed(2)}px, ${(y * d).toFixed(2)}px, 0)`;
      }
      if (top) {
        top.style.transform = `translate3d(0, ${(y * 0.35).toFixed(2)}px, 0)`;
        top.style.opacity = Math.max(0, 1 - y / (heroH * 0.6)).toFixed(3);
      }
    };

    const step = (now: number) => {
      const dt = last ? Math.min(64, now - last) : 16.7;
      last = now;
      current += (target - current) * (1 - Math.exp(-dt / TAU));
      if (Math.abs(target - current) < 0.05) {
        current = target;
        apply(current);
        raf = 0;
        last = 0;
        return;
      }
      apply(current);
      raf = requestAnimationFrame(step);
    };

    const kick = () => {
      target = Math.min(window.scrollY, heroH);
      if (!raf) {
        last = 0;
        raf = requestAnimationFrame(step);
      }
    };

    target = current = Math.min(window.scrollY, heroH);
    apply(current);
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', () => { heroH = hero.offsetHeight; kick(); }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: max(100svh, 700px);
    display: flex;
    background: #0D0814;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    --lw: max(100vw, 1180px);
    --lwh: calc(var(--lw) * 0.5581);
    --horizon: 64svh;
  }

  .hero-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46% 30% at 50% 30%, rgba(103, 0, 255, 0.45), transparent 72%),
      radial-gradient(38% 34% at 50% 62%, rgba(240, 237, 247, 0.55), rgba(215, 200, 255, 0.16) 55%, transparent 75%),
      linear-gradient(180deg, #6700FF 0%, #7E26FF 26%, #A068FF 52%, #C2AAFF 74%, #D7C8FF 100%);
  }

  .hero-layer {
    position: absolute;
    left: 50%;
    width: var(--lw);
    margin-left: calc(var(--lw) / -2);
    will-change: transform;
  }

  .hero-layer img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Back to front: bank (blended), peak, hills, near mist (blended) */
  .layer-bank {
    z-index: 2;
    top: calc(var(--horizon) + 1svh - var(--lwh) * 0.26);
  }

  .layer-bank img,
  .layer-mist img {
    width: 108%;
    max-width: none;
    margin-left: -4%;
  }

  .layer-bank img {
    animation: hero-drift-a 38s ease-in-out infinite alternate;
  }

  .layer-peak {
    z-index: 3;
    top: calc(var(--horizon) - var(--lwh) * 0.32);
  }

  /* Small tree-covered mountains; the glow is a soft blur that follows the ridgeline (no hard rim line) */
  .layer-glow,
  .layer-hills {
    z-index: 4;
    top: calc(var(--horizon) + 14svh - var(--lwh) * 0.47);
  }

  .layer-mist {
    z-index: 5;
    top: calc(var(--horizon) + 30svh - var(--lwh) * 0.65);
  }

  .layer-mist img {
    animation: hero-drift-b 26s ease-in-out infinite alternate;
  }

  /* Closest layer: forest slopes framing both edges, open in the middle */
  .layer-forest {
    z-index: 6;
    bottom: -4%;
    margin-left: 0;
  }

  .layer-forest-left {
    left: 0;
    width: clamp(260px, 32vw, 560px);
  }

  .layer-forest-right {
    left: auto;
    right: 0;
    width: clamp(320px, 40vw, 720px);
  }

  @keyframes hero-drift-a {
    from { transform: translate3d(-2.5%, 0, 0); }
    to { transform: translate3d(2.5%, 0, 0); }
  }

  @keyframes hero-drift-b {
    from { transform: translate3d(3%, 0, 0); }
    to { transform: translate3d(-3%, 0, 0); }
  }

  /* Darkens the lower band so white copy stays readable over the ridges, then melts into cream */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
      linear-gradient(180deg, rgba(240, 237, 247, 0.000) 82.0%, rgba(240, 237, 247, 0.034) 84.0%, rgba(240, 237, 247, 0.126) 86.0%, rgba(240, 237, 247, 0.259) 88.0%, rgba(240, 237, 247, 0.417) 90.0%, rgba(240, 237, 247, 0.583) 92.0%, rgba(240, 237, 247, 0.741) 94.0%, rgba(240, 237, 247, 0.874) 96.0%, rgba(240, 237, 247, 0.966) 98.0%, rgba(240, 237, 247, 1.000) 100.0%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    padding-top: calc(var(--nav-h) + clamp(20px, 5vh, 56px));
    padding-bottom: clamp(88px, 12vh, 140px);
  }

  /* Headline sits in front of the landscape and lags slightly on scroll */
  .hero-top {
    position: relative;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    will-change: transform, opacity;
  }

  .hero-kicker {
    margin: 0;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-title {
    margin: 18px 0 0;
    max-width: 22ch;
    font-size: clamp(2.5rem, 1.2rem + 4vw, 5.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-wrap: balance;
    text-shadow: 0 8px 48px rgba(13, 8, 20, 0.28);
  }

  .hero-sub {
    margin: 20px 0 0;
    max-width: 50ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.18rem);
    line-height: 1.6;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(13, 8, 20, 0.45), 0 4px 28px rgba(13, 8, 20, 0.55);
  }

  .hero-cta {
    margin-top: 26px;
  }

  /* White pill reads cleanly against the violet sky */
  .hero-cta.cta-btn {
    background: #FFFFFF;
    color: #0D0814;
    box-shadow: 0 16px 40px -18px rgba(13, 8, 20, 0.55);
  }

  .hero-cta.cta-btn:hover {
    color: #0D0814;
  }

  @media (max-width: 760px) {
    .hero-scene {
      --horizon: 72svh;
    }

    .hero {
      min-height: max(100svh, 680px);
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
        linear-gradient(180deg, rgba(240, 237, 247, 0.000) 84.0%, rgba(240, 237, 247, 0.034) 85.8%, rgba(240, 237, 247, 0.126) 87.6%, rgba(240, 237, 247, 0.259) 89.3%, rgba(240, 237, 247, 0.417) 91.1%, rgba(240, 237, 247, 0.583) 92.9%, rgba(240, 237, 247, 0.741) 94.7%, rgba(240, 237, 247, 0.874) 96.4%, rgba(240, 237, 247, 0.966) 98.2%, rgba(240, 237, 247, 1.000) 100.0%);
    }

    .layer-forest-left {
      width: 80vw;
      left: -22vw;
      bottom: 0;
    }

    .layer-forest-right {
      width: 92vw;
      right: -30vw;
      bottom: -2%;
    }

    .hero-title {
      max-width: 12ch;
    }


  }
</style>
