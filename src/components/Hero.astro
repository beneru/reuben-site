---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { HERO_COPY, SITE_IDENTITY } from '../data/site';
---

<section class="hero theme-dark" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-scene" aria-hidden="true">
    <div class="hero-layer layer-bank" data-depth="0.28">
      <img src="/images/clouds/hero-bank-v2.webp" alt="" width="1024" height="372" loading="eager" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-skyline-far" data-depth="0.16">
      <img src="/images/clouds/hero-skyline-far-v3.webp" alt="" width="1376" height="540" loading="eager" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-skyline-mid" data-depth="0">
      <img src="/images/clouds/hero-skyline-mid-v3.webp" alt="" width="1376" height="588" loading="eager" decoding="async" fetchpriority="high" />
    </div>
    <div class="hero-layer layer-mist" data-depth="-0.10">
      <img src="/images/clouds/hero-mist-v2.webp" alt="" width="1024" height="386" loading="eager" decoding="async" />
    </div>
    <div class="hero-layer layer-rooftop layer-rooftop-left" data-depth="-0.22" data-spread="-0.14">
      <img src="/images/clouds/hero-rooftop-left-v3.webp" alt="" width="680" height="751" loading="eager" decoding="async" />
    </div>
    <div class="hero-layer layer-rooftop layer-rooftop-right" data-depth="-0.19" data-spread="0.14">
      <img src="/images/clouds/hero-rooftop-right-v3.webp" alt="" width="740" height="862" loading="eager" decoding="async" />
    </div>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="site-wrap hero-inner">
    <div class="hero-top" data-hero-top>
      <p class="hero-kicker">{SITE_IDENTITY.niche}</p>
      <h1 class="hero-title" id="hero-title">Marketing shouldn't run on manual hustle.</h1>
      <p class="hero-sub">{HERO_COPY.subtitle}</p>
      <a href={spawntelFunnelUrl('hero')} class="cta-btn hero-cta" data-spawntel-cta="hero">
        <span>{HERO_COPY.primaryCtaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    // Pause infinite hero cloud drift whenever hero is scrolled offscreen (0% offscreen GPU drain)
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          hero.classList.toggle('is-offscreen', !entries[0]?.isIntersecting);
        },
        { rootMargin: '120px 0px' }
      ).observe(hero);
    }

    // Native CSS `animation-timeline: view()` drives Hero parallax 100% on the GPU compositor
    // thread in Chrome/Brave/Edge (zero JS during scroll). Fallback JS runs ONLY on browsers
    // without native scroll-driven animations.
    const nativeScrollAnim = typeof CSS !== 'undefined' && CSS.supports('animation-timeline: view()');
    if (!nativeScrollAnim && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const layers = Array.from(hero.querySelectorAll<HTMLElement>('.hero-layer[data-depth]'))
        .map((el) => ({
          el,
          d: Number(el.dataset.depth || 0),
          sx: Number(el.dataset.spread || 0),
        }))
        .filter(({ d, sx }) => d !== 0 || sx !== 0);
      const top = hero.querySelector<HTMLElement>('[data-hero-top]');
      const TAU = 220;
      let heroH = hero.offsetHeight;
      let target = 0;
      let current = 0;
      let raf = 0;
      let last = 0;

      const apply = (y: number) => {
        for (const { el, d, sx } of layers) {
          el.style.translate = `${(y * sx).toFixed(2)}px ${(y * d).toFixed(2)}px 0`;
        }
        if (top) {
          const fadeRange = Math.max(135, heroH * 0.21);
          top.style.transform = `translate3d(0, ${(y * 0.06).toFixed(2)}px, 0)`;
          top.style.opacity = Math.max(0, 1 - y / fadeRange).toFixed(3);
        }
      };

      const step = (now: number) => {
        const dt = last ? Math.min(64, now - last) : 16.7;
        last = now;
        current += (target - current) * (1 - Math.exp(-dt / TAU));
        if (Math.abs(target - current) < 0.05) {
          current = target;
          apply(current);
          raf = 0;
          last = 0;
          return;
        }
        apply(current);
        raf = requestAnimationFrame(step);
      };

      const kick = () => {
        target = Math.min(window.scrollY, heroH);
        if (!raf) {
          last = 0;
          raf = requestAnimationFrame(step);
        }
      };

      target = current = Math.min(window.scrollY, heroH);
      apply(current);
      window.addEventListener('scroll', kick, { passive: true });
      window.addEventListener('resize', () => { heroH = hero.offsetHeight; kick(); }, { passive: true });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: max(100svh, 700px);
    display: flex;
    background:
      radial-gradient(46% 30% at 50% 30%, rgba(103, 0, 255, 0.45), transparent 72%),
      radial-gradient(38% 34% at 50% 62%, rgba(240, 237, 247, 0.55), rgba(215, 200, 255, 0.16) 55%, transparent 75%),
      linear-gradient(180deg, #6700FF 0%, #7E26FF 26%, #A068FF 52%, #C2AAFF 74%, #D7C8FF 100%);
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    --lw: max(100vw, 1180px);
    --lwh: calc(var(--lw) * 0.5581);
    --horizon: 64svh;
  }

  .hero-layer {
    position: absolute;
    left: 50%;
    width: var(--lw);
    margin-left: calc(var(--lw) / -2);
  }

  .hero-layer img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Back to front: cloud bank, far central skyline, mid skyline (glow baked in), near mist */
  .layer-bank {
    z-index: 2;
    width: calc(var(--lw) * 1.08);
    margin-left: calc(var(--lw) * -0.54);
    top: calc(var(--horizon) + 1svh - var(--lwh) * 0.0292);
    animation: hero-drift-a 38s ease-in-out infinite alternate;
  }

  .layer-skyline-far {
    z-index: 3;
    top: calc(var(--horizon) - var(--lwh) * 0.075);
  }

  .layer-skyline-mid {
    z-index: 4;
    top: calc(var(--horizon) + 12svh - var(--lwh) * 0.08);
  }

  .layer-mist {
    z-index: 5;
    width: calc(var(--lw) * 1.08);
    margin-left: calc(var(--lw) * -0.54);
    top: calc(var(--horizon) + 30svh - var(--lwh) * 0.3248);
    animation: hero-drift-b 26s ease-in-out infinite alternate;
  }

  .hero.is-offscreen .layer-bank,
  .hero.is-offscreen .layer-mist {
    animation-play-state: paused;
  }

  /* Closest layer: foreground studio towers & rooftops framing both edges, open in the middle */
  .layer-rooftop {
    z-index: 6;
    bottom: -5%;
    margin-left: 0;
  }

  .layer-rooftop-left {
    left: 0;
    width: clamp(230px, 28vw, 490px);
  }

  .layer-rooftop-right {
    left: auto;
    right: 0;
    bottom: -6%;
    width: clamp(240px, 30vw, 520px);
  }

  @keyframes hero-drift-a {
    from { transform: translate3d(-2.5%, 0, 0); }
    to { transform: translate3d(2.5%, 0, 0); }
  }

  @keyframes hero-drift-b {
    from { transform: translate3d(3%, 0, 0); }
    to { transform: translate3d(-3%, 0, 0); }
  }

  /* Native compositor-thread Hero scroll parallax (zero JS on Chrome/Brave/Edge) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        view-timeline-name: --hero-tl;
        view-timeline-axis: block;
      }

      @keyframes hp-bank {
        from { translate: 0 0 0; }
        to { translate: 0 24svh 0; }
      }
      @keyframes hp-far {
        from { translate: 0 0 0; }
        to { translate: 0 14svh 0; }
      }
      @keyframes hp-mist {
        from { translate: 0 0 0; }
        to { translate: 0 -9svh 0; }
      }
      @keyframes hp-left {
        from { translate: 0 0 0; }
        to { translate: -12vw -18svh 0; }
      }
      @keyframes hp-right {
        from { translate: 0 0 0; }
        to { translate: 12vw -16svh 0; }
      }
      @keyframes hp-top {
        from { transform: translate3d(0, 0, 0); opacity: 1; }
        to { transform: translate3d(0, 36px, 0); opacity: 0; }
      }

      .layer-bank {
        animation-name: hero-drift-a, hp-bank;
        animation-duration: 38s, auto;
        animation-timing-function: ease-in-out, linear;
        animation-iteration-count: infinite, 1;
        animation-direction: alternate, normal;
        animation-fill-mode: none, both;
        animation-timeline: auto, --hero-tl;
        animation-range: normal, exit 0% exit 100%;
      }
      .layer-skyline-far {
        animation-name: hp-far;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero-tl;
        animation-range: exit 0% exit 100%;
      }
      .layer-mist {
        animation-name: hero-drift-b, hp-mist;
        animation-duration: 26s, auto;
        animation-timing-function: ease-in-out, linear;
        animation-iteration-count: infinite, 1;
        animation-direction: alternate, normal;
        animation-fill-mode: none, both;
        animation-timeline: auto, --hero-tl;
        animation-range: normal, exit 0% exit 100%;
      }
      .layer-rooftop-left {
        animation-name: hp-left;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero-tl;
        animation-range: exit 0% exit 100%;
      }
      .layer-rooftop-right {
        animation-name: hp-right;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero-tl;
        animation-range: exit 0% exit 100%;
      }
      .hero-top {
        animation-name: hp-top;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero-tl;
        animation-range: exit 0% exit 24%;
      }
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
      linear-gradient(180deg, rgba(240, 237, 247, 0.000) 82.0%, rgba(240, 237, 247, 0.034) 84.0%, rgba(240, 237, 247, 0.126) 86.0%, rgba(240, 237, 247, 0.259) 88.0%, rgba(240, 237, 247, 0.417) 90.0%, rgba(240, 237, 247, 0.583) 92.0%, rgba(240, 237, 247, 0.741) 94.0%, rgba(240, 237, 247, 0.874) 96.0%, rgba(240, 237, 247, 0.966) 98.0%, rgba(240, 237, 247, 1.000) 100.0%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    padding-top: calc(var(--nav-h) + clamp(20px, 5vh, 56px));
    padding-bottom: clamp(88px, 12vh, 140px);
  }

  .hero-top {
    position: relative;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-kicker {
    margin: 0;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-title {
    margin: 18px 0 0;
    max-width: 22ch;
    font-size: clamp(2.5rem, 1.2rem + 4vw, 5.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-wrap: balance;
    text-shadow: 0 8px 36px rgba(13, 8, 20, 0.24);
  }

  .hero-sub {
    margin: 20px 0 0;
    max-width: 50ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.18rem);
    line-height: 1.6;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(13, 8, 20, 0.4), 0 4px 20px rgba(13, 8, 20, 0.45);
  }

  .hero-cta {
    margin-top: 26px;
  }

  .hero-cta.cta-btn {
    background: #FFFFFF;
    color: #0D0814;
    box-shadow: 0 12px 28px -14px rgba(13, 8, 20, 0.45);
  }

  .hero-cta.cta-btn:hover {
    color: #0D0814;
  }

  @media (max-width: 760px) {
    .hero-scene {
      --horizon: 72svh;
    }

    .hero {
      min-height: max(100svh, 680px);
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(13, 8, 20, 0.18) 0%, transparent 16%),
        linear-gradient(180deg, rgba(240, 237, 247, 0.000) 84.0%, rgba(240, 237, 247, 0.034) 85.8%, rgba(240, 237, 247, 0.126) 87.6%, rgba(240, 237, 247, 0.259) 89.3%, rgba(240, 237, 247, 0.417) 91.1%, rgba(240, 237, 247, 0.583) 92.9%, rgba(240, 237, 247, 0.741) 94.7%, rgba(240, 237, 247, 0.874) 96.4%, rgba(240, 237, 247, 0.966) 98.2%, rgba(240, 237, 247, 1.000) 100.0%);
    }

    .layer-rooftop-left {
      width: 58vw;
      left: -16vw;
      bottom: -2%;
    }

    .layer-rooftop-right {
      width: 60vw;
      right: -16vw;
      bottom: -3%;
    }

    .hero-title {
      max-width: 12ch;
    }
  }
</style>
