---
import { caseStudies } from '../data/portfolio';
import { INSTAGRAM_URL } from '../../shared/socials';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? caseStudies.slice(0, limit) : caseStudies;
---

{items.length > 0 ? (
  <div class="work-grid">
    {items.map((item, i) => {
      const Tag = item.href ? 'a' : 'article';
      return (
        <Tag
          class:list={['work-card', { featured: item.featured }]}
          href={item.href}
          data-reveal
          style={`--i:${i}`}
        >
          <div class="work-media">
            <img src={item.image} alt="" loading="lazy" decoding="async" width="1200" height="900" />
          </div>
          <div class="work-body">
            <p class="work-meta">{item.category} &middot; {item.year}</p>
            <h3>{item.title}</h3>
            <p class="work-summary">{item.summary}</p>
            {item.result && <p class="work-result">{item.result}</p>}
          </div>
        </Tag>
      );
    })}
  </div>
) : (
  <div class="work-empty" data-reveal>
    <div class="empty-frames" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="empty-copy">
      <h3>Case studies are being written up.</h3>
      <p>
        The first client systems are live. I'm documenting the before, the build and the numbers, and they'll land here soon.
      </p>
      <a class="empty-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        Follow the build on Instagram <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
)}

<style>
  /* Filled state */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border-subtle);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    overflow: hidden;
    color: var(--ink);
    transition: transform 0.4s var(--spring-ios), box-shadow 0.35s var(--ease-ios), border-color 0.22s ease, background-color 0.25s ease;
  }

  a.work-card:hover {
    transform: translateY(-3px);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight), var(--shadow-md);
    border-color: var(--glass-tint-border);
    color: var(--ink);
  }

  .work-card.featured { grid-column: 1 / -1; }

  .work-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-2);
  }

  .featured .work-media { aspect-ratio: 21 / 9; }

  .work-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  a.work-card:hover .work-media img { transform: scale(1.03); }

  .work-body { padding: 1.5rem 1.5rem 1.75rem; }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }

  .work-body h3 { font-size: var(--step-2); margin-bottom: 0.5rem; }

  .work-summary { color: var(--ink-2); margin: 0; max-width: 60ch; }

  .work-result {
    margin: 1rem 0 0;
    font-weight: 600;
    color: var(--accent-ink);
  }

  /* Empty state */
  .work-empty {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
  }

  .empty-frames {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    aspect-ratio: 16 / 10;
  }

  .empty-frames span {
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-tint-border);
    background:
      linear-gradient(
        145deg,
        var(--glass-tint) 0%,
        color-mix(in srgb, var(--glass-bg-strong) 70%, transparent) 100%
      );
    box-shadow: var(--glass-highlight), var(--shadow-sm);
  }

  .empty-frames span:first-child { grid-row: 1 / -1; }

  .empty-copy h3 { font-size: var(--step-2); margin-bottom: 0.75rem; }

  .empty-copy p { color: var(--ink-2); margin: 0 0 1.5rem; max-width: 42ch; }

  .empty-link {
    font-weight: 600;
    color: var(--accent-ink);
    display: inline-flex;
    gap: 0.4rem;
  }

  .empty-link span { transition: transform 0.25s var(--ease-out); }
  .empty-link:hover span { transform: translateX(3px); }

  @media (max-width: 760px) {
    .work-grid { grid-template-columns: 1fr; }
    .featured .work-media { aspect-ratio: 4 / 3; }
    .work-empty { grid-template-columns: 1fr; }
    .empty-frames { order: 1; }
  }
</style>
