---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { PROBLEM_CARDS, PROBLEM_SECTION_COPY } from '../data/site';

const wallLabels = [
  'Brand DNA',
  'DM routing',
  'Caption hooks',
  'QA gates',
  'Lead handoff',
  'Content briefs',
];
---

<section class="section-block problem-section" id="problem" aria-labelledby="problem-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{PROBLEM_SECTION_COPY.pill}</span>
      <h2 class="grad-title" id="problem-heading">{PROBLEM_SECTION_COPY.heading}</h2>
    </div>
  </div>

  <div class="pb-shell">
    <div class="pb-track" data-pb-track tabindex="0" aria-label="Marketing bottlenecks carousel">
      {PROBLEM_CARDS.map((card, idx) => (
        <article class="pb-card" data-reveal style={`--i: ${idx}`}>
          <div class="pb-visual" aria-hidden="true">
            {card.id === 'radar' && (
              <div class="vis-radar">
                <span class="radar-ring ring-1"></span>
                <span class="radar-ring ring-2"></span>
                <span class="radar-ring ring-3"></span>
                <span class="radar-node node-a">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                </span>
                <span class="radar-node node-b">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                </span>
                <span class="radar-node node-c">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                  </svg>
                </span>
                <div class="radar-core">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                  </svg>
                </div>
              </div>
            )}

            {card.id === 'stack' && (
              <div class="vis-stack">
                <div class="stack-card stack-card-1">
                  <div class="stack-top">
                    <span class="stack-ico">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                      </svg>
                    </span>
                    <span class="stack-title">Unanswered IG DMs</span>
                  </div>
                  <span class="stack-sub">in the inbox</span>
                  <span class="stack-status">Open</span>
                </div>

                <div class="stack-card stack-card-2">
                  <div class="stack-top">
                    <span class="stack-ico">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20v-9" />
                        <path d="M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z" />
                        <path d="M9 7.13V6a3 3 0 1 1 6 0v1.13" />
                      </svg>
                    </span>
                    <span class="stack-title">Missed comments</span>
                  </div>
                  <span class="stack-sub">across posts</span>
                  <span class="stack-status">Growing</span>
                </div>

                <div class="stack-card stack-card-3">
                  <div class="stack-top">
                    <span class="stack-ico">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8l6 6v12a2 2 0 0 1-2 2z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                      </svg>
                    </span>
                    <span class="stack-title">Undocumented rules</span>
                  </div>
                  <span class="stack-sub">in one head</span>
                  <span class="stack-status">Risk</span>
                </div>
              </div>
            )}

            {card.id === 'chat' && (
              <div class="vis-chat">
                <div class="chat-feed">
                  <div class="chat-scroll">
                    <div class="chat-row chat-row--user">
                      <span class="chat-bubble chat-bubble--user">Adapt this offer for 5 channels</span>
                      <span class="chat-av chat-av--violet">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                      </span>
                    </div>
                    <div class="chat-row chat-row--bot">
                      <span class="chat-av chat-av--dark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4"/></svg>
                      </span>
                      <span class="chat-bubble chat-bubble--bot">Extracting Brand DNA...</span>
                    </div>
                    <div class="chat-row chat-row--user">
                      <span class="chat-bubble chat-bubble--user">Qualify this IG DM</span>
                      <span class="chat-av chat-av--violet">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                      </span>
                    </div>
                    <div class="chat-row chat-row--bot">
                      <span class="chat-av chat-av--dark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4"/></svg>
                      </span>
                      <span class="chat-bubble chat-bubble--bot">Checking pricing guardrails...</span>
                    </div>
                  </div>
                </div>
                <div class="chat-input">
                  <span>Ask for anything...</span>
                  <span class="chat-send">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
                      <path d="m21.854 2.147-10.94 10.939" />
                    </svg>
                  </span>
                </div>
              </div>
            )}

            {card.id === 'wall' && (
              <div class="vis-wall">
                <div class="wall-rows">
                  {[0, 1, 2, 3].map((row) => (
                    <div class={`wall-row ${row % 2 === 1 ? 'wall-row--rev' : ''}`}>
                      {[...wallLabels, ...wallLabels].map((lbl) => (
                        <span class="wall-pill">{lbl}</span>
                      ))}
                    </div>
                  ))}
                </div>
                <div class="wall-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8l6 6v12a2 2 0 0 1-2 2z" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                  </svg>
                </div>
              </div>
            )}
          </div>

          <div class="pb-body">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="site-wrap pb-controls">
      <div class="pb-progress-track" aria-hidden="true">
        <div class="pb-progress-bar" data-pb-bar></div>
      </div>
      <div class="pb-nav">
        <button type="button" class="pb-arrow" data-pb-prev aria-label="Previous problem card" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <button type="button" class="pb-arrow" data-pb-next aria-label="Next problem card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="site-wrap cta-row pb-cta">
      <a href={spawntelFunnelUrl('problem')} class="cta-btn" data-spawntel-cta="problem">
        <span>Book a Call</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>

      <a href="/#work" class="cta-btn-dark">
        <span>See the Work</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-pb-track]');
  const bar = document.querySelector<HTMLElement>('[data-pb-bar]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-pb-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-pb-next]');

  if (track && bar && prevBtn && nextBtn) {
    let maxScroll = 0;
    let step = 380;
    let raf = 0;

    const measure = () => {
      maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      const card = track.querySelector<HTMLElement>('.pb-card');
      step = card ? card.offsetWidth + 20 : 380;
    };

    const update = () => {
      raf = 0;
      const left = track.scrollLeft;
      const ratio = maxScroll > 1 ? left / maxScroll : 1;
      const scale = Math.max(0.22, Math.min(1, 0.22 + ratio * 0.78));
      bar.style.transform = `scaleX(${scale.toFixed(4)})`;
      prevBtn.disabled = left <= 6;
      nextBtn.disabled = left >= maxScroll - 6;
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -step, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: step, behavior: 'smooth' });
    });
    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    }, { passive: true });

    measure();
    update();
  }
</script>

<style>
  .pb-shell {
    position: relative;
  }

  .pb-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: max(1rem, calc((100vw - 1320px) / 2), 6vw);
    padding-bottom: 10px;
  }

  .pb-track::-webkit-scrollbar {
    display: none;
  }

  .pb-card {
    flex: 0 0 clamp(292px, 31vw, 396px);
    scroll-snap-align: start;
    contain: layout paint;
    border-radius: 28px;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, rgba(24, 24, 29, 0.94), rgba(15, 15, 18, 0.98));
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: var(--shadow-card);
  }

  .pb-visual {
    position: relative;
    height: 272px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .pb-body {
    padding: 0 8px 10px;
  }

  .pb-body h3 {
    margin: 0;
    font-size: 17.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .pb-body p {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---- Visual 1: Concentric Violet Radar ---- */
  .vis-radar {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .radar-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(103, 0, 255, 0.42);
  }

  .ring-1 { width: 126px; height: 126px; opacity: 0.8; }
  .ring-2 { width: 208px; height: 208px; opacity: 0.55; }
  .ring-3 { width: 292px; height: 292px; opacity: 0.34; }

  .radar-core {
    position: relative;
    z-index: 2;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-violet);
  }

  .radar-core svg {
    width: 28px;
    height: 28px;
  }

  .radar-node {
    position: absolute;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #1B1B20;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #C7C7D1;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  }

  .radar-node svg {
    width: 15px;
    height: 15px;
  }

  .node-a { top: 24px; right: 98px; }
  .node-b { bottom: 36px; left: 48px; opacity: 0.72; }
  .node-c { top: 68px; left: 42px; opacity: 0.58; }

  /* ---- Visual 2: Tilted 3-Card Status Stack ---- */
  .vis-stack {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 18px;
    transform: perspective(700px) rotateY(8deg) rotateZ(-4deg);
  }

  .stack-card {
    position: absolute;
    width: 78%;
    padding: 14px 16px;
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(25, 25, 31, 0.96), rgba(14, 14, 18, 0.96));
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.65);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stack-card-1 { top: 18px; left: 16px; z-index: 1; opacity: 0.78; }
  .stack-card-2 { top: 76px; left: 52px; z-index: 2; opacity: 0.9; }
  .stack-card-3 { top: 132px; left: 84px; z-index: 3; }

  .stack-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stack-ico {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    box-shadow: 0 0 16px rgba(103, 0, 255, 0.7);
    flex-shrink: 0;
  }

  .stack-ico svg {
    width: 13px;
    height: 13px;
  }

  .stack-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .stack-sub {
    font-size: 13px;
    color: var(--ink-2);
  }

  .stack-status {
    font-size: 11.5px;
    color: var(--violet-soft);
    font-weight: 500;
  }

  /* ---- Visual 3: Agent Chat UI ---- */
  .vis-chat {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }

  .chat-feed {
    flex: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(transparent, #000 16%, #000 84%, transparent);
  }

  .chat-scroll {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .chat-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chat-row--user {
    justify-content: flex-end;
  }

  .chat-bubble {
    padding: 9px 13px;
    font-size: 12px;
    line-height: 1.35;
    max-width: 78%;
  }

  .chat-bubble--user {
    border-radius: 14px 14px 4px 14px;
    background: var(--primary);
    color: #FFFFFF;
    box-shadow: var(--shadow-violet);
  }

  .chat-bubble--bot {
    border-radius: 14px 14px 14px 4px;
    background: #1C1C22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #D2D2DA;
  }

  .chat-av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .chat-av--violet {
    background: var(--primary);
    color: #FFFFFF;
    box-shadow: 0 0 18px rgba(103, 0, 255, 0.65);
  }

  .chat-av--dark {
    background: #1B1B21;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #D4D4DA;
  }

  .chat-av svg {
    width: 14px;
    height: 14px;
  }

  .chat-input {
    height: 44px;
    border-radius: 999px;
    background: rgba(24, 24, 30, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0 7px 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    color: var(--ink-muted);
  }

  .chat-send {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    box-shadow: 0 0 18px rgba(103, 0, 255, 0.65);
  }

  .chat-send svg {
    width: 14px;
    height: 14px;
  }

  /* ---- Visual 4: Scrolling Pill Wall ---- */
  .vis-wall {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .wall-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 180%;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(circle at center, #000 18%, transparent 72%);
    mask-image: radial-gradient(circle at center, #000 18%, transparent 72%);
  }

  .wall-row {
    display: flex;
    gap: 10px;
    width: max-content;
    transform: translateX(-8%);
  }

  .wall-row--rev {
    transform: translateX(-22%);
  }

  .wall-pill {
    padding: 10px 16px;
    border-radius: 14px;
    background: #1B1B21;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #B4B4BE;
    font-size: 12.5px;
    white-space: nowrap;
  }

  .wall-badge {
    position: absolute;
    z-index: 3;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-violet);
  }

  .wall-badge svg {
    width: 26px;
    height: 26px;
  }

  /* ---- Progress & Carousel Arrows ---- */
  .pb-controls {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pb-progress-track {
    position: relative;
    width: min(50%, 520px);
    height: 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .pb-progress-bar {
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: var(--primary);
    box-shadow: 0 0 14px rgba(103, 0, 255, 0.72);
    transform-origin: left center;
    transform: scaleX(0.28);
    will-change: transform;
  }

  .pb-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pb-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #18181D;
    border: 1px solid var(--border);
    color: var(--ink);
    display: grid;
    place-items: center;
    transition: background-color 0.16s ease, border-color 0.16s ease, opacity 0.16s ease;
  }

  .pb-arrow:hover:not(:disabled) {
    background: #23232A;
    border-color: var(--border-strong);
  }

  .pb-arrow:disabled {
    opacity: 0.36;
    cursor: default;
  }

  .pb-arrow svg {
    width: 17px;
    height: 17px;
  }

  .pb-cta {
    margin-top: 34px;
  }

  @media (max-width: 768px) {
    .pb-track {
      padding-inline: 1rem;
    }

    .pb-card {
      flex: 0 0 calc(100vw - 2.5rem);
    }

    .pb-progress-track {
      width: 58%;
    }
  }
</style>
