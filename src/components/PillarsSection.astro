---
import { PILLARS_COPY, type PillarIcon } from '../data/site';

const iconPaths: Record<PillarIcon, string> = {
  shield: 'M12 3 5 6v6c0 4.5 3 8 7 9 4-1 7-4.5 7-9V6l-7-3Z',
  eye: 'M2 12s3.8-6.5 10-6.5S22 12 22 12s-3.8 6.5-10 6.5S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  doc: 'M6 3h8l4 4v14H6V3Zm7 1.5V8h3.5L13 4.5Z',
  funnel: 'M3 5h18l-7 8v6l-4-2v-4L3 5Z',
  layers: 'M12 3 2 8l10 5 10-5-10-5Zm0 8-8-4v3.5l8 4 8-4V7l-8 4Zm0 5-8-4v3.5l8 4 8-4V12l-8 4Z',
  buyer: 'M12 12a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4Zm-7.5 8.5c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6H4.5Z',
};
---

<section class="section-block pl has-float" id="approach" aria-labelledby="pl-title" data-stage-section>
  <div class="float-scene" aria-hidden="true">
    <span
      class="float-pill"
      data-pill-side="left"
      style="left: clamp(28px, 5.5vw, 110px); top: 8%;"
    >
      <span class="float-pill__dot"></span>
      Human Takeover
    </span>
  </div>

  <div class="site-wrap">
    <div class="pl-head" data-reveal>
      <h2 class="pl-title" id="pl-title">{PILLARS_COPY.heading}</h2>
      <p class="pl-lead">{PILLARS_COPY.lead}</p>
    </div>

    <div class="pl-rows">
      {PILLARS_COPY.pillars.map((pillar, idx) => (
        <article class={`pl-row ${idx % 2 === 1 ? 'pl-row--flip' : ''}`} data-stage-frames>
          <div class="pl-copy" data-reveal>
            <h3>{pillar.title}</h3>
            <p class="pl-text">{pillar.text}</p>
            <ul class="pl-bullets">
              {pillar.bullets.map((b, bIdx) => (
                <li
                  data-frame-slide={idx % 2 === 0 ? 'left' : 'right'}
                  data-shine="light"
                  style={`--fi: ${(0.25 + bIdx * 0.35).toFixed(2)}`}
                >
                  <span class="pl-bullet-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d={iconPaths[b.icon]} />
                    </svg>
                  </span>
                  <span>{b.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div
            class={`pl-media pl-media--${pillar.image.fit}`}
            data-frame-slide={idx % 2 === 0 ? 'right' : 'left'}
            data-shine={pillar.image.fit === 'contain' ? 'dark' : 'light'}
            style="--fi: 0"
          >
            <img
              src={pillar.image.src}
              alt={pillar.image.alt}
              width={pillar.image.width}
              height={pillar.image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pl-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .pl-title {
    margin: 0;
    font-size: clamp(2rem, 1.35rem + 2.3vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pl-lead {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .pl-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 112px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .pl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .pl-row--flip .pl-copy {
    order: 2;
  }

  .pl-copy h3 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 1.9vw, 2.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .pl-text {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .pl-bullets {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 48ch;
  }

  .pl-bullets li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    border-radius: 18px;
    background: #FFFFFF;
    box-shadow: 0 10px 24px -16px rgba(103, 0, 255, 0.22);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
    color: #0D0814;
  }

  .pl-bullet-icon {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: #F0EDF7;
    color: #6700FF;
    flex-shrink: 0;
  }

  .pl-bullet-icon svg {
    width: 15px;
    height: 15px;
  }

  .pl-media {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    background: var(--frame-bg);
    aspect-ratio: 4 / 3;
    box-shadow: 0 18px 36px -22px rgba(103, 0, 255, 0.34);
  }

  /* Dark diagrams get the dark brand gradient whatever the section */
  .pl-media--contain {
    --frame-bg: linear-gradient(155deg, #6700FF 0%, #15111E 64%, #0D0814 100%);
    aspect-ratio: auto;
  }

  .pl-media img {
    width: 100%;
    height: 100%;
  }

  .pl-media--contain img {
    height: auto;
    object-fit: contain;
    padding: clamp(16px, 3vw, 34px);
  }

  /* Photo sits cleanly inside the light brand-gradient tray (zero runtime CSS filter) */
  .pl-media--cover {
    padding: clamp(14px, 1.8vw, 22px);
  }

  .pl-media--cover img {
    border-radius: 18px;
    object-fit: cover;
    object-position: center 22%;
    box-shadow: 0 14px 28px -18px rgba(13, 8, 20, 0.36);
  }

  .pl-media--cover::before {
    content: '';
    position: absolute;
    inset: clamp(14px, 1.8vw, 22px);
    z-index: 2;
    border-radius: 18px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(103, 0, 255, 0.08) 0%, rgba(13, 8, 20, 0.16) 100%);
  }

  @media (max-width: 900px) {
    .pl-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .pl-row--flip .pl-copy {
      order: 0;
    }
  }
</style>
