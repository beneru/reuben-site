---
import { PILLARS_COPY, type PillarIcon } from '../data/site';

const ICONS: Record<PillarIcon, string> = {
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  doc: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  funnel: '<path d="M3 4h18l-7 8.5V19l-4 2v-8.5z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  buyer: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
};
---

<section class="section-block pl" id="approach" aria-labelledby="pl-title">
  <div class="site-wrap">
    <div class="pl-head" data-reveal>
      <h2 class="pl-title" id="pl-title">{PILLARS_COPY.heading}</h2>
      <p class="pl-lead">{PILLARS_COPY.lead}</p>
    </div>

    <div class="pl-rows">
      {PILLARS_COPY.pillars.map((pillar, idx) => (
        <article class={`pl-row ${idx % 2 === 1 ? 'pl-row--flip' : ''}`}>
          <div class="pl-copy" data-reveal>
            <h3>{pillar.title}</h3>
            <p class="pl-text">{pillar.text}</p>
            <ul class="pl-bullets">
              {pillar.bullets.map((b) => (
                <li>
                  <span class="pl-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[b.icon]} />
                  </span>
                  <span>{b.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class={`pl-media pl-media--${pillar.image.fit}`} data-reveal style="--i: 1">
            <img
              src={pillar.image.src}
              alt={pillar.image.alt}
              width={pillar.image.width}
              height={pillar.image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pl-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .pl-title {
    margin: 0;
    font-size: clamp(2rem, 1.35rem + 2.3vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pl-lead {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .pl-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 120px);
  }

  .pl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }

  .pl-row--flip .pl-copy {
    order: 2;
  }

  .pl-copy h3 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 1.9vw, 2.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .pl-text {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .pl-bullets {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .pl-bullets li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-body);
  }

  .pl-icon {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(103, 0, 255, 0.14);
    border: 1px solid rgba(183, 155, 255, 0.22);
    color: var(--violet-soft);
  }

  .pl-icon svg {
    width: 19px;
    height: 19px;
  }

  .pl-media {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    background: #0E0D14;
    box-shadow: var(--glass-rim);
    aspect-ratio: 4 / 3;
  }

  .pl-media img {
    width: 100%;
    height: 100%;
  }

  .pl-media--contain {
    aspect-ratio: auto;
  }

  .pl-media--contain img {
    height: auto;
    object-fit: contain;
    padding: clamp(16px, 3vw, 36px);
  }

  .pl-media--cover img {
    object-fit: cover;
    object-position: center 22%;
  }

  @media (max-width: 900px) {
    .pl-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .pl-row--flip .pl-copy {
      order: 0;
    }
  }
</style>
