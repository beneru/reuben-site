---
import { PILLARS_COPY } from '../data/site';
---

<section class="section-block pl" id="approach" aria-labelledby="pl-title">
  <div class="site-wrap">
    <div class="pl-head" data-reveal>
      <h2 class="pl-title" id="pl-title">{PILLARS_COPY.heading}</h2>
      <p class="pl-lead">{PILLARS_COPY.lead}</p>
    </div>

    <div class="pl-rows">
      {PILLARS_COPY.pillars.map((pillar, idx) => (
        <article class={`pl-row ${idx % 2 === 1 ? 'pl-row--flip' : ''}`}>
          <div class="pl-copy" data-reveal>
            <h3>{pillar.title}</h3>
            <p class="pl-text">{pillar.text}</p>
          </div>

          <div class={`pl-media pl-media--${pillar.image.fit}`} data-reveal style="--i: 1">
            <img
              src={pillar.image.src}
              alt={pillar.image.alt}
              width={pillar.image.width}
              height={pillar.image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pl-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .pl-title {
    margin: 0;
    font-size: clamp(2rem, 1.35rem + 2.3vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pl-lead {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .pl-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 120px);
  }

  .pl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }

  .pl-row--flip .pl-copy {
    order: 2;
  }

  .pl-copy h3 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 1.9vw, 2.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .pl-text {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .pl-media {
    border-radius: 24px;
    overflow: hidden;
    background: var(--frame-bg);
    aspect-ratio: 4 / 3;
  }

  /* Dark diagrams get the dark brand gradient whatever the section */
  .pl-media--contain {
    --frame-bg: linear-gradient(155deg, #6700FF 0%, #15111E 64%, #0D0814 100%);
  }

  .pl-media img {
    width: 100%;
    height: 100%;
  }

  .pl-media--contain {
    aspect-ratio: auto;
  }

  .pl-media--contain img {
    height: auto;
    object-fit: contain;
    padding: clamp(16px, 3vw, 36px);
  }

  .pl-media--cover img {
    object-fit: cover;
    object-position: center 22%;
  }

  @media (max-width: 900px) {
    .pl-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .pl-row--flip .pl-copy {
      order: 0;
    }
  }
</style>
