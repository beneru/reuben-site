---
import { WORK_SECTION_COPY } from '../data/site';
import { WORK_BUILDS } from '../data/work';

const liveLabels: Record<string, string> = {
  'meta-dm-qualifier': '83 E2E checks passing',
  'brand-dna-creative-pipeline': 'Verified on beneru.spawntel.com',
  'multi-agent-marketing-brain': 'Active daily system',
};
---

<section class="section-block" id="work" aria-labelledby="work-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{WORK_SECTION_COPY.pill}</span>
      <h2 class="section-title" id="work-heading">
        Built, documented, and <span class="accent-word">verified</span>
      </h2>
    </div>

    <div class="wk-grid">
      {WORK_BUILDS.map((build, idx) => (
        <a
          href={`/work/${build.slug}/`}
          class={`wk-card ${idx === 0 ? 'wk-card--featured' : ''}`}
          data-reveal
          style={`--i: ${idx}`}
        >
          <div class="wk-media">
            <img
              src={build.cardImage.src}
              alt={build.cardImage.alt}
              width={build.cardImage.width}
              height={build.cardImage.height}
              loading="lazy"
              decoding="async"
              class={idx === 0 ? 'wk-img-cover' : 'wk-img-diagram'}
            />
          </div>

          <div class="wk-body">
            <div class="wk-meta">
              <span class="wk-status">{liveLabels[build.slug] ?? build.statusLabel}</span>
              <span class="wk-cat">{build.category}</span>
            </div>
            <h3>{build.title}</h3>
            <p>{build.summary}</p>
            <span class="wk-read">
              Read technical breakdown <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .wk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .wk-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.2s var(--ease-out), background-color 0.18s ease;
  }

  .wk-card:hover {
    border-color: var(--border-violet);
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .wk-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: stretch;
  }

  .wk-media {
    background: #0E0B16;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .wk-card--featured .wk-media {
    border-bottom: none;
    border-right: 1px solid var(--border);
    aspect-ratio: auto;
    min-height: 320px;
  }

  .wk-img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .wk-img-diagram {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
    background: #0E0B16;
  }

  .wk-body {
    padding: clamp(22px, 2.6vw, 30px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .wk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .wk-status {
    padding: 4px 11px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
  }

  .wk-cat {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-soft);
  }

  .wk-body h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.05rem + 0.65vw, 1.65rem);
    font-weight: 700;
    color: var(--ink);
  }

  .wk-body p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .wk-read {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--violet-soft);
  }

  .wk-card:hover .wk-read {
    color: #FFFFFF;
  }

  @media (max-width: 960px) {
    .wk-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .wk-card--featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .wk-card--featured .wk-media {
      border-right: none;
      border-bottom: 1px solid var(--border);
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
