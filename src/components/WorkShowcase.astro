---
import { WORK_SECTION_COPY } from '../data/site';
import { WORK_BUILDS } from '../data/work';

/* One metric per build, each traceable to verifiedFacts in work.ts. */
const metrics: Record<string, { value: string; label: string }> = {
  'meta-dm-qualifier': { value: '83', label: 'automated tests passed' },
  'brand-dna-creative-pipeline': { value: '1 link', label: 'in, 5 ready-to-post Instagram visuals out' },
  'multi-agent-marketing-brain': { value: '5', label: 'social platforms from one idea, used daily' },
};

const tones: Record<string, string> = {
  'meta-dm-qualifier': 'violet',
  'brand-dna-creative-pipeline': 'rose',
  'multi-agent-marketing-brain': 'blue',
};
---

<section class="section-block has-float" id="work" aria-labelledby="work-heading" data-stage-section>
  <div class="float-scene" aria-hidden="true">
    <img
      class="side-cloud side-cloud--left"
      src="/images/clouds/side-cloud-left-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="top: 12%;"
    />
    <img
      class="side-cloud side-cloud--right"
      src="/images/clouds/side-cloud-right-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="bottom: 12%;"
    />
    <span
      class="float-pill"
      data-pill-side="right"
      style="right: clamp(28px, 5.5vw, 110px); top: 8%;"
    >
      <span class="float-pill__dot"></span>
      Tested Before Launch
    </span>
  </div>

  <div class="site-wrap">
    <div class="wk-head" data-reveal>
      <h2 class="wk-title" id="work-heading">{WORK_SECTION_COPY.heading}</h2>
      {WORK_SECTION_COPY.lead && <p class="wk-sub">{WORK_SECTION_COPY.lead}</p>}
    </div>

    <ul class="wk-grid">
      {WORK_BUILDS.map((build, idx) => (
        <li
          class={`wk-card wk-card--${tones[build.slug] ?? 'violet'} ${idx === 0 ? 'wk-card--wide' : ''} theme-dark`}
          data-stage-frames
          data-frame-slide={idx === 2 ? 'right' : 'left'}
          data-shine="dark"
          style={`--fi: ${idx === 2 ? 0.65 : 0}`}
        >
          <a href={`/work/${build.slug}/`} class="wk-link">
            <div class="wk-copy">
              <h3>{build.title}</h3>
              {metrics[build.slug] && (
                <p class="wk-metric">
                  <span class="wk-metric__value">{metrics[build.slug].value}</span>
                  <span class="wk-metric__label">{metrics[build.slug].label}</span>
                </p>
              )}
              <span class="wk-read">See how it works <span aria-hidden="true">&rarr;</span></span>
            </div>
            <div class={`wk-media ${idx === 0 ? 'wk-media--shot' : 'wk-media--diagram'}`}>
              <img
                src={build.cardImage.src}
                alt={build.cardImage.alt}
                width={build.cardImage.width}
                height={build.cardImage.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wk-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .wk-title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .wk-sub {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .wk-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1180px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .wk-card {
    border-radius: 30px;
    overflow: hidden;
    transition: transform 0.26s var(--ease-out);
    box-shadow: 0 18px 36px -22px rgba(103, 0, 255, 0.4);
  }

  .wk-card:hover {
    transform: translateY(-4px);
  }

  .wk-card--violet {
    background: radial-gradient(90% 120% at 100% 0%, rgba(143, 77, 255, 0.45), transparent 60%), linear-gradient(150deg, #6700FF 0%, #0D0814 100%);
  }

  .wk-card--rose {
    background: radial-gradient(90% 120% at 100% 0%, rgba(183, 155, 255, 0.4), transparent 60%), linear-gradient(150deg, #8F4DFF 0%, #15111E 100%);
  }

  .wk-card--blue {
    background: radial-gradient(90% 120% at 100% 0%, rgba(103, 0, 255, 0.45), transparent 60%), linear-gradient(150deg, #7E26FF 0%, #0D0814 100%);
  }

  .wk-card--wide {
    grid-column: 1 / -1;
  }

  .wk-link {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0;
  }

  .wk-card--wide .wk-link {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    align-items: end;
    gap: clamp(24px, 4vw, 56px);
  }

  .wk-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .wk-card--wide .wk-copy {
    align-self: center;
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .wk-copy h3 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #FFFFFF;
  }

  .wk-metric {
    margin: 20px 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .wk-metric__value {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 1.7rem + 2.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: #FFFFFF;
  }

  .wk-metric__label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
  }

  .wk-read {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 13.5px;
    font-weight: 600;
    color: #FFFFFF;
    transition: background-color 0.16s ease;
  }

  .wk-link:hover .wk-read {
    background: rgba(255, 255, 255, 0.26);
  }

  .wk-media {
    margin-top: auto;
    border-radius: 18px 18px 0 0;
    overflow: hidden;
    background: transparent;
  }

  .wk-media img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.45s var(--ease-out);
  }

  .wk-media--diagram img {
    padding: 12px 12px 4px;
  }

  .wk-link:hover .wk-media img {
    transform: scale(1.025);
  }

  @media (max-width: 900px) {
    .wk-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .wk-card--wide .wk-link {
      display: flex;
      flex-direction: column;
    }

    .wk-card--wide .wk-copy {
      padding-bottom: 0;
    }
  }
</style>
