---
import { FLAGSHIP_COPY } from '../data/site';
import { WORK_BUILDS } from '../data/work';

const build = WORK_BUILDS.find((b) => b.slug === 'meta-dm-qualifier')!;

/* Illustration only: generic inbox rows, no real people or businesses. */
const inboxRows = [
  { initials: 'JM', channel: 'Instagram DM', text: 'Hi! How much is the package?', age: '14h' },
  { initials: 'AL', channel: 'Facebook comment', text: 'Is this still available?', age: '9h' },
  { initials: 'RC', channel: 'Messenger', text: 'Can I book a slot this week?', age: '6h' },
  { initials: 'KD', channel: 'Instagram DM', text: 'Hello?? Anyone there?', age: '3h' },
];
---

<section class="fs theme-dark" id="flagship" aria-labelledby="fs-title">
  <img class="fs-photo" src="/images/clouds/band-clouds.webp" alt="" width="1376" height="768" loading="lazy" decoding="async" />
  <div class="fs-scrim" aria-hidden="true"></div>
  <div class="site-wrap fs-grid">
    <div class="fs-copy" data-reveal>
      <p class="fs-kicker">{FLAGSHIP_COPY.kicker} &middot; Meta DM Qualifier</p>
      <h2 class="fs-title" id="fs-title">{FLAGSHIP_COPY.heading}</h2>
      <p class="fs-lead">{FLAGSHIP_COPY.lead}</p>


      <div class="fs-foot">
        <span class="fs-status"><span class="fs-status__dot" aria-hidden="true"></span>{FLAGSHIP_COPY.status}</span>
        <a class="fs-link" href={FLAGSHIP_COPY.href}>
          {FLAGSHIP_COPY.linkLabel} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <figure class="fs-compare" data-stage-frames>
      <div class="ba" data-ba data-frame-slide="right" data-shine="dark" style="--pos: 50%; --fi: 0;">
        <img
          class="ba-after"
          src={build.cardImage.src}
          alt={build.cardImage.alt}
          width={build.cardImage.width}
          height={build.cardImage.height}
          loading="lazy"
          decoding="async"
        />

        <div class="ba-before" aria-hidden="true">
          <div class="inbox">
            <div class="inbox-head">
              <span>Inbox</span>
              <span class="inbox-badge">Unanswered</span>
            </div>
            <ul class="inbox-rows">
              {inboxRows.map((row) => (
                <li>
                  <span class="inbox-avatar">{row.initials}</span>
                  <span class="inbox-text">
                    <span class="inbox-channel">{row.channel}</span>
                    <span class="inbox-msg">{row.text}</span>
                  </span>
                  <span class="inbox-age">{row.age}</span>
                  <span class="inbox-dot"></span>
                </li>
              ))}
            </ul>
            <p class="inbox-note">You, answering between client work.</p>
          </div>
        </div>

        <span class="ba-chip ba-chip--before" aria-hidden="true">{FLAGSHIP_COPY.beforeLabel}</span>
        <span class="ba-chip ba-chip--after" aria-hidden="true">{FLAGSHIP_COPY.afterLabel}</span>

        <div class="ba-handle" aria-hidden="true">
          <span class="ba-knob">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 6-6 6 6 6" />
              <path d="m15 6 6 6-6 6" />
            </svg>
          </span>
        </div>

        <input
          class="ba-range"
          type="range"
          min="0"
          max="100"
          step="1"
          value="50"
          aria-label={FLAGSHIP_COPY.sliderLabel}
          data-ba-range
        />
      </div>

    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const paint = () => frame.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', paint);
    paint();
  });
</script>

<style>
  .fs {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(120px, 13vw, 200px) clamp(140px, 15vw, 240px);
    background: #0D0814;
  }

  .fs-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .fs-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(240, 237, 247, 1.000) 0.0%, rgba(240, 237, 247, 0.966) 2.7%, rgba(240, 237, 247, 0.874) 5.3%, rgba(240, 237, 247, 0.741) 8.0%, rgba(240, 237, 247, 0.583) 10.7%, rgba(240, 237, 247, 0.417) 13.3%, rgba(240, 237, 247, 0.259) 16.0%, rgba(240, 237, 247, 0.126) 18.7%, rgba(240, 237, 247, 0.034) 21.3%, rgba(240, 237, 247, 0.000) 24.0%),
      linear-gradient(180deg, rgba(240, 237, 247, 0.000) 80.0%, rgba(240, 237, 247, 0.034) 82.2%, rgba(240, 237, 247, 0.126) 84.4%, rgba(240, 237, 247, 0.259) 86.7%, rgba(240, 237, 247, 0.417) 88.9%, rgba(240, 237, 247, 0.583) 91.1%, rgba(240, 237, 247, 0.741) 93.3%, rgba(240, 237, 247, 0.874) 95.6%, rgba(240, 237, 247, 0.966) 97.8%, rgba(240, 237, 247, 1.000) 100.0%),
      linear-gradient(180deg, rgba(13, 8, 20, 0.12) 18%, rgba(13, 8, 20, 0.3) 45%, rgba(13, 8, 20, 0.3) 62%, rgba(13, 8, 20, 0.08) 84%);
  }

  .fs-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(36px, 5vw, 64px);
  }

  .fs-copy {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .fs-kicker {
    margin: 0 0 18px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #FFFFFF;
    font-size: 13.5px;
    font-weight: 600;
    color: #0D0814;
  }

  .fs-title {
    margin: 0;
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.2rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    max-width: 16ch;
    text-shadow: 0 6px 40px rgba(13, 8, 20, 0.4);
  }

  .fs-lead {
    margin: 20px 0 0;
    max-width: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }

  .fs-foot {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 22px;
  }

  .fs-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(13, 8, 20, 0.45);
    font-size: 12.5px;
    color: #FFFFFF;
  }

  .fs-status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #B79BFF;
  }

  .fs-link {
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-underline-offset: 4px;
  }

  .fs-link:hover {
    text-decoration-color: currentColor;
  }

  /* Before / after comparison */
  .fs-compare {
    margin: 0;
    width: min(980px, 100%);
  }

  .ba {
    --pos: 50%;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 22px;
    overflow: hidden;
    background: var(--frame-bg);
    box-shadow: 0 40px 90px -40px rgba(13, 8, 20, 0.6);
    container-type: inline-size;
    user-select: none;
  }

  .ba-after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    background:
      radial-gradient(70% 90% at 20% 10%, rgba(103, 0, 255, 0.08), transparent 70%),
      #15111E;
  }

  .inbox {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(42px, 8cqi, 56px) 5cqi clamp(12px, 3.2cqi, 20px);
  }

  .inbox-head {
    display: flex;
    align-items: center;
    gap: 2cqi;
    font-family: var(--font-heading);
    font-size: clamp(13px, 3.2cqi, 22px);
    font-weight: 700;
    color: #F0EDF7;
  }

  .inbox-badge {
    padding: 0.5cqi 1.6cqi;
    border-radius: 999px;
    background: #6700FF;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: clamp(9px, 1.6cqi, 12px);
    font-weight: 600;
  }

  .inbox-rows {
    list-style: none;
    margin: 3.2cqi 0 0;
    padding: 0;
    display: grid;
    gap: 1.6cqi;
  }

  .inbox-rows li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 2cqi;
    padding: 1.7cqi 2cqi;
    border-radius: 1.8cqi;
    background: rgba(255, 255, 255, 0.04);
  }

  .inbox-avatar {
    width: 5.6cqi;
    height: 5.6cqi;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #1F1A2C;
    color: #C2BCD4;
    font-size: clamp(8px, 1.6cqi, 12px);
    font-weight: 600;
  }

  .inbox-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .inbox-channel {
    font-size: clamp(8px, 1.5cqi, 11px);
    color: #94A3B8;
  }

  .inbox-msg {
    font-size: clamp(10px, 2.1cqi, 15px);
    color: #F0EDF7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .inbox-age {
    font-size: clamp(8px, 1.6cqi, 12px);
    color: #B79BFF;
  }

  .inbox-dot {
    width: 1.4cqi;
    height: 1.4cqi;
    min-width: 6px;
    min-height: 6px;
    border-radius: 50%;
    background: #6700FF;
  }

  .inbox-note {
    margin: auto 0 0;
    font-size: clamp(9px, 1.8cqi, 13px);
    font-style: italic;
    color: #94A3B8;
  }

  .ba-chip {
    position: absolute;
    top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    pointer-events: none;
    background: rgba(13, 8, 20, 0.82);
    color: #FFFFFF;
  }

  .ba-chip--before {
    left: 10px;
  }

  .ba-chip--after {
    right: 10px;
    background: var(--primary);
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #FFFFFF;
    box-shadow: 0 0 18px rgba(103, 0, 255, 0.8);
    pointer-events: none;
  }

  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #FFFFFF;
    color: var(--primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition: transform 0.15s var(--ease-out);
  }

  .ba-knob svg {
    width: 20px;
    height: 20px;
  }

  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .ba:has(.ba-range:focus-visible) .ba-knob {
    outline: 2px solid var(--violet-soft);
    outline-offset: 3px;
  }

  .ba:has(.ba-range:active) .ba-knob {
    transform: scale(0.94);
  }

  @media (max-width: 560px) {
    .ba {
      aspect-ratio: 10 / 9;
    }

    .inbox {
      padding: 40px 4.5cqi 12px;
    }

    .inbox-rows {
      margin-top: 2.5cqi;
      gap: 1.5cqi;
    }

    .inbox-rows li {
      padding: 1.5cqi 2cqi;
    }
  }

</style>
