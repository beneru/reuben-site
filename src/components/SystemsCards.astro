---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SYSTEMS_SECTION_COPY, SYSTEM_TIER_CARDS } from '../data/site';
---

<section class="section-block has-float" id="systems" aria-labelledby="systems-heading" data-stage-section>
  <div class="float-scene" aria-hidden="true">
    <img
      class="side-cloud side-cloud--left"
      src="/images/clouds/side-cloud-left-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="bottom: 8%;"
    />
    <img
      class="side-cloud side-cloud--right"
      src="/images/clouds/side-cloud-right-v1.webp"
      alt=""
      width="540"
      height="420"
      loading="lazy"
      decoding="async"
      style="top: 10%;"
    />
    <span
      class="float-pill"
      data-pill-side="left"
      style="left: clamp(28px, 5.5vw, 110px); top: 10%;"
    >
      <span class="float-pill__dot"></span>
      5-Channel Cascade
    </span>
  </div>

  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <h2 class="grad-title" id="systems-heading">{SYSTEMS_SECTION_COPY.heading}</h2>
      {SYSTEMS_SECTION_COPY.lead && <p class="section-sub">{SYSTEMS_SECTION_COPY.lead}</p>}
    </div>

    <div class="pc-grid" data-stage-frames>
      {SYSTEM_TIER_CARDS.map((card, idx) => (
        <article
          class={`pc-card ${card.featured ? 'pc-featured theme-dark' : ''}`}
          data-frame-slide={idx === 2 ? 'right' : 'left'}
          data-shine={card.featured ? 'dark' : 'light'}
          style={`--fi: ${idx === 0 ? 0 : idx === 2 ? 0.8 : 1.6}`}
        >
          <div class="pc-top">
            <div class="pc-meta-row">
              <span class="pc-icon" aria-hidden="true">
                {idx === 0 && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <rect x="3" y="4" width="18" height="4.5" rx="2.25" />
                    <rect x="3" y="10.25" width="13.5" height="4.5" rx="2.25" opacity="0.72" />
                    <rect x="3" y="16.5" width="9" height="4.5" rx="2.25" opacity="0.45" />
                  </svg>
                )}
                {idx === 1 && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 6.5A3.5 3.5 0 0 1 7.5 3h9A3.5 3.5 0 0 1 20 6.5v6A3.5 3.5 0 0 1 16.5 16h-5.3L6.8 19.7A1 1 0 0 1 5.2 18.9V16A3.5 3.5 0 0 1 4 13.4v-6.9Z" />
                  </svg>
                )}
                {idx === 2 && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <rect x="3" y="3" width="8" height="8" rx="2.5" />
                    <rect x="13" y="3" width="8" height="8" rx="2.5" opacity="0.5" />
                    <rect x="3" y="13" width="8" height="8" rx="2.5" opacity="0.5" />
                    <rect x="13" y="13" width="8" height="8" rx="2.5" />
                  </svg>
                )}
              </span>
              {card.featured && <span class="pc-badge">{card.badge}</span>}
            </div>

            <div class="pc-copy">
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
          </div>

          <ul class="pc-list">
            {card.bullets.map((bullet) => (
              <li>
                <span class="pc-tick" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="cta-row pc-more">
      <a href={spawntelFunnelUrl('systems-dm')} class="cta-btn" data-spawntel-cta="systems-dm">
        <span>Book a free call</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .pc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
    max-width: 1180px;
    margin-inline: auto;
  }

  .pc-card {
    border-radius: 30px;
    background: #FFFFFF;
    padding: clamp(24px, 2.8vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    box-shadow: 0 14px 32px -20px rgba(103, 0, 255, 0.22);
    transition: transform 0.24s var(--ease-expo);
  }

  .pc-card:hover {
    transform: translate3d(0, -4px, 0);
  }

  /* Committed dark-violet centerpiece: one unmistakable focal anchor */
  .pc-featured {
    z-index: 2;
    background:
      radial-gradient(95% 110% at 100% 0%, rgba(183, 155, 255, 0.34), transparent 58%),
      linear-gradient(155deg, #6700FF 0%, #1F0D4A 60%, #0D0814 100%);
    box-shadow: 0 18px 38px -20px rgba(103, 0, 255, 0.46);
    transform: translate3d(0, -10px, 0);
  }

  .pc-featured:hover {
    transform: translate3d(0, -14px, 0);
  }

  .pc-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pc-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: #F0EDF7;
    color: #6700FF;
    flex-shrink: 0;
  }

  .pc-featured .pc-icon {
    background: #FFFFFF;
    color: #6700FF;
  }

  .pc-icon svg {
    width: 20px;
    height: 20px;
  }

  .pc-badge {
    width: fit-content;
    padding: 5px 12px;
    border-radius: 999px;
    background: #FFFFFF;
    color: #0D0814;
    font-size: 12px;
    font-weight: 600;
  }

  .pc-copy h3 {
    margin: 0;
    font-size: clamp(1.45rem, 1.2rem + 0.9vw, 1.95rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #0D0814;
  }

  .pc-featured .pc-copy h3 {
    color: #FFFFFF;
  }

  .pc-copy p {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
  }

  .pc-featured .pc-copy p {
    color: #E2D6FF;
  }

  .pc-list {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .pc-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .pc-featured .pc-list li {
    color: #F0EDF7;
  }

  .pc-tick {
    color: #6700FF;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .pc-featured .pc-tick {
    color: #B79BFF;
  }

  .pc-tick svg {
    width: 15px;
    height: 15px;
  }

  .pc-more {
    margin-top: 36px;
  }

  @media (max-width: 980px) {
    .pc-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
      margin-inline: auto;
    }

    .pc-featured,
    .pc-featured:hover {
      transform: none;
    }
  }
</style>
