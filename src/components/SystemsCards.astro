---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SYSTEMS_SECTION_COPY, SYSTEM_TIER_CARDS } from '../data/site';
---

<section class="section-block" id="systems" aria-labelledby="systems-heading">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{SYSTEMS_SECTION_COPY.pill}</span>
      <h2 class="grad-title" id="systems-heading">{SYSTEMS_SECTION_COPY.heading}</h2>
      {SYSTEMS_SECTION_COPY.lead && <p class="section-sub">{SYSTEMS_SECTION_COPY.lead}</p>}
    </div>

    <div class="pc-grid">
      {SYSTEM_TIER_CARDS.map((card, idx) => (
        <article
          class={`pc-card ${card.featured ? 'pc-featured' : ''}`}
          data-reveal
          style={`--i: ${idx}`}
        >
          <div class="pc-top">
            <span class="pill-tag pc-badge">{card.badge}</span>
            <div class="pc-copy">
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
            <a
              href={spawntelFunnelUrl(card.ctaPlacement)}
              class={card.featured ? 'cta-btn pc-cta' : 'cta-btn-dark pc-cta'}
              data-spawntel-cta={card.ctaPlacement}
            >
              <span>Book a free call</span>
              <span class="cta-btn__circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </a>
          </div>

          <ul class="pc-list">
            {card.bullets.map((bullet) => (
              <li>
                <span class="pc-tick" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="cta-row pc-more">
      <a href="/#work" class="cta-btn-dark">
        <span>See documented systems</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .pc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .pc-card {
    border-radius: 30px;
    border: 1px solid var(--border);
    background: linear-gradient(175deg, rgba(22, 22, 27, 0.9), rgba(14, 14, 17, 0.96));
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--shadow-card);
  }

  .pc-featured {
    border-color: var(--border-violet);
    box-shadow:
      0 0 0 1px rgba(103, 0, 255, 0.24),
      0 30px 90px -46px rgba(103, 0, 255, 0.72);
  }

  .pc-top {
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.032);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pc-badge {
    width: fit-content;
    font-size: 12px;
    padding: 5px 12px;
  }

  .pc-copy h3 {
    margin: 0;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.05rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .pc-copy p {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
  }

  .pc-cta {
    width: 100%;
    justify-content: space-between;
  }

  .pc-list {
    list-style: none;
    margin: 0;
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pc-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.45;
    color: #D8D8DF;
  }

  .pc-tick {
    color: var(--violet-soft);
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .pc-tick svg {
    width: 15px;
    height: 15px;
  }

  .pc-more {
    margin-top: 32px;
  }

  @media (max-width: 980px) {
    .pc-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
