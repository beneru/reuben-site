---
/**
 * Large, silky-smooth, light organic shape-shifting gradient blob background.
 * Uses low-frequency 3-harmonic fluid curves with generous feathering on a low-res
 * GPU-upscaled canvas so the blob stays airy, butter-smooth, and constantly morphing
 * while gliding gently on scroll. Zero cursor tracking; pauses when tab is hidden;
 * renders one static frame under prefers-reduced-motion: reduce.
 */
---

<div class="ambient-bg" aria-hidden="true" data-ambient-bg>
  <canvas class="ambient-canvas" data-ambient-canvas></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ambient-canvas]');
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

    if (ctx) {
      const hasCtxFilter = 'filter' in ctx;
      if (!hasCtxFilter) canvas.classList.add('fallback-blur');

      let cw = 360;
      let ch = 225;
      let rafId = 0;
      let lastTs = 0;
      let elapsed = 0.8;

      const readScroll = () => {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        return Math.min(1, Math.max(0, window.scrollY / max));
      };

      let targetScroll = readScroll();
      let curScroll = targetScroll;

      const resize = () => {
        const vw = window.innerWidth || 1440;
        const vh = window.innerHeight || 900;
        const scale = Math.min(1, 360 / Math.max(vw, vh));
        cw = Math.max(160, Math.round(vw * scale));
        ch = Math.max(160, Math.round(vh * scale));
        canvas.width = cw;
        canvas.height = ch;
        targetScroll = readScroll();
      };

      interface BlobShape {
        cx: number;
        cy: number;
        radius: number;
        aspectX: number;
        aspectY: number;
        rot: number;
        phase: number;
        morphT: number;
        amps: [number, number, number];
        blurPx: number;
        gradAngle: number;
        stops: [number, string][];
      }

      const drawFluidBlob = (cfg: BlobShape) => {
        const points = 32;
        const pts: [number, number][] = new Array(points);
        const cosR = Math.cos(cfg.rot);
        const sinR = Math.sin(cfg.rot);
        const [a1, a2, a3] = cfg.amps;
        const t = cfg.morphT;
        const p = cfg.phase;

        for (let i = 0; i < points; i++) {
          const a = (i / points) * Math.PI * 2;
          // Pure low-frequency harmonics (k = 2, 3, 4) for ultra-smooth, ripple-free organic swells
          const deform =
            1 +
            a1 * Math.sin(2 * a + t * 0.68 + p) +
            a2 * Math.cos(3 * a - t * 0.49 + p * 1.37) +
            a3 * Math.sin(4 * a + t * 0.77 - p * 0.81);

          const rx = cfg.radius * deform * cfg.aspectX;
          const ry = cfg.radius * deform * cfg.aspectY;
          const lx = Math.cos(a) * rx;
          const ly = Math.sin(a) * ry;

          pts[i] = [
            cfg.cx + lx * cosR - ly * sinR,
            cfg.cy + lx * sinR + ly * cosR,
          ];
        }

        ctx.save();
        if (hasCtxFilter) {
          ctx.filter = `blur(${cfg.blurPx}px)`;
        }

        ctx.beginPath();
        const last = pts[points - 1];
        const first = pts[0];
        ctx.moveTo((last[0] + first[0]) * 0.5, (last[1] + first[1]) * 0.5);

        for (let i = 0; i < points; i++) {
          const curr = pts[i];
          const next = pts[(i + 1) % points];
          ctx.quadraticCurveTo(curr[0], curr[1], (curr[0] + next[0]) * 0.5, (curr[1] + next[1]) * 0.5);
        }
        ctx.closePath();

        const gLen = cfg.radius * Math.max(cfg.aspectX, cfg.aspectY) * 1.2;
        const gx = Math.cos(cfg.gradAngle) * gLen;
        const gy = Math.sin(cfg.gradAngle) * gLen;
        const grad = ctx.createLinearGradient(cfg.cx - gx, cfg.cy - gy, cfg.cx + gx, cfg.cy + gy);
        for (const [offset, color] of cfg.stops) {
          grad.addColorStop(offset, color);
        }

        ctx.fillStyle = grad;
        ctx.fill();
        ctx.restore();
      };

      const render = (t: number, s: number) => {
        ctx.clearRect(0, 0, cw, ch);

        const dark = darkQuery.matches;
        const portrait = ch > cw;
        const minDim = Math.min(cw, ch);

        const baseRadius = portrait ? minDim * 0.52 : minDim * 0.44;
        const baseAspectX = portrait ? 1.06 : 1.38;
        const baseAspectY = portrait ? 1.32 : 0.92;

        // Silky scroll sweep + slow continuous fluid motion
        const scrollSwing = Math.sin(s * Math.PI * 1.55);
        const scrollLift = Math.cos(s * Math.PI * 1.2);

        const cx = cw * (0.55 - scrollSwing * 0.18 + Math.sin(t * 0.24) * 0.04);
        const cy = ch * (0.51 - scrollLift * 0.08 + Math.cos(t * 0.2) * 0.04);

        const morphT = t + s * 4.4;
        const rot = t * 0.11 + s * 1.45;
        const aspectX = baseAspectX + Math.sin(t * 0.34) * 0.13;
        const aspectY = baseAspectY + Math.cos(t * 0.29) * 0.11;
        const amps: [number, number, number] = [0.22, 0.14, 0.075];

        // 1. Airy outer silk halo dissolving smoothly into the light canvas
        drawFluidBlob({
          cx,
          cy,
          radius: baseRadius * 1.16,
          aspectX,
          aspectY,
          rot,
          phase: 0.4,
          morphT,
          amps,
          blurPx: Math.max(18, Math.round(minDim * 0.135)),
          gradAngle: t * 0.18 + s * 1.9,
          stops: dark
            ? [
                [0, 'rgba(124, 54, 255, 0.22)'],
                [0.5, 'rgba(78, 128, 255, 0.17)'],
                [1, 'rgba(202, 102, 255, 0.16)'],
              ]
            : [
                [0, 'rgba(148, 96, 255, 0.11)'],
                [0.5, 'rgba(130, 174, 255, 0.10)'],
                [1, 'rgba(232, 158, 255, 0.10)'],
              ],
        });

        // 2. Main giant silky liquid blob (light pastel luminescence, extra-feathered edge)
        drawFluidBlob({
          cx,
          cy,
          radius: baseRadius,
          aspectX,
          aspectY,
          rot,
          phase: 0.4,
          morphT,
          amps,
          blurPx: Math.max(14, Math.round(minDim * 0.09)),
          gradAngle: t * 0.22 + s * 2.2,
          stops: dark
            ? [
                [0, 'rgba(132, 60, 255, 0.29)'],
                [0.35, 'rgba(84, 134, 255, 0.24)'],
                [0.7, 'rgba(164, 92, 255, 0.23)'],
                [1, 'rgba(218, 108, 255, 0.21)'],
              ]
            : [
                [0, 'rgba(136, 78, 255, 0.155)'],
                [0.35, 'rgba(116, 168, 255, 0.14)'],
                [0.7, 'rgba(182, 132, 255, 0.135)'],
                [1, 'rgba(238, 164, 255, 0.135)'],
              ],
        });

        // 3. Soft internal flowing highlight lobe swirling inside the giant blob
        drawFluidBlob({
          cx: cx + Math.cos(t * 0.36 + s * 2.6) * baseRadius * 0.22,
          cy: cy + Math.sin(t * 0.31 - s * 2.0) * baseRadius * 0.18,
          radius: baseRadius * 0.68,
          aspectX: baseAspectX * 0.96 + Math.cos(t * 0.39) * 0.12,
          aspectY: baseAspectY * 1.04 + Math.sin(t * 0.35) * 0.12,
          rot: -rot * 0.8,
          phase: 2.3,
          morphT: morphT * 1.12 + 1.8,
          amps: [0.2, 0.13, 0.065],
          blurPx: Math.max(16, Math.round(minDim * 0.11)),
          gradAngle: -t * 0.25 - s * 1.8,
          stops: dark
            ? [
                [0, 'rgba(222, 118, 255, 0.22)'],
                [0.55, 'rgba(118, 158, 255, 0.18)'],
                [1, 'rgba(124, 68, 255, 0.14)'],
              ]
            : [
                [0, 'rgba(244, 178, 255, 0.14)'],
                [0.55, 'rgba(150, 198, 255, 0.125)'],
                [1, 'rgba(176, 134, 255, 0.095)'],
              ],
        });
      };

      const stop = () => {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
        lastTs = 0;
      };

      const loop = (ts: number) => {
        if (document.hidden || reduceMotionQuery.matches) {
          stop();
          return;
        }
        if (lastTs) {
          const dt = Math.min(0.05, (ts - lastTs) / 1000);
          elapsed += dt * 0.62;
        }
        lastTs = ts;
        curScroll += (targetScroll - curScroll) * 0.055;
        render(elapsed, curScroll);
        rafId = requestAnimationFrame(loop);
      };

      const start = () => {
        if (reduceMotionQuery.matches) {
          stop();
          render(0.8, readScroll());
          return;
        }
        if (!rafId && !document.hidden) {
          lastTs = 0;
          rafId = requestAnimationFrame(loop);
        }
      };

      resize();
      render(elapsed, curScroll);
      start();

      window.addEventListener(
        'scroll',
        () => {
          targetScroll = readScroll();
          if (reduceMotionQuery.matches) {
            curScroll = targetScroll;
            render(0.8, curScroll);
          }
        },
        { passive: true },
      );

      window.addEventListener(
        'resize',
        () => {
          resize();
          render(elapsed, curScroll);
        },
        { passive: true },
      );

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      reduceMotionQuery.addEventListener('change', () => start());
      darkQuery.addEventListener('change', () => render(elapsed, curScroll));
    }
  }
</script>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }

  .ambient-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ambient-canvas.fallback-blur {
    filter: blur(56px);
    transform: scale(1.1);
  }
</style>
