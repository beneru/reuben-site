---
/**
 * Scroll-animated light gradient background.
 * Pre-feathered multi-stop radial gradients (zero runtime CSS filter blur cost)
 * swept across opposing paths by native CSS scroll(root block) timelines,
 * with a converging rAF fallback only for browsers without scroll-driven animations.
 */
---

<div class="ambient-bg" aria-hidden="true" data-ambient-bg>
  <div class="ambient-wash"></div>
  <div class="ambient-layer ambient-layer-1" data-scroll-orb="1">
    <div class="orb orb-1"></div>
  </div>
  <div class="ambient-layer ambient-layer-2" data-scroll-orb="2">
    <div class="orb orb-2"></div>
  </div>
  <div class="ambient-layer ambient-layer-3" data-scroll-orb="3">
    <div class="orb orb-3"></div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-ambient-bg]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nativeScrollTimeline =
    typeof CSS !== 'undefined' && CSS.supports && CSS.supports('animation-timeline: scroll()');

  if (root && !reduceMotion && !nativeScrollTimeline) {
    type Stop = { p: number; x: number; y: number; s: number };
    const paths: Record<string, Stop[]> = {
      '1': [
        { p: 0, x: 0, y: 0, s: 1 },
        { p: 0.35, x: -24, y: 22, s: 1.16 },
        { p: 0.7, x: -42, y: 32, s: 0.96 },
        { p: 1, x: -10, y: 12, s: 1.12 },
      ],
      '2': [
        { p: 0, x: 0, y: 0, s: 1 },
        { p: 0.35, x: 28, y: -16, s: 1.14 },
        { p: 0.7, x: 44, y: 14, s: 1.04 },
        { p: 1, x: 12, y: 24, s: 1.16 },
      ],
      '3': [
        { p: 0, x: 0, y: 0, s: 1 },
        { p: 0.35, x: -22, y: -28, s: 1.16 },
        { p: 0.7, x: 18, y: -42, s: 1.06 },
        { p: 1, x: -4, y: -14, s: 1.2 },
      ],
    };

    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-scroll-orb]')).map((el) => ({
      el,
      stops: paths[el.dataset.scrollOrb || '1'],
    }));

    const sample = (stops: Stop[], p: number) => {
      for (let i = 0; i < stops.length - 1; i++) {
        const a = stops[i];
        const b = stops[i + 1];
        if (p <= b.p) {
          const t = (p - a.p) / Math.max(0.0001, b.p - a.p);
          return {
            x: a.x + (b.x - a.x) * t,
            y: a.y + (b.y - a.y) * t,
            s: a.s + (b.s - a.s) * t,
          };
        }
      }
      const last = stops[stops.length - 1];
      return { x: last.x, y: last.y, s: last.s };
    };

    const readProgress = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      return Math.min(1, Math.max(0, window.scrollY / max));
    };

    let target = readProgress();
    let current = target;
    let rafId = 0;

    const apply = (p: number) => {
      for (const layer of layers) {
        const v = sample(layer.stops, p);
        layer.el.style.transform = `translate3d(${v.x.toFixed(2)}vw, ${v.y.toFixed(2)}vh, 0) scale(${v.s.toFixed(3)})`;
      }
    };

    const tick = () => {
      current += (target - current) * 0.12;
      if (Math.abs(target - current) < 0.0004) {
        current = target;
        apply(current);
        rafId = 0;
        return;
      }
      apply(current);
      rafId = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      target = readProgress();
      if (!rafId && !document.hidden) rafId = requestAnimationFrame(tick);
    };

    apply(current);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    --orb-1-a: rgba(103, 0, 255, 0.27);
    --orb-1-b: rgba(128, 74, 255, 0.14);
    --orb-1-c: rgba(173, 146, 255, 0.05);
    --orb-2-a: rgba(74, 134, 255, 0.24);
    --orb-2-b: rgba(126, 180, 255, 0.13);
    --orb-2-c: rgba(176, 212, 255, 0.045);
    --orb-3-a: rgba(196, 98, 255, 0.21);
    --orb-3-b: rgba(232, 152, 255, 0.11);
    --orb-3-c: rgba(246, 204, 255, 0.045);
    --wash: linear-gradient(155deg, rgba(255, 255, 255, 0.65) 0%, rgba(246, 242, 255, 0.35) 52%, rgba(238, 245, 255, 0.5) 100%);
  }

  @media (prefers-color-scheme: dark) {
    .ambient-bg {
      --orb-1-a: rgba(122, 40, 255, 0.38);
      --orb-1-b: rgba(96, 28, 232, 0.19);
      --orb-1-c: rgba(74, 22, 186, 0.06);
      --orb-2-a: rgba(64, 118, 255, 0.29);
      --orb-2-b: rgba(76, 132, 255, 0.14);
      --orb-2-c: rgba(90, 148, 255, 0.045);
      --orb-3-a: rgba(186, 80, 255, 0.25);
      --orb-3-b: rgba(140, 56, 230, 0.12);
      --orb-3-c: rgba(112, 42, 196, 0.045);
      --wash: linear-gradient(155deg, rgba(16, 11, 28, 0.55) 0%, rgba(11, 8, 18, 0.2) 55%, rgba(18, 12, 34, 0.45) 100%);
    }
  }

  .ambient-wash {
    position: absolute;
    inset: 0;
    background: var(--wash);
  }

  .ambient-layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .orb-1 {
    width: min(84vw, 1020px);
    height: min(84vw, 1020px);
    top: -22vh;
    right: -12vw;
    background: radial-gradient(circle, var(--orb-1-a) 0%, var(--orb-1-b) 30%, var(--orb-1-c) 56%, transparent 72%);
  }

  .orb-2 {
    width: min(78vw, 940px);
    height: min(78vw, 940px);
    top: 22vh;
    left: -16vw;
    background: radial-gradient(circle, var(--orb-2-a) 0%, var(--orb-2-b) 30%, var(--orb-2-c) 56%, transparent 72%);
  }

  .orb-3 {
    width: min(74vw, 880px);
    height: min(74vw, 880px);
    bottom: -24vh;
    left: 24vw;
    background: radial-gradient(circle, var(--orb-3-a) 0%, var(--orb-3-b) 32%, var(--orb-3-c) 56%, transparent 72%);
  }

  /* Gentle idle breathing on inner orbs */
  @media (prefers-reduced-motion: no-preference) {
    .orb-1 {
      animation: orbDrift1 22s ease-in-out infinite alternate;
    }
    .orb-2 {
      animation: orbDrift2 26s ease-in-out infinite alternate;
    }
    .orb-3 {
      animation: orbDrift3 24s ease-in-out infinite alternate;
    }
  }

  /* Scroll-driven gradient choreography on outer layers (native compositor timeline) */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ambient-layer-1 {
        animation: orbScroll1 1ms linear both;
      }
      .ambient-layer-2 {
        animation: orbScroll2 1ms linear both;
      }
      .ambient-layer-3 {
        animation: orbScroll3 1ms linear both;
      }

      /* Separate rule prevents LightningCSS from merging animation-timeline into invalid animation shorthand */
      .ambient-bg > .ambient-layer {
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes orbScroll1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    35% { transform: translate3d(-24vw, 22vh, 0) scale(1.16); }
    70% { transform: translate3d(-42vw, 32vh, 0) scale(0.96); }
    100% { transform: translate3d(-10vw, 12vh, 0) scale(1.12); }
  }

  @keyframes orbScroll2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    35% { transform: translate3d(28vw, -16vh, 0) scale(1.14); }
    70% { transform: translate3d(44vw, 14vh, 0) scale(1.04); }
    100% { transform: translate3d(12vw, 24vh, 0) scale(1.16); }
  }

  @keyframes orbScroll3 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    35% { transform: translate3d(-22vw, -28vh, 0) scale(1.16); }
    70% { transform: translate3d(18vw, -42vh, 0) scale(1.06); }
    100% { transform: translate3d(-4vw, -14vh, 0) scale(1.2); }
  }

  @keyframes orbDrift1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-4vw, 5vh, 0) scale(1.06); }
    100% { transform: translate3d(3vw, 8vh, 0) scale(0.97); }
  }

  @keyframes orbDrift2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(5vw, -4vh, 0) scale(1.05); }
    100% { transform: translate3d(2vw, 5vh, 0) scale(0.97); }
  }

  @keyframes orbDrift3 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-4vw, -6vh, 0) scale(1.07); }
    100% { transform: translate3d(5vw, -2vh, 0) scale(0.96); }
  }

  @media (max-width: 768px) {
    .orb-1 {
      width: 118vw;
      height: 118vw;
      top: -18vh;
      right: -30vw;
    }
    .orb-2 {
      width: 112vw;
      height: 112vw;
      top: 28vh;
      left: -34vw;
    }
    .orb-3 {
      width: 108vw;
      height: 108vw;
      bottom: -20vh;
      left: 5vw;
    }
  }
</style>
