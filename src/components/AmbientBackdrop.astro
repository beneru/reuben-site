---
/**
 * Giant organic shape-shifting gradient blob background.
 * Renders a single large multi-layered fluid Fourier blob onto a low-resolution
 * GPU-upscaled canvas (~1/4 viewport scale) so its silhouette smoothly and constantly
 * morphs at 60/120fps with minimal fill-rate cost, while gliding and warping on scroll.
 * Zero cursor tracking; pauses when tab is hidden; static single-frame under reduced motion.
 */
---

<div class="ambient-bg" aria-hidden="true" data-ambient-bg>
  <canvas class="ambient-canvas" data-ambient-canvas></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ambient-canvas]');
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

    if (ctx) {
      const hasCtxFilter = 'filter' in ctx;
      if (!hasCtxFilter) canvas.classList.add('fallback-blur');

      let cw = 360;
      let ch = 225;
      let rafId = 0;
      let lastTs = 0;
      let elapsed = 0.8;

      const readScroll = () => {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        return Math.min(1, Math.max(0, window.scrollY / max));
      };

      let targetScroll = readScroll();
      let curScroll = targetScroll;

      const resize = () => {
        const vw = window.innerWidth || 1440;
        const vh = window.innerHeight || 900;
        const scale = Math.min(1, 360 / Math.max(vw, vh));
        cw = Math.max(160, Math.round(vw * scale));
        ch = Math.max(160, Math.round(vh * scale));
        canvas.width = cw;
        canvas.height = ch;
        targetScroll = readScroll();
      };

      interface BlobShape {
        cx: number;
        cy: number;
        radius: number;
        aspectX: number;
        aspectY: number;
        rot: number;
        phase: number;
        morphT: number;
        amps: [number, number, number, number, number];
        blurPx: number;
        gradAngle: number;
        stops: [number, string][];
      }

      const drawFluidBlob = (cfg: BlobShape) => {
        const points = 32;
        const pts: [number, number][] = new Array(points);
        const cosR = Math.cos(cfg.rot);
        const sinR = Math.sin(cfg.rot);
        const [a1, a2, a3, a4, a5] = cfg.amps;
        const t = cfg.morphT;
        const p = cfg.phase;

        for (let i = 0; i < points; i++) {
          const a = (i / points) * Math.PI * 2;
          const deform =
            1 +
            a1 * Math.sin(2 * a + t * 0.83 + p) +
            a2 * Math.cos(3 * a - t * 0.61 + p * 1.41) +
            a3 * Math.sin(4 * a + t * 0.97 - p * 0.77) +
            a4 * Math.cos(5 * a - t * 0.49 + p * 2.17) +
            a5 * Math.sin(6 * a + t * 0.71 + p * 0.53);

          const rx = cfg.radius * deform * cfg.aspectX;
          const ry = cfg.radius * deform * cfg.aspectY;
          const lx = Math.cos(a) * rx;
          const ly = Math.sin(a) * ry;

          pts[i] = [
            cfg.cx + lx * cosR - ly * sinR,
            cfg.cy + lx * sinR + ly * cosR,
          ];
        }

        ctx.save();
        if (hasCtxFilter) {
          ctx.filter = `blur(${cfg.blurPx}px)`;
        }

        ctx.beginPath();
        const last = pts[points - 1];
        const first = pts[0];
        ctx.moveTo((last[0] + first[0]) * 0.5, (last[1] + first[1]) * 0.5);

        for (let i = 0; i < points; i++) {
          const curr = pts[i];
          const next = pts[(i + 1) % points];
          ctx.quadraticCurveTo(curr[0], curr[1], (curr[0] + next[0]) * 0.5, (curr[1] + next[1]) * 0.5);
        }
        ctx.closePath();

        const gLen = cfg.radius * Math.max(cfg.aspectX, cfg.aspectY) * 1.15;
        const gx = Math.cos(cfg.gradAngle) * gLen;
        const gy = Math.sin(cfg.gradAngle) * gLen;
        const grad = ctx.createLinearGradient(cfg.cx - gx, cfg.cy - gy, cfg.cx + gx, cfg.cy + gy);
        for (const [offset, color] of cfg.stops) {
          grad.addColorStop(offset, color);
        }

        ctx.fillStyle = grad;
        ctx.fill();
        ctx.restore();
      };

      const render = (t: number, s: number) => {
        ctx.clearRect(0, 0, cw, ch);

        const dark = darkQuery.matches;
        const portrait = ch > cw;
        const minDim = Math.min(cw, ch);

        // Big organic blob sized cleanly to viewport with visible curving silhouette edges
        const baseRadius = portrait ? minDim * 0.52 : minDim * 0.44;
        const baseAspectX = portrait ? 1.06 : 1.36;
        const baseAspectY = portrait ? 1.32 : 0.92;

        // Smooth scroll-driven grand S-sweep + gentle autonomous float
        const scrollSwing = Math.sin(s * Math.PI * 1.65);
        const scrollLift = Math.cos(s * Math.PI * 1.25);

        const cx = cw * (0.56 - scrollSwing * 0.19 + Math.sin(t * 0.27) * 0.045);
        const cy = ch * (0.52 - scrollLift * 0.08 + Math.cos(t * 0.22) * 0.045);

        const morphT = t + s * 5.2;
        const rot = t * 0.14 + s * 1.65;
        const aspectX = baseAspectX + Math.sin(t * 0.41) * 0.14;
        const aspectY = baseAspectY + Math.cos(t * 0.35) * 0.12;
        const amps: [number, number, number, number, number] = [0.24, 0.17, 0.1, 0.055, 0.025];

        // 1. Soft atmospheric bloom halo matching the exact morphing blob shape
        drawFluidBlob({
          cx,
          cy,
          radius: baseRadius * 1.1,
          aspectX,
          aspectY,
          rot,
          phase: 0.4,
          morphT,
          amps,
          blurPx: Math.max(12, Math.round(minDim * 0.095)),
          gradAngle: t * 0.22 + s * 2.2,
          stops: dark
            ? [
                [0, 'rgba(116, 36, 255, 0.32)'],
                [0.5, 'rgba(68, 122, 255, 0.24)'],
                [1, 'rgba(196, 82, 255, 0.22)'],
              ]
            : [
                [0, 'rgba(103, 0, 255, 0.18)'],
                [0.5, 'rgba(78, 138, 255, 0.16)'],
                [1, 'rgba(216, 112, 255, 0.16)'],
              ],
        });

        // 2. Main giant sculptural liquid gradient blob (clearly readable organic silhouette)
        drawFluidBlob({
          cx,
          cy,
          radius: baseRadius,
          aspectX,
          aspectY,
          rot,
          phase: 0.4,
          morphT,
          amps,
          blurPx: Math.max(7, Math.round(minDim * 0.046)),
          gradAngle: t * 0.28 + s * 2.6,
          stops: dark
            ? [
                [0, 'rgba(128, 44, 255, 0.46)'],
                [0.36, 'rgba(72, 124, 255, 0.38)'],
                [0.72, 'rgba(154, 72, 255, 0.36)'],
                [1, 'rgba(214, 88, 255, 0.32)'],
              ]
            : [
                [0, 'rgba(103, 0, 255, 0.30)'],
                [0.36, 'rgba(76, 138, 255, 0.26)'],
                [0.72, 'rgba(156, 98, 255, 0.24)'],
                [1, 'rgba(224, 118, 255, 0.24)'],
              ],
        });

        // 3. Swirling inner liquid core shifting color depth inside the giant blob
        drawFluidBlob({
          cx: cx + Math.cos(t * 0.48 + s * 3.1) * baseRadius * 0.2,
          cy: cy + Math.sin(t * 0.42 - s * 2.4) * baseRadius * 0.18,
          radius: baseRadius * 0.64,
          aspectX: baseAspectX * 0.96 + Math.cos(t * 0.51) * 0.14,
          aspectY: baseAspectY * 1.04 + Math.sin(t * 0.45) * 0.14,
          rot: -rot * 0.85,
          phase: 2.3,
          morphT: morphT * 1.18 + 1.9,
          amps: [0.22, 0.16, 0.09, 0.05, 0.02],
          blurPx: Math.max(9, Math.round(minDim * 0.062)),
          gradAngle: -t * 0.32 - s * 2.1,
          stops: dark
            ? [
                [0, 'rgba(218, 96, 255, 0.34)'],
                [0.55, 'rgba(108, 146, 255, 0.28)'],
                [1, 'rgba(103, 0, 255, 0.22)'],
              ]
            : [
                [0, 'rgba(232, 126, 255, 0.26)'],
                [0.55, 'rgba(98, 162, 255, 0.22)'],
                [1, 'rgba(126, 72, 255, 0.18)'],
              ],
        });
      };

      const stop = () => {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
        lastTs = 0;
      };

      const loop = (ts: number) => {
        if (document.hidden || reduceMotionQuery.matches) {
          stop();
          return;
        }
        if (lastTs) {
          const dt = Math.min(0.05, (ts - lastTs) / 1000);
          elapsed += dt * 1.15;
        }
        lastTs = ts;
        curScroll += (targetScroll - curScroll) * 0.085;
        render(elapsed, curScroll);
        rafId = requestAnimationFrame(loop);
      };

      const start = () => {
        if (reduceMotionQuery.matches) {
          stop();
          render(0.8, readScroll());
          return;
        }
        if (!rafId && !document.hidden) {
          lastTs = 0;
          rafId = requestAnimationFrame(loop);
        }
      };

      resize();
      render(elapsed, curScroll);
      start();

      window.addEventListener(
        'scroll',
        () => {
          targetScroll = readScroll();
          if (reduceMotionQuery.matches) {
            curScroll = targetScroll;
            render(0.8, curScroll);
          }
        },
        { passive: true },
      );

      window.addEventListener(
        'resize',
        () => {
          resize();
          render(elapsed, curScroll);
        },
        { passive: true },
      );

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      reduceMotionQuery.addEventListener('change', () => start());
      darkQuery.addEventListener('change', () => render(elapsed, curScroll));
    }
  }
</script>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }

  .ambient-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ambient-canvas.fallback-blur {
    filter: blur(40px);
    transform: scale(1.08);
  }
</style>
