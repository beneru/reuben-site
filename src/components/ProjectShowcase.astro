---
interface Project {
  title: string;
  tagline: string;
  description: string;
  category: string;
  metrics: string;
  tags: string[];
  status: string;
  href?: string;
}

const projects: Project[] = [
  {
    title: "Spawntel",
    tagline: "Autonomous multi-agent enterprise operating system",
    description: "A resilient multi-agent architecture built to orchestrate complex workflows, manage background tasks, and scale autonomous execution across business operations.",
    category: "AI Infrastructure",
    metrics: "Multi-agent coordination",
    tags: ["TypeScript", "Python", "Autonomous Agents", "Enterprise OS"],
    status: "Flagship",
    href: "#"
  },
  {
    title: "Clicky",
    tagline: "macOS desktop AI voice companion",
    description: "A native macOS menu bar application providing instant, low latency voice interactions with advanced language models directly from the desktop environment.",
    category: "Desktop Client",
    metrics: "Sub-second voice response",
    tags: ["Swift", "macOS", "WebSockets", "Audio API"],
    status: "Active",
    href: "#"
  },
  {
    title: "FlowState",
    tagline: "Single-task focus queue",
    description: "An intentional productivity interface designed to eliminate context switching by enforcing strict single task focus and structured execution states.",
    category: "Productivity",
    metrics: "Zero distraction workflow",
    tags: ["React", "Tailwind CSS", "State Machine", "UX Design"],
    status: "Live",
    href: "#"
  }
];
---

<section class="relative py-24 px-6 bg-[#0a0a0a] text-[#e8e8e8] overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono tracking-widest text-indigo-400 uppercase mb-3 block">Selected Works</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">Flagship Builds</h2>
      </div>
      <p class="text-sm text-neutral-400 max-w-md">
        Systems engineered for performance, precision, and autonomous execution. Built with modern architecture and uncompromising standards.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="group relative bg-[#111111] border border-white/[0.08] rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 hover:border-white/[0.2] hover:bg-[#161616]">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1 text-xs font-mono rounded-full bg-white/[0.05] text-neutral-300 border border-white/[0.08]">
                {project.category}
              </span>
              <span class="text-xs font-mono text-indigo-400 font-medium">
                {project.status}
              </span>
            </div>

            <h3 class="text-2xl font-semibold text-white tracking-tight mb-2 group-hover:text-indigo-300 transition-colors">
              {project.title}
            </h3>
            
            <p class="text-sm font-medium text-neutral-300 mb-4">
              {project.tagline}
            </p>

            <p class="text-sm text-neutral-400 leading-relaxed mb-6">
              {project.description}
            </p>
          </div>

          <div>
            <div class="pt-4 border-t border-white/[0.06] mb-6 flex items-center justify-between">
              <span class="text-xs text-neutral-400 font-mono">Metric</span>
              <span class="text-xs text-white font-mono">{project.metrics}</span>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
              {project.tags.map((tag) => (
                <span class="text-[11px] font-mono px-2 py-1 rounded bg-white/[0.03] text-neutral-400 border border-white/[0.05]">
                  {tag}
                </span>
              ))}
            </div>

            {project.href && (
              <a 
                href={project.href} 
                class="inline-flex items-center text-xs font-mono font-medium text-white group-hover:text-indigo-400 transition-colors"
              >
                <span>Explore system</span>
                <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>