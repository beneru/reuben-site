---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { PROOF_CLOUD_COPY } from '../data/site';
---

<section class="pf" id="proof" aria-labelledby="pf-title" data-reveal>
  <div class="pf-float" aria-hidden="true">
    <!-- Left upper: Reuben studio portrait -->
    <div class="pf-tile pf-tile--face" data-phone="true" style="--x: 6%; --y: 6%; --mx: 4%; --my: 38px; --size: 96; --rot: -6deg; --n: 0;">
      <div class="pf-tile__card">
        <img src="/images/founder/reuben-studio.webp" alt="" width="96" height="96" loading="lazy" />
      </div>
      <span class="pf-tile__cap">Reuben Magallanes, Marketing Head</span>
    </div>

    <!-- Top left-center: Meta badge -->
    <div class="pf-tile pf-tile--logo" data-phone="true" style="--x: 24%; --y: 1%; --mx: 27%; --my: 8px; --size: 56; --rot: 7deg; --n: 1;">
      <div class="pf-tile__card">
        <svg viewBox="0 0 24 24" fill="none" stroke="#B79BFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8Z" />
        </svg>
      </div>
    </div>

    <!-- Far left mid dim: Cloudflare cloud -->
    <div class="pf-tile pf-tile--logo" data-dim="true" style="--x: 2%; --y: 54%; --size: 58; --rot: 5deg; --n: 2;">
      <div class="pf-tile__card">
        <svg viewBox="0 0 24 24" fill="none" stroke="#A1A1AA" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
        </svg>
      </div>
    </div>

    <!-- Bottom left: Spawntel emblem -->
    <div class="pf-tile pf-tile--seal" data-phone="true" style="--x: 15%; --y: 55%; --mx: 54%; --my: 10px; --size: 80; --rot: -5deg; --n: 3;">
      <div class="pf-tile__card">
        <img src="/images/brand/spawntel-emblem.webp" alt="" width="80" height="80" loading="lazy" />
      </div>
      <span class="pf-tile__cap">Built together at Spawntel</span>
    </div>

    <!-- Top right: Gemini / AI sparkle -->
    <div class="pf-tile pf-tile--logo" style="--x: 73%; --y: 3%; --size: 60; --rot: -7deg; --n: 4;">
      <div class="pf-tile__card">
        <svg viewBox="0 0 24 24" fill="#B79BFF">
          <path d="M12 2c.7 5.2 4.8 9.3 10 10-5.2.7-9.3 4.8-10 10-.7-5.2-4.8-9.3-10-10 5.2-.7 9.3-4.8 10-10Z" />
        </svg>
      </div>
      <span class="pf-tile__cap">83 E2E checks across Meta DM workers</span>
    </div>

    <!-- Far right upper: Code / Workers -->
    <div class="pf-tile pf-tile--logo" data-dim="true" style="--x: 91%; --y: 22%; --size: 52; --rot: 9deg; --n: 5;">
      <div class="pf-tile__card">
        <svg viewBox="0 0 24 24" fill="none" stroke="#9B87F5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6" />
          <polyline points="8 6 2 12 8 18" />
        </svg>
      </div>
    </div>

    <!-- Right mid: Reuben outdoor photo -->
    <div class="pf-tile pf-tile--face" data-phone="true" style="--x: 82%; --y: 44%; --mx: 78%; --my: 40px; --size: 88; --rot: 5deg; --n: 6;">
      <div class="pf-tile__card">
        <img src="/images/founder/reuben-outdoor.webp" alt="" width="88" height="88" loading="lazy" />
      </div>
      <span class="pf-tile__cap">5-channel cascades from one brief</span>
    </div>

    <!-- Bottom right: Shield / Guardrails -->
    <div class="pf-tile pf-tile--logo" style="--x: 68%; --y: 60%; --size: 64; --rot: 6deg; --n: 7;">
      <div class="pf-tile__card">
        <svg viewBox="0 0 24 24" fill="none" stroke="#C9B3FF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </div>
      <span class="pf-tile__cap">Human takeover built into every bot</span>
    </div>
  </div>

  <div class="pf-core">
    <h2 class="pf-title" id="pf-title">
      <span class="pf-num">{PROOF_CLOUD_COPY.statNumber}</span>
      <span class="pf-title__line">{PROOF_CLOUD_COPY.statLine}</span>
    </h2>
    <p class="pf-sub">{PROOF_CLOUD_COPY.subline}</p>

    <ul class="pf-facts">
      {PROOF_CLOUD_COPY.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <div class="pf-cta">
      <a
        href={spawntelFunnelUrl('proof-cloud')}
        class="cta-btn"
        data-spawntel-cta="proof-cloud"
      >
        <span>{PROOF_CLOUD_COPY.ctaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .pf {
    position: relative;
    width: var(--site-w);
    margin-inline: auto;
    isolation: isolate;
    padding-top: clamp(64px, 8vw, 118px);
    padding-bottom: clamp(82px, 10vw, 138px);
    min-height: clamp(480px, 46vw, 620px);
    display: grid;
    place-items: center;
  }

  .pf::before {
    content: '';
    position: absolute;
    inset: 10% 18% 0;
    z-index: -1;
    pointer-events: none;
    filter: blur(24px);
    background: radial-gradient(50% 50% at 50% 55%, rgba(103, 0, 255, 0.22), transparent 72%);
  }

  .pf-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pf-tile {
    --k: 1;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--size) * var(--k) * 1px);
    transform: rotate(var(--rot));
    z-index: 1;
  }

  .pf-tile[data-dim='true'] {
    opacity: 0.55;
  }

  .pf-tile__card {
    aspect-ratio: 1;
    border-radius: 24%;
    padding: 3px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #2B2440, rgba(28, 25, 44, 0.88));
    box-shadow:
      inset 1px 1px 1.5px rgba(255, 255, 255, 0.22),
      -18px 22px 30px rgba(8, 0, 36, 0.55),
      inset 0 -1.5px 1px rgba(3, 0, 38, 0.5);
    animation: pf-drift calc(6.5s + var(--n) * 0.6s) ease-in-out calc(var(--n) * -1.1s) infinite alternate;
  }

  .pf-tile--face .pf-tile__card img,
  .pf-tile--seal .pf-tile__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 21%;
  }

  .pf-tile--logo .pf-tile__card svg {
    width: 50%;
    height: 50%;
  }

  .pf-tile__cap {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 220px;
    padding: 8px 12px;
    border-radius: 12px;
    background: rgba(24, 22, 34, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #C7C5D3;
    font-size: 12.5px;
    line-height: 1.35;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.45);
  }

  @keyframes pf-drift {
    0% { transform: translateY(0); }
    100% { transform: translateY(-9px); }
  }

  .pf-core {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 520px;
    padding-inline: 12px;
  }

  .pf-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pf-num {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 2rem + 4vw, 5.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    padding-bottom: 0.06em;
    background-image: var(--grad-heading);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .pf-title__line {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.65rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 24ch;
  }

  .pf-sub {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--ink-muted);
    max-width: 44ch;
    line-height: 1.5;
  }

  .pf-facts {
    display: none;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    gap: 8px;
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .pf-cta {
    margin-top: 26px;
  }

  @media (max-width: 1120px) {
    .pf-tile {
      --k: 0.82;
    }
    .pf-tile__cap {
      max-width: 175px;
      font-size: 11.5px;
    }
  }

  @media (max-width: 860px) {
    .pf {
      min-height: auto;
      padding-top: 148px;
      padding-bottom: 56px;
    }

    .pf-tile:not([data-phone='true']) {
      display: none;
    }

    .pf-tile[data-phone='true'] {
      --k: 0.68;
      left: var(--mx);
      top: var(--my);
    }

    .pf-tile__cap {
      display: none;
    }

    .pf-facts {
      display: grid;
    }

    .pf-facts li {
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
    }
  }
</style>
