---
import { spawntelFunnelUrl } from '../../shared/funnel';
import { PROOF_NUMBERS_COPY } from '../data/site';
---

<section class="pn" id="proof" aria-labelledby="pn-title">
  <div class="site-wrap pn-wrap">
    <h2 class="pn-title" id="pn-title" data-reveal>{PROOF_NUMBERS_COPY.heading}</h2>

    <ul class="pn-stats">
      {PROOF_NUMBERS_COPY.stats.map((stat, idx) => (
        <li class="pn-stat" data-reveal style={`--i: ${idx}`}>
          <span class="pn-stat__value">{stat.value}</span>
          <div class="pn-stat__body">
            <p class="pn-stat__label">{stat.label}</p>
            <a class="pn-stat__src" href={stat.href}>
              <span class="sr-only">Source: </span>{stat.sourceLabel}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div class="pn-cta" data-reveal>
      <a href={spawntelFunnelUrl('proof-cloud')} class="cta-btn" data-spawntel-cta="proof-cloud">
        <span>{PROOF_NUMBERS_COPY.ctaLabel}</span>
        <span class="cta-btn__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .pn {
    position: relative;
    isolation: isolate;
    padding-block: clamp(72px, 9vw, 132px);
  }

  .pn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(42% 60% at 50% 44%, rgba(103, 0, 255, 0.06), transparent 72%);
  }

  .pn-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pn-title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.3rem, 1.4rem + 3.4vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  /* Bare numbers, each with a receipt */
  .pn-stats {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    width: 100%;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pn-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 8px clamp(16px, 2.6vw, 40px);
  }

  .pn-stat + .pn-stat {
  }

  .pn-stat__value {
    font-family: var(--font-heading);
    font-size: clamp(3.4rem, 2.2rem + 4.4vw, 6.2rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pn-stat__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pn-stat__label {
    margin: 0;
    max-width: 26ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .pn-stat__src {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--violet-soft);
    text-decoration: underline;
    text-decoration-color: rgba(183, 155, 255, 0.35);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .pn-stat__src:hover {
    color: #FFFFFF;
    text-decoration-color: currentColor;
  }

  .pn-cta {
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (max-width: 760px) {
    .pn-stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .pn-stat {
      flex-direction: row;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 0;
      text-align: left;
    }

    .pn-stat + .pn-stat {
    }

    .pn-stat__value {
      flex: 0 0 1.45em;
      font-size: 3rem;
    }

    .pn-stat__body {
      align-items: flex-start;
      padding-top: 6px;
    }
  }
</style>
