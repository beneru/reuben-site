---
import { PROCESS_SECTION_COPY, PROCESS_STEPS } from '../data/site';
---

<section class="section-block" id="process" aria-labelledby="hw-title">
  <div class="site-wrap">
    <div class="section-head" data-reveal>
      <span class="pill-tag">{PROCESS_SECTION_COPY.pill}</span>
      <h2 class="grad-title" id="hw-title">{PROCESS_SECTION_COPY.heading}</h2>
    </div>

    <ol class="hw">
      {PROCESS_STEPS.map((item, idx) => (
        <li class="hw-step" data-reveal style={`--i: ${idx}`}>
          <span class="hw-num" aria-hidden="true">{item.step}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3.2vw, 52px);
  }

  .hw-num {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3.75rem, 2.5rem + 4vw, 6.75rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.055em;
    background-image: var(--grad-num);
    background-size: var(--blob-bg-size);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: text-blob-drift 16s ease-in-out infinite alternate;
  }

  .hw-step:nth-child(2) .hw-num { animation-delay: -3.5s; }
  .hw-step:nth-child(3) .hw-num { animation-delay: -7.1s; }
  .hw-step:nth-child(4) .hw-num { animation-delay: -11.4s; }

  .hw-step h3 {
    margin: 22px 0 0;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hw-step p {
    margin: 10px 0 0;
    max-width: 29ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .hw {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media (max-width: 540px) {
    .hw {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
