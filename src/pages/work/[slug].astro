---
import DocLayout from '../../layouts/DocLayout.astro';
import { WORK_BUILDS, type WorkBuild } from '../../data/work';

export function getStaticPaths() {
  return WORK_BUILDS.map((build) => ({
    params: { slug: build.slug },
    props: { build },
  }));
}

interface Props {
  build: WorkBuild;
}

const { build } = Astro.props;
const otherBuilds = WORK_BUILDS.filter((b) => b.slug !== build.slug);
---

<DocLayout
  title={build.seoTitle}
  description={build.seoDescription}
  eyebrow={`${build.category} (${build.year})`}
  heading={build.title}
  subtitle={build.summary}
  statusLabel={build.statusLabel}
>
  <figure class="doc-figure">
    <div class="figure-frame">
      <img
        src={build.cardImage.src}
        alt={build.cardImage.alt}
        width={build.cardImage.width}
        height={build.cardImage.height}
        loading="eager"
        decoding="async"
      />
    </div>
    <figcaption>{build.cardImage.caption}</figcaption>
  </figure>

  <div class="doc-grid">
    <section class="doc-card" aria-labelledby="problem-heading">
      <h2 id="problem-heading">The Problem</h2>
      <p>{build.problem}</p>
    </section>

    <section class="doc-card doc-card-tint" aria-labelledby="verified-heading">
      <h2 id="verified-heading">What Is Verified</h2>
      <ul class="check-list">
        {build.verifiedFacts.map((fact) => <li>{fact}</li>)}
      </ul>
      <div class="stack-row">
        <span class="stack-label">Stack</span>
        <ul class="stack-tags">
          {build.stackTags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </section>
  </div>

  <section class="doc-card" aria-labelledby="arch-heading">
    <h2 id="arch-heading">Architecture &amp; Request Flow</h2>
    <p class="arch-summary">{build.architectureSummary}</p>

    {build.diagramImage && (
      <figure class="doc-figure diagram-figure">
        <div class="figure-frame">
          <img
            src={build.diagramImage.src}
            alt={build.diagramImage.alt}
            width={build.diagramImage.width}
            height={build.diagramImage.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>{build.diagramImage.caption}</figcaption>
      </figure>
    )}

    <ol class="step-grid">
      {build.architectureSteps.map((s) => (
        <li class="step-item">
          <span class="step-num">{s.step}</span>
          <h3>{s.title}</h3>
          <p>{s.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  {build.implementations && build.implementations.length > 0 && (
    <section class="doc-card" aria-labelledby="impl-heading">
      <h2 id="impl-heading">Codebase Implementations</h2>
      <div class="impl-grid">
        {build.implementations.map((track) => (
          <div class="impl-box">
            <h3>{track.name}</h3>
            <p class="impl-scope">{track.scope}</p>
            <ul class="check-list">
              {track.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="doc-card" aria-labelledby="guardrails-heading">
    <h2 id="guardrails-heading">Safety &amp; Operational Guardrails</h2>
    <ul class="check-list">
      {build.guardrails.map((g) => <li>{g}</li>)}
    </ul>
  </section>

  {otherBuilds.length > 0 && (
    <nav class="more-builds" aria-label="Other documented systems">
      <h2>Other Documented Systems</h2>
      <div class="more-grid">
        {otherBuilds.map((item) => (
          <a href={`/work/${item.slug}/`} class="more-card">
            <span class="more-cat">{item.category}</span>
            <strong>{item.title}</strong>
            <span class="more-link">Read documentation &rarr;</span>
          </a>
        ))}
      </div>
    </nav>
  )}
</DocLayout>

<style>
  .doc-figure {
    margin: 0;
    padding: 14px;
    border-radius: 26px;
    background: linear-gradient(170deg, rgba(24, 24, 30, 0.92), rgba(14, 14, 18, 0.96));
    border: 1px solid var(--border);
  }

  .diagram-figure {
    margin: 24px 0;
    padding: 12px;
  }

  .figure-frame {
    border-radius: 16px;
    overflow: hidden;
    background: #0E0D14;
    border: 1px solid var(--border);
  }

  .figure-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    padding: 10px 6px 2px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .doc-card {
    padding: clamp(22px, 3vw, 34px);
    border-radius: 26px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--blur-glass);
    backdrop-filter: var(--blur-glass);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
  }

  .doc-card-tint {
    border-color: var(--glass-border-violet);
    background: var(--glass-bg-violet);
    box-shadow: var(--glass-rim-violet);
  }

  h2 {
    font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.65rem);
    margin: 0 0 14px;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  p {
    margin: 0;
    color: #C9C9D2;
    line-height: 1.65;
    max-width: 72ch;
  }

  .arch-summary {
    margin-bottom: 22px;
  }

  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 11px;
  }

  .check-list li {
    position: relative;
    padding-left: 20px;
    color: #E2E2E9;
    font-size: 15px;
    line-height: 1.52;
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 12px rgba(103, 0, 255, 0.9);
  }

  .stack-row {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .stack-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }

  .stack-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-tags li {
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--border);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink);
  }

  .step-grid {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .step-item {
    padding: 20px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
  }

  .step-num {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--violet-soft);
    margin-bottom: 6px;
  }

  .step-item h3 {
    font-size: 17px;
    margin: 0 0 8px;
    color: var(--ink);
  }

  .step-item p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .impl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .impl-box {
    padding: 20px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
  }

  .impl-box h3 {
    font-size: 17px;
    margin: 0 0 6px;
    color: var(--ink);
  }

  .impl-scope {
    font-size: 14px;
    color: var(--ink-2);
    margin-bottom: 14px;
  }

  .more-builds {
    padding-top: 12px;
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .more-card {
    padding: 22px 24px;
    border-radius: 22px;
    background: linear-gradient(170deg, rgba(22, 22, 27, 0.9), rgba(14, 14, 18, 0.96));
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.18s ease, transform 0.2s var(--ease-out);
  }

  .more-card:hover {
    border-color: var(--border-violet);
    transform: translateY(-2px);
  }

  .more-cat {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--violet-soft);
  }

  .more-card strong {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
  }

  .more-link {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--violet-soft);
  }

  @media (max-width: 860px) {
    .doc-grid,
    .step-grid,
    .impl-grid,
    .more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
