---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page Not Found | Beneru" 
  description="The page you are looking for does not exist."
>
  <section class="not-found-section">
    <div class="glass-box">
      <span class="status-code">404</span>
      <h1>Page Not Found</h1>
      <p>The page you are looking for might have been moved, removed, or never existed.</p>
      <a href="/" class="btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
  }

  .glass-box {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    padding: 4rem 3rem;
    max-width: 500px;
    width: 100%;
  }

  .status-code {
    font-size: 5rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
    filter: drop-shadow(0 4px 12px rgba(103, 0, 255, 0.3));
  }

  h1 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  p {
    color: var(--ink-2);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.875rem 2rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    border-radius: 99px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
    box-shadow: 0 12px 40px rgba(103, 0, 255, 0.15), inset 0 2px 6px rgba(255, 255, 255, 1);
  }
</style>
