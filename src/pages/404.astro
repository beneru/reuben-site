---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page Not Found | Beneru" 
  description="The page you are looking for does not exist."
>
  <section class="not-found-section">
    <div class="glass-box">
      <span class="status-code">404</span>
      <h1>Page Not Found</h1>
      <p>The page you are looking for might have been moved, removed, or never existed.</p>
      <a href="/" class="btn btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
  }

  .glass-box {
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-tint-border);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    border-radius: 26px;
    padding: 4rem 3rem;
    max-width: 500px;
    width: 100%;
  }

  .status-code {
    font-size: 5rem;
    font-weight: 800;
    color: var(--accent-ink);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
    filter: drop-shadow(0 4px 12px rgba(103, 0, 255, 0.28));
  }

  h1 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  p {
    color: var(--ink-2);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
</style>
