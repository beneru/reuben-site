---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofCloud from '../components/ProofCloud.astro';
import FlagshipDm from '../components/FlagshipDm.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import PillarsSection from '../components/PillarsSection.astro';
import SystemsCards from '../components/SystemsCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FounderStory from '../components/FounderStory.astro';
import Credentials from '../components/Credentials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SEO_DEFAULTS } from '../data/site';
---

<BaseLayout title={SEO_DEFAULTS.title} description={SEO_DEFAULTS.description} theme="light">
  <Hero />
  <div class="theme-light">
    <ProofCloud />
  </div>
  <FlagshipDm />
  <div class="theme-light">
    <WorkShowcase />
    <PillarsSection />
    <SystemsCards />
    <ProcessSteps />
    <FounderStory />
    <Credentials />
  </div>
  <CtaBanner />
</BaseLayout>
