---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import CtaPanel from '../components/CtaPanel.astro';

const audiences = ['E-commerce brands', 'B2B services', 'High-growth startups', 'Creators & founders', 'Digital agencies', 'Modern SMBs'];

const shifts = [
  { manual: 'Repurposing one video for five platforms', directed: 'One video becomes 20+ native posts, already scheduled' },
  { manual: 'Qualifying cold leads in your DMs', directed: 'AI qualifies intent and books the call, 24/7' },
  { manual: 'Testing 20 ad variations by hand', directed: 'Hooks generated and tested before spend leaks' },
  { manual: 'Chasing leads before they go cold', directed: 'Every lead lands in your CRM with a follow-up queued' },
];
---

<BaseLayout
  title="Beneru | AI Marketing Direction & Growth Systems"
  description="Direct your marketing with AI. Automate multi-platform content distribution, 24/7 inbound DM lead qualification, ad creative testing, and customer acquisition."
>
  <Hero />

  <section class="audience" aria-label="Who this is for" data-reveal>
    <p class="audience-label">Built for</p>
    <ul>
      {audiences.map((a) => <li>{a}</li>)}
    </ul>
  </section>

  <section class="shift section" aria-labelledby="shift-heading">
    <h2 id="shift-heading" class="section-title" data-reveal>Scaling marketing shouldn't mean drowning in manual grind.</h2>
    <div class="shift-grid">
      <div class="shift-col before" data-reveal style="--i:0">
        <h3>Running it by hand</h3>
        <ul>
          {shifts.map((s) => <li>{s.manual}</li>)}
        </ul>
      </div>
      <div class="shift-col after" data-reveal style="--i:1">
        <h3>Directed by AI</h3>
        <ul>
          {shifts.map((s) => <li>{s.directed}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <ServicesSection />

  <section id="work" class="work section" aria-labelledby="work-heading">
    <div class="work-head" data-reveal>
      <h2 id="work-heading" class="section-title">Selected work</h2>
      <p class="section-lead">Real systems for real businesses, with the numbers behind them.</p>
    </div>
    <PortfolioGrid limit={4} />
  </section>

  <CtaPanel />
</BaseLayout>

<style>
  /* Audience strip */
  .audience {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding: 1.75rem 0;
    border-top: 1px solid var(--glass-border-subtle);
    border-bottom: 1px solid var(--glass-border-subtle);
  }

  .audience-label {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .audience ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .audience li {
    padding: 0.42rem 0.95rem;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    transition: background-color 0.25s var(--ease-ios), border-color 0.25s var(--ease-ios), color 0.25s ease;
  }

  .audience li:hover {
    background: var(--glass-tint);
    border-color: var(--glass-tint-border);
    color: var(--ink);
  }

  /* Before / after */
  .shift .section-title { max-width: 22ch; margin-bottom: clamp(2rem, 4vw, 3rem); }

  .shift-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .shift-col {
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .shift-col h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .shift-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .shift-col li {
    position: relative;
    padding-left: 1.75rem;
    line-height: 1.45;
  }

  .shift-col li::before {
    position: absolute;
    left: 0;
    top: 0.05em;
    font-weight: 600;
  }

  .before {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    color: var(--ink-2);
  }

  .before h3 { color: var(--ink-2); }
  .before li { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--ink-muted) 55%, transparent); }
  .before li::before { content: '\00D7'; color: var(--ink-muted); }

  .after {
    background: linear-gradient(145deg, rgba(103, 0, 255, 0.84) 0%, rgba(82, 0, 224, 0.74) 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.94);
    box-shadow: var(--glass-tint-highlight), 0 26px 56px -26px rgba(103, 0, 255, 0.62);
  }

  .after h3 { color: #FFFFFF; }
  .after li { color: #FFFFFF; }
  .after li::before { content: '\2192'; color: #FFFFFF; }

  /* Work */
  .work { padding-top: 0; }
  .work-head { margin-bottom: clamp(2rem, 4vw, 3rem); }

  @media (max-width: 760px) {
    .shift-grid { grid-template-columns: 1fr; }
  }
</style>
