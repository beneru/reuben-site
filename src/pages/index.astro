---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContextStrip from '../components/ContextStrip.astro';
import ProofShowcase from '../components/ProofShowcase.astro';
import SystemsIndex from '../components/SystemsIndex.astro';
import FounderSection from '../components/FounderSection.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { SEO_DEFAULTS } from '../data/site';
---

<BaseLayout title={SEO_DEFAULTS.title} description={SEO_DEFAULTS.description} image={SEO_DEFAULTS.ogImage}>
  <Hero />
  <ContextStrip />
  <ProofShowcase />
  <SystemsIndex />
  <FounderSection />
  <CtaPanel />
</BaseLayout>
