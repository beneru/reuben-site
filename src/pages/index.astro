---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
---

<BaseLayout 
  title="Beneru | AI Automation for Food Businesses" 
  description="Run your food business smarter with AI. Automate bookings, customer messages, inventory, and operations."
>
  <Hero />
  
  <!-- Trust Marquee -->
  <div class="marquee-container">
    <div class="marquee-eyebrow">Built for businesses that move fast.</div>
    <div class="marquee">
      <div class="marquee-content">
        <span>Restaurants <div class="dot"></div> Cafés <div class="dot"></div> Bakeries <div class="dot"></div> Cloud Kitchens <div class="dot"></div> Food Chains <div class="dot"></div> Catering <div class="dot"></div> Food Delivery <div class="dot"></div></span>
        <span>Restaurants <div class="dot"></div> Cafés <div class="dot"></div> Bakeries <div class="dot"></div> Cloud Kitchens <div class="dot"></div> Food Chains <div class="dot"></div> Catering <div class="dot"></div> Food Delivery <div class="dot"></div></span>
      </div>
    </div>
  </div>

  <!-- Problem Section -->
  <section class="problem-section">
    <h2 class="problem-title">Running a food business means managing a hundred things at once.</h2>
    <div class="chaos-visual">
      <!-- Chaos cards -->
      <div class="chaos-card c1">Reply to customer</div>
      <div class="chaos-card c2">Confirm reservation</div>
      <div class="chaos-card c3">Update inventory</div>
      <div class="chaos-card c4">Check delivery order</div>
    </div>
    <div class="problem-resolution">
      <h3 class="resolution-title">Your team shouldn't have to manage everything <span class="highlight-accent">manually</span>.</h3>
    </div>
  </section>

  <ServicesSection />
  
  <!-- Final CTA -->
  <section id="demo" class="cta-section">
    <div class="cta-content">
      <h2 class="cta-title">Your business is already busy.<br/><span class="highlight-accent">Your systems don't have to be.</span></h2>
      <p class="cta-subtitle">Let's identify what your food business can automate.</p>
      <div class="cta-actions">
        <button id="openAuditBtn" class="btn btn-primary">Book a Free Automation Audit</button>
        <a href="https://instagram.com/Beneru.ai" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Chat on Instagram</a>
      </div>
    </div>
  </section>

  <!-- Interactive Audit Modal -->
  <dialog id="auditModal" class="audit-modal">
    <div class="modal-card">
      <button id="closeModalBtn" class="close-btn" aria-label="Close modal">&times;</button>
      <div class="modal-header">
        <span class="modal-badge">Free 15-Minute Audit</span>
        <h3>Book Your Automation Audit</h3>
        <p>Pick a day and time that works for you, and tell us specifically what you want to automate.</p>
      </div>

      <form id="auditForm" class="audit-form" action="https://formsubmit.co/ajax/reubenmagallanes91@gmail.com" method="POST">
        <input type="hidden" name="_subject" id="formSubject" value="New Automation Audit Booking" />
        <input type="hidden" name="_template" value="table" />

        <div class="form-row">
          <div class="form-group">
            <label for="bizName">Business / Brand Name</label>
            <input type="text" id="bizName" name="business_name" required placeholder="e.g. Cafe Luna / Burger Garage" />
          </div>

          <div class="form-group">
            <label for="contactInfo">Email or Phone / WhatsApp</label>
            <input type="text" id="contactInfo" name="contact" required placeholder="e.g. hello@cafeluna.ph or 0917-xxx-xxxx" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="bookingDate">Preferred Day</label>
            <input type="date" id="bookingDate" name="preferred_date" required />
          </div>

          <div class="form-group">
            <label for="bookingTime">Preferred Time (PHT)</label>
            <select id="bookingTime" name="preferred_time" required>
              <option value="" disabled selected>Select a time slot</option>
              <option value="09:00 AM - 09:30 AM">09:00 AM - 09:30 AM</option>
              <option value="10:00 AM - 10:30 AM">10:00 AM - 10:30 AM</option>
              <option value="11:00 AM - 11:30 AM">11:00 AM - 11:30 AM</option>
              <option value="01:00 PM - 01:30 PM">01:00 PM - 01:30 PM</option>
              <option value="02:00 PM - 02:30 PM">02:00 PM - 02:30 PM</option>
              <option value="03:00 PM - 03:30 PM">03:00 PM - 03:30 PM</option>
              <option value="04:00 PM - 04:30 PM">04:00 PM - 04:30 PM</option>
              <option value="07:00 PM - 07:30 PM">07:00 PM - 07:30 PM</option>
              <option value="08:00 PM - 08:30 PM">08:00 PM - 08:30 PM</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="primaryGoal">Primary Area</label>
          <select id="primaryGoal" name="automation_goal">
            <option value="Customer DMs & Inquiries">Replying to customer DMs & inquiries</option>
            <option value="Bookings & Confirmations">Table bookings & confirmations</option>
            <option value="Inventory & Stock Alerts">Inventory tracking & stock alerts</option>
            <option value="Marketing & Retention">Automated promos & customer retention</option>
            <option value="Full Business Automation">Full business automation audit</option>
            <option value="Custom Workflow">Other / Custom workflow</option>
          </select>
        </div>

        <div class="form-group">
          <label for="customAutomation">What specifically do you want to automate? <span class="label-hint">(Custom details)</span></label>
          <textarea
            id="customAutomation"
            name="custom_automation_details"
            rows="3"
            required
            placeholder="Describe the exact tasks, bottlenecks, or tools (e.g. Messenger orders, Google Sheets, POS, staff handoffs) you want automated..."
          ></textarea>
        </div>

        <button type="submit" id="submitAuditBtn" class="btn btn-primary submit-btn">Confirm Booking Slot</button>
      </form>

      <div id="formSuccess" class="form-success" style="display: none;">
        <span class="success-icon">&#10003;</span>
        <h4>Booking Request Confirmed!</h4>
        <p id="bookingSummaryText">We received your slot and automation details and will reach out to confirm shortly.</p>
        <div class="success-actions">
          <a id="gcalLink" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary gcal-btn">Add to Google Calendar</a>
        </div>
      </div>
    </div>
  </dialog>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('auditModal') as HTMLDialogElement;
      const openBtn = document.getElementById('openAuditBtn');
      const closeBtn = document.getElementById('closeModalBtn');
      const form = document.getElementById('auditForm') as HTMLFormElement;
      const successMsg = document.getElementById('formSuccess');
      const submitBtn = document.getElementById('submitAuditBtn') as HTMLButtonElement;
      const dateInput = document.getElementById('bookingDate') as HTMLInputElement;
      const gcalLink = document.getElementById('gcalLink') as HTMLAnchorElement;
      const summaryText = document.getElementById('bookingSummaryText');

      // Prevent booking past dates
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.min = today;
        dateInput.value = today;
      }

      if (openBtn && modal) {
        openBtn.addEventListener('click', () => modal.showModal());
      }

      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => modal.close());
      }

      // Close when clicking modal backdrop
      if (modal) {
        modal.addEventListener('click', (e) => {
          const rect = modal.getBoundingClientRect();
          const isInDialog = (
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width
          );
          if (!isInDialog) {
            modal.close();
          }
        });
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          const biz = String(formData.get('business_name') || '');
          const contact = String(formData.get('contact') || '');
          const date = String(formData.get('preferred_date') || '');
          const time = String(formData.get('preferred_time') || '');
          const goal = String(formData.get('automation_goal') || '');
          const customDetails = String(formData.get('custom_automation_details') || '');

          const subjectField = document.getElementById('formSubject') as HTMLInputElement;
          if (subjectField) {
            subjectField.value = `[Audit Booking] ${biz} on ${date} (${time})`;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Locking in your slot...';
          }

          // Build Google Calendar quick link for the visitor/owner
          const cleanDate = date.replace(/-/g, '');
          const calTitle = encodeURIComponent(`Automation Audit: ${biz} x Beneru`);
          const calDetails = encodeURIComponent(
            `Business: ${biz}\nContact: ${contact}\nPreferred Slot: ${date} (${time} PHT)\nPrimary Area: ${goal}\nCustom Automation Request:\n${customDetails}`
          );
          if (gcalLink && cleanDate) {
            gcalLink.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTitle}&dates=${cleanDate}/${cleanDate}&details=${calDetails}`;
          }

          if (summaryText) {
            summaryText.textContent = `Booked for ${date} at ${time} (PHT). We'll review your custom workflow request and reach out within 24 hours.`;
          }

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error('Network submission fallback');
          } catch {
            // Fallback mailto if offline or blocked
            const subject = encodeURIComponent(`[Audit Booking] ${biz} - ${date} (${time})`);
            const body = encodeURIComponent(
              `Hi Ben,\n\nI'd like to book a free automation audit.\n\nBusiness: ${biz}\nContact: ${contact}\nPreferred Date: ${date}\nPreferred Time: ${time} (PHT)\nPrimary Area: ${goal}\n\nWhat I want to automate:\n${customDetails}`
            );
            window.location.href = `mailto:reubenmagallanes91@gmail.com?subject=${subject}&body=${body}`;
          }

          form.style.display = 'none';
          if (successMsg) successMsg.style.display = 'block';
        });
      }
    });
  </script>

</BaseLayout>

<style>
  /* Marquee */
  .marquee-container {
    padding: 4rem 0;
    text-align: center;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .marquee-eyebrow {
    font-size: 0.875rem;
    color: var(--ink-2);
    font-weight: 500;
    margin-bottom: 2rem;
  }
  .marquee {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
  }
  .marquee-content {
    display: flex;
    width: fit-content;
    animation: scroll 30s linear infinite;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
  }
  .marquee-content span {
    display: flex;
    align-items: center;
    padding-right: 2rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent);
    border-radius: 50%;
    margin: 0 2rem;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Problem Section */
  .problem-section {
    padding: 8rem 0;
    text-align: center;
  }
  .problem-title {
    font-size: var(--step-3);
    max-width: 25ch;
    margin: 0 auto 4rem;
  }
  .chaos-visual {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .chaos-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    padding: 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    color: var(--ink-2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  .chaos-card:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
    color: var(--accent);
    box-shadow: 0 12px 40px rgba(103, 0, 255, 0.15), inset 0 2px 6px rgba(255, 255, 255, 1);
  }
  
  .resolution-title {
    font-size: var(--step-2);
  }

  /* CTA */
  .cta-section {
    padding: 12rem 0;
    text-align: center;
    position: relative;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    margin: 4rem 0;
    overflow: hidden;
  }

  .cta-content {
    position: relative;
    z-index: 2;
  }

  .cta-title {
    font-size: var(--step-4);
    margin-bottom: 1.5rem;
  }
  .cta-subtitle {
    font-size: var(--step-1);
    color: var(--ink-2);
    margin-bottom: 3rem;
  }
  .btn {
    padding: 1.25rem 2.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: 99px;
    display: inline-block;
  }
  .btn-primary {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05), inset 0 2px 4px rgba(255, 255, 255, 0.9);
    color: var(--ink);
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }
  .btn-primary:hover {
    transform: scale(1.02);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
    box-shadow: 0 12px 40px rgba(103, 0, 255, 0.15), inset 0 2px 6px rgba(255, 255, 255, 1);
  }
  .highlight-accent {
    display: inline-block;
    color: rgba(103, 0, 255, 0.65);
    filter: drop-shadow(0 -1px 1px rgba(255,255,255,0.9)) drop-shadow(0 8px 16px rgba(103,0,255,0.3));
  }

  .cta-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.02) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02), inset 0 1px 2px rgba(255, 255, 255, 0.5);
    color: var(--ink);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    border-color: rgba(17, 17, 17, 0.2);
    transform: translateY(-2px);
    text-decoration: none;
  }

  /* Modal Dialog */
  .audit-modal {
    border: none;
    border-radius: 24px;
    background: transparent;
    padding: 0;
    max-width: 520px;
    width: 90%;
  }

  .audit-modal::backdrop {
    background: rgba(10, 10, 15, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal-card {
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
    padding: 2.5rem;
    position: relative;
    text-align: left;
  }

  .close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    font-size: 1.75rem;
    color: var(--ink-2);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .close-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--ink);
  }

  .modal-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .modal-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .modal-header p {
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .audit-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .label-hint {
    font-weight: 400;
    color: var(--ink-2);
    font-size: 0.75rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--ink);
    background: #fdfdfd;
    outline: none;
    transition: all 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 88px;
    line-height: 1.45;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(103, 0, 255, 0.15);
  }

  .submit-btn {
    margin-top: 0.5rem;
    width: 100%;
    cursor: pointer;
    border: none;
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form-success {
    text-align: center;
    padding: 2rem 1rem;
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #eefdf3;
    color: #16a34a;
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .form-success h4 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .form-success p {
    color: var(--ink-2);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .success-actions {
    display: flex;
    justify-content: center;
  }

  .gcal-btn {
    padding: 0.65rem 1.25rem;
    font-size: 0.875rem;
    border-radius: 10px;
  }

  @media (max-width: 640px) {
    .marquee-container {
      padding: 2.5rem 0;
    }
    .marquee-content {
      font-size: 1.125rem;
    }
    .problem-section {
      padding: 4rem 1rem;
    }
    .problem-title {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }
    .chaos-visual {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
    }
    .chaos-card {
      padding: 1rem 1.25rem;
      font-size: 0.875rem;
    }
    .resolution-title {
      font-size: 1.25rem;
    }
    .cta-section {
      padding: 4.5rem 1.25rem;
      margin: 3rem 0;
      border-radius: 20px;
    }
    .cta-title {
      font-size: clamp(1.75rem, 6vw, 2.25rem);
    }
    .cta-subtitle {
      font-size: 1rem;
      margin-bottom: 2rem;
    }
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }
    .cta-actions .btn {
      width: 100%;
      max-width: 300px;
      padding: 1rem 1.5rem;
      font-size: 1rem;
      text-align: center;
    }
    .modal-card {
      padding: 1.75rem 1.25rem;
      border-radius: 20px;
      max-height: 88vh;
      overflow-y: auto;
    }
    .modal-header h3 {
      font-size: 1.25rem;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }
  }
</style>
