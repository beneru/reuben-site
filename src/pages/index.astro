---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofCloud from '../components/ProofCloud.astro';
import ProblemCarousel from '../components/ProblemCarousel.astro';
import OutcomesSection from '../components/OutcomesSection.astro';
import SystemsCards from '../components/SystemsCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import FounderStory from '../components/FounderStory.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SEO_DEFAULTS } from '../data/site';
---

<BaseLayout title={SEO_DEFAULTS.title} description={SEO_DEFAULTS.description}>
  <Hero />
  <ProofCloud />
  <ProblemCarousel />
  <OutcomesSection />
  <SystemsCards />
  <ProcessSteps />
  <WorkShowcase />
  <FounderStory />
  <CtaBanner />
</BaseLayout>
