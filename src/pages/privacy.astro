---
import DocLayout from '../layouts/DocLayout.astro';
import { PRIVACY_DOC } from '../data/privacy';
---

<DocLayout
  title={PRIVACY_DOC.seoTitle}
  description={PRIVACY_DOC.seoDescription}
  eyebrow={`Updated ${PRIVACY_DOC.lastUpdated}`}
  heading={PRIVACY_DOC.title}
  subtitle={PRIVACY_DOC.intro}
  backHref="/"
  backLabel="Back to home"
>
  <div class="privacy-sections">
    {PRIVACY_DOC.sections.map((sec, idx) => (
      <section
        id={sec.id}
        class="privacy-card"
        aria-labelledby={`${sec.id}-heading`}
        data-stage-frames
        data-frame-slide={idx % 2 === 0 ? 'left' : 'right'}
        data-shine="light"
        style="--fi: 0"
      >
        <h2 id={`${sec.id}-heading`}>{sec.heading}</h2>
        {sec.paragraphs.map((p) => <p>{p}</p>)}
        {sec.bullets && (
          <ul>
            {sec.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
      </section>
    ))}
  </div>
</DocLayout>

<style>
  .privacy-sections {
    display: grid;
    gap: 20px;
    max-width: 78ch;
  }

  .privacy-card {
    padding: clamp(24px, 3vw, 34px);
    border-radius: 26px;
    background: #FFFFFF;
    box-shadow: 0 16px 34px -20px rgba(103, 0, 255, 0.24);
    display: grid;
    gap: 12px;
  }

  h2 {
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.55rem);
    margin: 0;
    letter-spacing: -0.02em;
    color: #0D0814;
  }

  p {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.65;
  }

  ul {
    margin: 4px 0 0;
    padding-left: 20px;
    color: var(--ink-2);
    display: grid;
    gap: 8px;
  }

  li {
    line-height: 1.55;
  }
</style>
