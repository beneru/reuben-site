---
import DocLayout from '../layouts/DocLayout.astro';
import { PRIVACY_DOC } from '../data/privacy';
---

<DocLayout
  title={PRIVACY_DOC.seoTitle}
  description={PRIVACY_DOC.seoDescription}
  eyebrow={`Updated ${PRIVACY_DOC.lastUpdated}`}
  heading={PRIVACY_DOC.title}
  subtitle={PRIVACY_DOC.intro}
  backHref="/"
  backLabel="Back to home"
>
  <div class="privacy-sections">
    {PRIVACY_DOC.sections.map((sec) => (
      <section id={sec.id} class="privacy-card" aria-labelledby={`${sec.id}-heading`}>
        <h2 id={`${sec.id}-heading`}>{sec.heading}</h2>
        {sec.paragraphs.map((p) => <p>{p}</p>)}
        {sec.bullets && (
          <ul>
            {sec.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
      </section>
    ))}
  </div>
</DocLayout>

<style>
  .privacy-sections {
    display: grid;
    gap: 20px;
    max-width: 78ch;
  }

  .privacy-card {
    padding: clamp(22px, 3vw, 32px);
    border-radius: 24px;
    background: linear-gradient(170deg, rgba(22, 22, 27, 0.92), rgba(14, 14, 18, 0.96));
    border: 1px solid var(--border);
    display: grid;
    gap: 12px;
  }

  h2 {
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.55rem);
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  p {
    margin: 0;
    color: #C9C9D2;
    line-height: 1.65;
  }

  ul {
    margin: 4px 0 0;
    padding-left: 20px;
    color: #E2E2E9;
    display: grid;
    gap: 8px;
  }

  li {
    line-height: 1.55;
  }
</style>
