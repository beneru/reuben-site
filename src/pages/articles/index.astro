---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Articles | Beneru AI Marketing Direction" 
  description="Read insights on AI marketing direction, automated content distribution, and inbound lead qualification for modern brands."
>
  <section class="articles-page">
    <h1 class="articles-heading">Articles</h1>
    <ul class="article-list">
      <li>
        <a href="/articles/facebook-orders-automation" class="article-card">
          <h2>How to Automate Inbound DM Sales and Lead Capture</h2>
          <p>Stop leaving high-intent prospects waiting in chat. Learn how modern brands turn social messaging channels into an autonomous acquisition funnel.</p>
          <span class="article-cta">Read article <span aria-hidden="true">&rarr;</span></span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .articles-page {
    max-width: 68ch;
    padding: 4rem 0;
  }

  .articles-heading {
    font-size: var(--step-4);
    margin-bottom: 2rem;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .article-card {
    display: block;
    padding: 1.75rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    color: var(--ink);
    transition: transform 0.4s var(--spring-ios), background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.35s var(--ease-ios);
  }

  .article-card:hover {
    transform: translateY(-2px);
    background: var(--glass-bg-hover);
    border-color: var(--glass-tint-border);
    box-shadow: var(--glass-highlight), var(--shadow-md);
    color: var(--ink);
  }

  .article-card h2 {
    font-size: var(--step-2);
    margin: 0 0 0.65rem;
    color: var(--ink);
  }

  .article-card p {
    margin: 0 0 1.15rem;
    color: var(--ink-2);
  }

  .article-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-ink);
  }
</style>
