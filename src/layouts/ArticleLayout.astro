---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="prose">
    <header class="article-header">
      <a href="/articles" class="back-link">&larr; Back to Articles</a>
      <h1 class="article-title">{frontmatter.title.split('|')[0]}</h1>
      <div class="article-meta">
        <span>By Ben (Reuben Magallanes)</span> &bull; <span>Food Business Automation</span>
      </div>
    </header>
    
    <div class="article-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose {
    max-width: 70ch;
    margin: 0 auto;
    padding: 4rem 0;
  }

  .article-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .article-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .article-meta {
    font-size: 0.9rem;
    color: var(--ink-2);
    font-weight: 500;
  }

  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .article-content h1 {
    display: none; /* Hide the markdown H1 since we use frontmatter title */
  }

  .article-content h2 {
    font-size: 1.75rem;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .article-content h3 {
    font-size: 1.35rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-content p {
    margin-bottom: 1.75rem;
  }

  .article-content ul, .article-content ol {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }

  .article-content li {
    margin-bottom: 0.75rem;
  }

  .article-content strong {
    font-weight: 700;
    color: var(--ink);
  }

  .article-content a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>
