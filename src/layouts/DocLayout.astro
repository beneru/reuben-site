---
import BaseLayout from './BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  subtitle?: string;
  statusLabel?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  eyebrow,
  heading,
  subtitle,
  statusLabel,
  backHref = '/#work',
  backLabel = 'Back to documented systems',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="doc-shell">
    <div class="doc-wrap">
      <div class="doc-back-row">
        <a href={backHref} class="doc-back">
          <span aria-hidden="true">&larr;</span> {backLabel}
        </a>
      </div>

      <header class="doc-header">
        <div class="doc-meta">
          <span class="pill-tag doc-eyebrow">{eyebrow}</span>
          {statusLabel && <span class="doc-status">{statusLabel}</span>}
        </div>
        <h1 class="doc-h1">{heading}</h1>
        {subtitle && <p class="doc-lead">{subtitle}</p>}
      </header>

      <div class="doc-content">
        <slot />
      </div>
    </div>
  </article>

  <CtaBanner />
</BaseLayout>

<style>
  .doc-shell {
    padding: clamp(36px, 5vw, 68px) 0 16px;
  }

  .doc-wrap {
    width: var(--doc-w);
    margin-inline: auto;
  }

  .doc-back-row {
    margin-bottom: 24px;
  }

  .doc-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: #15111E;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .doc-back:hover {
    color: var(--ink);
    background: #1F1A2C;
  }

  .doc-header {
    max-width: 78ch;
    margin-bottom: clamp(28px, 4vw, 48px);
    padding-bottom: 28px;
  }

  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 18px;
  }

  .doc-eyebrow {
    color: var(--violet-soft);
    background: rgba(103, 0, 255, 0.12);
  }

  .doc-status {
    font-size: 13.5px;
    color: var(--ink-muted);
  }

  .doc-h1 {
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 1.35rem + 2.3vw, 3.15rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.028em;
    padding-bottom: 0.06em;
    background-image: var(--grad-shimmer);
    background-size: var(--blob-bg-size);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: text-blob-drift 14s ease-in-out -4s infinite alternate;
  }

  .doc-lead {
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    color: #C2BCD4;
    line-height: 1.62;
  }

  .doc-content {
    display: grid;
    gap: 24px;
  }

  @media (max-width: 640px) {
    .doc-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
