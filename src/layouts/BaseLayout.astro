---
import '../styles/global.css';
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { FOOTER_COPY, NAV_ITEMS, SEO_DEFAULTS, SITE_IDENTITY } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  /** 'light' = cream story canvas with a transparent header over a full-bleed hero (homepage). */
  theme?: 'dark' | 'light';
}

const {
  title = SEO_DEFAULTS.title,
  description = SEO_DEFAULTS.description,
  image = SEO_DEFAULTS.ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href,
  noindex = false,
  theme = 'dark',
} = Astro.props;
const isLight = theme === 'light';

const currentUrl = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href;
const ogImage = new URL(image, Astro.site || SITE_IDENTITY.siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      name: SITE_IDENTITY.personName,
      alternateName: [...SITE_IDENTITY.alternateNames],
      url: SITE_IDENTITY.siteUrl,
      image: `${SITE_IDENTITY.siteUrl}/images/founder/reuben-studio.webp`,
      email: SITE_IDENTITY.email,
      jobTitle: SITE_IDENTITY.role,
      worksFor: {
        '@type': 'Organization',
        name: SITE_IDENTITY.companyName,
        url: SITE_IDENTITY.companyUrl,
      },
      knowsAbout: [...SEO_DEFAULTS.knowsAbout],
      sameAs: SOCIAL_LINKS.map((s) => s.url),
      description: SEO_DEFAULTS.personDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_IDENTITY.siteUrl}/#website`,
      url: SITE_IDENTITY.siteUrl,
      name: SITE_IDENTITY.brandName,
      publisher: {
        '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class={isLight ? 'page-light' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Beneru (Reuben Magallanes)" />
    <meta name="publisher" content="Beneru" />
    <meta name="keywords" content={SEO_DEFAULTS.keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Beneru" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Schema.org Structured Data for Reuben Magallanes (Beneru) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="json-ld" />

    <!-- Spawntel Brand Guidelines Typography: Poppins + General Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
      />
    </noscript>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a href="#main" class="skip-to-content">Skip to content</a>

    <header class:list={['site-header', { 'header-overlay': isLight }]} data-site-header>
      <div class="header-inner">
        <a href="/" class="wordmark" aria-label="Beneru home">
          {SITE_IDENTITY.wordmark}<span class="wordmark-dot" aria-hidden="true">.</span>
        </a>

        <nav aria-label="Primary" class="nav-links" data-primary-nav>
          {NAV_ITEMS.map((item) => (
            <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a
            href={spawntelFunnelUrl('header')}
            class="cta-btn header-cta"
            data-spawntel-cta="header"
          >
            <span>Book a Call</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>

          <details class="mobile-menu">
            <summary aria-label="Toggle navigation menu">
              <svg class="plus-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
              </svg>
            </summary>
            <nav aria-label="Mobile" class="mobile-panel theme-dark">
              {NAV_ITEMS.map((item) => (
                <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
              ))}
              <a href="/privacy/">Privacy Policy</a>
              <a href={SITE_IDENTITY.mailto} class="mobile-email">{SITE_IDENTITY.email}</a>
            </nav>
          </details>
        </div>
      </div>
      <div class="header-progress" data-scroll-progress aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="ft-wrap">
        <div class="ft-top">
          <div class="ft-cols">
            <div class="ft-col">
              <h3>Site</h3>
              <ul>
                {FOOTER_COPY.siteLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="ft-col">
              <h3>Systems</h3>
              <ul>
                {FOOTER_COPY.buildLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="ft-col">
              <h3>Contact &amp; Legal</h3>
              <ul>
                <li>
                  <a href={spawntelFunnelUrl('footer')} data-spawntel-cta="footer">Book a Call</a>
                </li>
                <li><a href={FOOTER_COPY.mailto}>Email me</a></li>
                <li><a href="/privacy/">Privacy Policy</a></li>
              </ul>
            </div>
          </div>

          <div class="ft-col ft-follow">
            <h3>Follow</h3>
            <ul class="ft-socials" aria-label="Social accounts">
              {SOCIAL_LINKS.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${s.label} (${s.handle})`}
                    title={`${s.label} (${s.handle})`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={s.iconSvg} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="ft-bottom">
          <span>&copy; {new Date().getFullYear()} {FOOTER_COPY.copyrightHolder}. All rights reserved.</span>
          <a href="#top">Back to top &uarr;</a>
        </div>
      </div>

      <div class="ft-mark-wrap" aria-hidden="true">
        <svg class="ft-mark" viewBox="0 0 1200 312" preserveAspectRatio="xMidYMax meet">
          <defs>
            <linearGradient id="beneru-mark-fill" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#4A3F68" stop-opacity="0.72" />
              <stop offset="62%" stop-color="#251F35" stop-opacity="0.46" />
              <stop offset="100%" stop-color="#101012" stop-opacity="0.06" />
            </linearGradient>
          </defs>
          <g transform="translate(0, 308) scale(1, 1.4)">
            <text
              x="600"
              y="0"
              text-anchor="middle"
              textLength="1216"
              lengthAdjust="spacingAndGlyphs"
              fill="url(#beneru-mark-fill)"
            >
              {FOOTER_COPY.wordmark}
            </text>
          </g>
        </svg>
      </div>
    </footer>

    <script>
      // Scroll reveal: IntersectionObserver only.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Section scroll-spy on homepage using IntersectionObserver.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
      if ('IntersectionObserver' in window && navLinks.length > 0) {
        const sectionIds = Array.from(new Set(Array.from(navLinks).map((a) => a.dataset.sectionLink).filter(Boolean))) as string[];
        const topClearIds = ['hero', 'proof'];
        const observedIds = [...topClearIds, ...sectionIds];
        const sections = observedIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
        if (sectionIds.some((id) => document.getElementById(id))) {
          const spy = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const activeId = entry.target.id;
                  const isClear = topClearIds.includes(activeId);
                  navLinks.forEach((link) => {
                    if (!isClear && link.dataset.sectionLink === activeId) {
                      link.setAttribute('aria-current', 'location');
                    } else {
                      link.removeAttribute('aria-current');
                    }
                  });
                }
              });
            },
            { rootMargin: '-28% 0px -55% 0px', threshold: 0 },
          );
          sections.forEach((sec) => spy.observe(sec));
        } else if (location.pathname.startsWith('/work/')) {
          navLinks.forEach((link) => {
            if (link.dataset.sectionLink === 'work') {
              link.setAttribute('aria-current', 'page');
            }
          });
        }
      }

      // Mobile menu: close on link click, Escape key, or outside click.
      const menus = document.querySelectorAll<HTMLDetailsElement>('.mobile-menu');
      menus.forEach((menu) => {
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menus.forEach((menu) => {
            if (menu.hasAttribute('open')) {
              menu.removeAttribute('open');
              menu.querySelector('summary')?.focus();
            }
          });
        }
      });
      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (!target) return;
        menus.forEach((menu) => {
          if (menu.hasAttribute('open') && !menu.contains(target)) {
            menu.removeAttribute('open');
          }
        });
      });

      // Lightweight GPU scroll-progress hairline in the header.
      const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (progressBar) {
        let pRaf = 0;
        const paintProgress = () => {
          pRaf = 0;
          const docH = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const ratio = Math.min(1, Math.max(0, window.scrollY / docH));
          progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
        };
        const onPageScroll = () => {
          if (!pRaf) pRaf = requestAnimationFrame(paintProgress);
        };
        paintProgress();
        window.addEventListener('scroll', onPageScroll, { passive: true });
        window.addEventListener('resize', paintProgress, { passive: true });
      }

      // Light homepage: header floats transparent over the hero, then turns solid cream.
      const siteHeader = document.querySelector<HTMLElement>('[data-site-header].header-overlay');
      const heroEl = document.getElementById('hero');
      if (siteHeader && heroEl) {
        let hRaf = 0;
        const paintHeader = () => {
          hRaf = 0;
          const solid = window.scrollY > heroEl.offsetHeight - siteHeader.offsetHeight - 8;
          siteHeader.classList.toggle('is-solid', solid);
          siteHeader.classList.toggle('theme-light', solid);
        };
        paintHeader();
        window.addEventListener('scroll', () => { if (!hRaf) hRaf = requestAnimationFrame(paintHeader); }, { passive: true });
        window.addEventListener('resize', paintHeader, { passive: true });
      }

      // Notify Reuben once per visitor session when someone clicks through to spawntel.com.
      const FUNNEL_PING_KEY = 'beneru_spawntel_ping';
      document.querySelectorAll<HTMLAnchorElement>('[data-spawntel-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem(FUNNEL_PING_KEY)) return;
            sessionStorage.setItem(FUNNEL_PING_KEY, '1');
          } catch {
            // Continue without sessionStorage if blocked by privacy settings.
          }
          const payload = JSON.stringify({
            placement: link.dataset.spawntelCta || 'cta',
            page: location.pathname,
            referrer: document.referrer || '',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/funnel-click', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/funnel-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: linear-gradient(180deg, rgba(22, 18, 34, 0.66) 0%, rgba(11, 11, 12, 0.56) 100%);
    -webkit-backdrop-filter: var(--blur-nav);
    backdrop-filter: var(--blur-nav);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 -1px 0 rgba(103, 0, 255, 0.12);
  }

  .header-overlay {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .header-overlay.is-solid {
    background: rgba(246, 243, 238, 0.86);
    border-bottom-color: rgba(27, 21, 48, 0.08);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  .header-overlay:not(.is-solid) .nav-links a {
    color: rgba(255, 255, 255, 0.9);
  }

  .header-overlay:not(.is-solid) .nav-links a:hover {
    color: #FFFFFF;
  }

  .header-overlay:not(.is-solid) .header-progress {
    opacity: 0;
  }

  .header-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, #6700FF 0%, #954DFF 60%, #D7C8FF 100%);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
    pointer-events: none;
  }

  .header-inner {
    width: var(--site-w);
    margin-inline: auto;
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .wordmark {
    justify-self: start;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.055em;
    line-height: 1;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }

  .wordmark-dot {
    color: var(--violet-bright);
    font-size: 1.45em;
    line-height: 0;
    margin-left: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-2);
    padding: 6px 2px;
    transition: color 0.16s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'],
  .nav-links a[aria-current='location'] {
    color: var(--ink);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-cta {
    height: 42px;
    padding: 0 7px 0 18px;
    font-size: 13.5px;
  }

  .header-cta .cta-btn__circle {
    width: 26px;
    height: 26px;
  }

  /* Mobile circular + toggle */
  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    box-shadow: var(--shadow-violet);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out), filter 0.16s ease;
  }

  .mobile-menu summary:hover {
    filter: brightness(1.12);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .plus-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.24s var(--ease-out);
  }

  .mobile-menu[open] .plus-icon {
    transform: rotate(45deg);
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(84vw, 276px);
    display: grid;
    gap: 4px;
    padding: 8px;
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(32, 26, 48, 0.84), rgba(14, 12, 22, 0.88));
    -webkit-backdrop-filter: var(--blur-nav);
    backdrop-filter: var(--blur-nav);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-rim);
  }

  .mobile-panel a {
    padding: 11px 14px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current='location'],
  .mobile-panel a[aria-current='page'] {
    background: rgba(103, 0, 255, 0.16);
    color: #FFFFFF;
  }

  .mobile-panel .mobile-email {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    font-size: 13px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nav-links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      height: 40px;
      padding: 0 6px 0 15px;
      font-size: 13px;
      gap: 9px;
    }
    .mobile-menu summary {
      width: 40px;
      height: 40px;
    }
  }

  /* ---------- Footer ---------- */
  .ft {
    position: relative;
    z-index: 2;
    background: #101012;
    color: var(--ink);
    padding-top: clamp(52px, 6.5vw, 84px);
    overflow: hidden;
    border-top: 1px solid rgba(103, 0, 255, 0.24);
    box-shadow: 0 -24px 80px -40px rgba(103, 0, 255, 0.35);
  }

  .ft-wrap {
    width: var(--site-w);
    margin-inline: auto;
  }

  .ft-top {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1.15fr);
    gap: 36px;
  }

  .ft-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .ft-col h3 {
    font-family: var(--font-sans);
    color: var(--ink-muted);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0 0 16px;
  }

  .ft-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft-col a {
    color: rgba(255, 255, 255, 0.88);
    font-size: 15px;
    transition: color 0.16s ease;
  }

  .ft-col a:hover {
    color: #FFFFFF;
  }

  .ft-col .ft-socials {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ft-socials a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #242429;
    color: rgba(255, 255, 255, 0.9);
    display: grid;
    place-items: center;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.2s var(--ease-out);
  }

  .ft-socials a:hover {
    background: var(--primary);
    color: #FFFFFF;
    transform: translateY(-3px);
  }

  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(48px, 6vw, 72px);
    font-size: 13px;
    color: var(--ink-muted);
  }

  .ft-bottom a {
    color: rgba(255, 255, 255, 0.85);
  }

  .ft-bottom a:hover {
    color: #FFFFFF;
  }

  .ft-mark-wrap {
    width: 100%;
    max-width: none;
    padding-inline: 0;
    margin: clamp(18px, 2.8vw, 34px) 0 0;
    line-height: 0;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
  }

  .ft-mark {
    width: 100%;
    height: auto;
    display: block;
  }

  .ft-mark text {
    font-family: var(--font-heading);
    font-size: 300px;
    font-weight: 900;
    letter-spacing: -0.04em;
    stroke: none;
  }

  @media (max-width: 980px) {
    .ft-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

