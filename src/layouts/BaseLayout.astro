---
import '../styles/global.css';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { FOOTER_COPY, NAV_ITEMS, SEO_DEFAULTS, SITE_IDENTITY } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = SEO_DEFAULTS.title,
  description = SEO_DEFAULTS.description,
  image = SEO_DEFAULTS.ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href,
  noindex = false,
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href;
const ogImage = new URL(image, Astro.site || SITE_IDENTITY.siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      name: SITE_IDENTITY.personName,
      alternateName: [...SITE_IDENTITY.alternateNames],
      url: SITE_IDENTITY.siteUrl,
      image: `${SITE_IDENTITY.siteUrl}/images/founder/reuben-studio.webp`,
      email: SITE_IDENTITY.email,
      jobTitle: SITE_IDENTITY.role,
      worksFor: {
        '@type': 'Organization',
        name: SITE_IDENTITY.companyName,
        url: SITE_IDENTITY.companyUrl,
      },
      knowsAbout: [...SEO_DEFAULTS.knowsAbout],
      sameAs: SOCIAL_LINKS.map((s) => s.url),
      description: SEO_DEFAULTS.personDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_IDENTITY.siteUrl}/#website`,
      url: SITE_IDENTITY.siteUrl,
      name: SITE_IDENTITY.brandName,
      publisher: {
        '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Beneru (Reuben Magallanes)" />
    <meta name="publisher" content="Beneru" />
    <meta name="keywords" content={SEO_DEFAULTS.keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Beneru" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Schema.org Structured Data for Reuben Magallanes (Beneru) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="json-ld" />
    <meta name="theme-color" content="#F9F8FD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0812" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <AmbientBackdrop />
    <a href="#main" class="skip-to-content">Skip to content</a>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand-logo" aria-label="Beneru home">
          <picture class="brand-avatar-frame">
            <source srcset="/PFP.webp" type="image/webp" />
            <img src="/PFP.png" alt="" width="32" height="32" class="brand-avatar" loading="eager" />
          </picture>
          <span>{SITE_IDENTITY.brandName}</span>
        </a>

        <nav aria-label="Primary" class="nav-links" data-primary-nav>
          {NAV_ITEMS.map((item) => (
            <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a href={spawntelFunnelUrl('header')} class="btn btn-primary header-cta" data-spawntel-cta="header">
            Book on Spawntel
          </a>
          <details class="mobile-menu">
            <summary aria-label="Toggle navigation menu">
              <span class="burger" aria-hidden="true"><span></span><span></span></span>
            </summary>
            <nav aria-label="Mobile" class="mobile-panel">
              {NAV_ITEMS.map((item) => (
                <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
              ))}
              <a href="/privacy/">Privacy</a>
              <a href={SITE_IDENTITY.mailto}>{SITE_IDENTITY.email}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-brand">
          <div class="footer-brand-title">
            <picture class="footer-avatar-frame">
              <source srcset="/PFP.webp" type="image/webp" />
              <img src="/PFP.png" alt="" width="28" height="28" class="footer-avatar" loading="lazy" />
            </picture>
            <strong>{FOOTER_COPY.brandName}</strong>
          </div>
          <p>{FOOTER_COPY.summary}</p>
          <a class="footer-mail" href={FOOTER_COPY.mailto}>{FOOTER_COPY.email}</a>
          <div class="footer-socials" aria-label="Social accounts">
            {SOCIAL_LINKS.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-pill"
                aria-label={`${s.label} (${s.handle})`}
                title={`${s.label} (${s.handle})`}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={s.iconSvg} />
              </a>
            ))}
          </div>
        </div>

        <nav class="footer-col" aria-label="Footer navigation">
          <span class="footer-label">Navigate</span>
          {FOOTER_COPY.navigateLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href={spawntelFunnelUrl('footer')} data-spawntel-cta="footer">Spawntel.com</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {FOOTER_COPY.copyrightHolder}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Scroll reveal: IntersectionObserver only, no scroll listeners.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Section scroll-spy on homepage using IntersectionObserver (zero scroll event listeners).
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
      if ('IntersectionObserver' in window && navLinks.length > 0) {
        const sectionIds = Array.from(new Set(Array.from(navLinks).map((a) => a.dataset.sectionLink).filter(Boolean))) as string[];
        const sections = sectionIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
        if (sections.length > 0) {
          const spy = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const activeId = entry.target.id;
                  navLinks.forEach((link) => {
                    if (link.dataset.sectionLink === activeId) {
                      link.setAttribute('aria-current', 'location');
                    } else {
                      link.removeAttribute('aria-current');
                    }
                  });
                }
              });
            },
            { rootMargin: '-28% 0px -55% 0px', threshold: 0 },
          );
          sections.forEach((sec) => spy.observe(sec));
        } else if (location.pathname.startsWith('/work/')) {
          navLinks.forEach((link) => {
            if (link.dataset.sectionLink === 'work') {
              link.setAttribute('aria-current', 'page');
            }
          });
        }
      }

      // Mobile menu: close on link click, Escape key, or outside click.
      const menus = document.querySelectorAll<HTMLDetailsElement>('.mobile-menu');
      menus.forEach((menu) => {
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menus.forEach((menu) => {
            if (menu.hasAttribute('open')) {
              menu.removeAttribute('open');
              menu.querySelector('summary')?.focus();
            }
          });
        }
      });
      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (!target) return;
        menus.forEach((menu) => {
          if (menu.hasAttribute('open') && !menu.contains(target)) {
            menu.removeAttribute('open');
          }
        });
      });

      // Notify Reuben once per visitor session when someone clicks through to spawntel.com.
      const FUNNEL_PING_KEY = 'beneru_spawntel_ping';
      document.querySelectorAll<HTMLAnchorElement>('[data-spawntel-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem(FUNNEL_PING_KEY)) return;
            sessionStorage.setItem(FUNNEL_PING_KEY, '1');
          } catch {
            // Continue without sessionStorage if blocked by privacy settings.
          }
          const payload = JSON.stringify({
            placement: link.dataset.spawntelCta || 'cta',
            page: location.pathname,
            referrer: document.referrer || '',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/funnel-click', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/funnel-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--glass-bg-strong) 84%, var(--glass-tint));
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--glass-border-subtle);
    box-shadow: inset 0 -1px 0 0 var(--glass-edge-highlight), 0 4px 20px -12px rgba(42, 16, 102, 0.14);
  }

  .header-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 68px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .brand-logo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: -0.03em;
    justify-self: start;
  }

  .brand-logo:hover { color: var(--ink); }

  .brand-avatar-frame,
  .footer-avatar-frame {
    display: inline-flex;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--accent);
  }

  .brand-avatar-frame { width: 32px; height: 32px; transition: transform 0.25s var(--ease-out); }
  .brand-logo:hover .brand-avatar-frame { transform: rotate(-6deg) scale(1.06); }
  .footer-avatar-frame { width: 28px; height: 28px; }

  .brand-avatar,
  .footer-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-2);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--ink);
    background: var(--glass-tint);
  }

  .nav-links a[aria-current='page'],
  .nav-links a[aria-current='location'] {
    color: var(--ink);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta {
    padding: 0.65rem 1.15rem;
    font-size: 0.875rem;
  }

  /* Mobile menu: native <details>, no framework needed */
  .mobile-menu { display: none; position: relative; }

  .mobile-menu summary {
    list-style: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .burger { display: grid; gap: 5px; }
  .burger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s var(--ease-out);
  }
  .mobile-menu[open] .burger span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .mobile-menu[open] .burger span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(82vw, 280px);
    display: grid;
    padding: 0.5rem;
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
  }

  .mobile-panel a {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    color: var(--ink);
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current='page'],
  .mobile-panel a[aria-current='location'] { background: var(--glass-tint); }

  .mobile-panel a:last-child {
    margin-top: 0.25rem;
    border-top: 1px solid var(--rule);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    color: var(--ink-2);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .header-container { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 380px) {
    .header-cta { padding: 0.55rem 0.85rem; }
  }

  /* Footer */
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--glass-border-subtle);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 1px 0 0 var(--glass-edge-highlight);
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(180px, 0.75fr);
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer-brand-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
  }

  .footer-brand p {
    color: var(--ink-2);
    margin: 0.75rem 0 1rem;
    max-width: 44ch;
  }

  .footer-mail {
    display: inline-block;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .social-pill {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
    color: var(--ink-2);
    transition: transform 0.4s var(--spring-ios), background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.25s var(--ease-ios);
  }

  .social-pill:hover {
    transform: translateY(-2px) scale(1.05);
    background: var(--glass-tint);
    border-color: var(--glass-tint-border);
    color: var(--accent-ink);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
  }

  .social-pill:active {
    transform: scale(0.94);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: 0.25rem;
  }

  .footer-col a { color: var(--ink-2); font-weight: 500; }
  .footer-col a:hover { color: var(--accent-ink); }

  .footer-bottom {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--glass-border-subtle);
  }

  .footer-bottom p { margin: 0; }

  @media (max-width: 640px) {
    .footer-container { grid-template-columns: 1fr; }
  }

  /* Accessibility: Skip to Content */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1.5rem;
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.875rem;
    z-index: 1000;
    transition: top 0.2s var(--ease-out);
  }
  .skip-to-content:focus { top: 1rem; color: var(--on-accent); }
</style>
