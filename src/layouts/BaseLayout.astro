---
import '../styles/global.css';
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { FOOTER_COPY, NAV_ITEMS, SEO_DEFAULTS, SITE_IDENTITY } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = SEO_DEFAULTS.title,
  description = SEO_DEFAULTS.description,
  image = SEO_DEFAULTS.ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href,
  noindex = false,
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href;
const ogImage = new URL(image, Astro.site || SITE_IDENTITY.siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      name: SITE_IDENTITY.personName,
      alternateName: [...SITE_IDENTITY.alternateNames],
      url: SITE_IDENTITY.siteUrl,
      image: `${SITE_IDENTITY.siteUrl}/images/founder/reuben-studio.webp`,
      email: SITE_IDENTITY.email,
      jobTitle: SITE_IDENTITY.role,
      worksFor: {
        '@type': 'Organization',
        name: SITE_IDENTITY.companyName,
        url: SITE_IDENTITY.companyUrl,
      },
      knowsAbout: [...SEO_DEFAULTS.knowsAbout],
      sameAs: SOCIAL_LINKS.map((s) => s.url),
      description: SEO_DEFAULTS.personDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_IDENTITY.siteUrl}/#website`,
      url: SITE_IDENTITY.siteUrl,
      name: SITE_IDENTITY.brandName,
      publisher: {
        '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Beneru (Reuben Magallanes)" />
    <meta name="publisher" content="Beneru" />
    <meta name="keywords" content={SEO_DEFAULTS.keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Beneru" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Schema.org Structured Data for Reuben Magallanes (Beneru) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="json-ld" />

    <!-- Spawntel Brand Guidelines Typography: Poppins + General Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a href="#main" class="skip-to-content">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="wordmark" aria-label="Beneru home">
          {SITE_IDENTITY.wordmark}<span class="wordmark-dot" aria-hidden="true">.</span>
        </a>

        <nav aria-label="Primary" class="nav-links" data-primary-nav>
          {NAV_ITEMS.map((item) => (
            <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a
            href={spawntelFunnelUrl('header')}
            class="cta-btn header-cta"
            data-spawntel-cta="header"
          >
            <span>Book a Call</span>
            <span class="cta-btn__circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>

          <details class="mobile-menu">
            <summary aria-label="Toggle navigation menu">
              <svg class="plus-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
              </svg>
            </summary>
            <nav aria-label="Mobile" class="mobile-panel">
              {NAV_ITEMS.map((item) => (
                <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
              ))}
              <a href="/privacy/">Privacy Policy</a>
              <a href={SITE_IDENTITY.mailto} class="mobile-email">{SITE_IDENTITY.email}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="ft-wrap">
        <div class="ft-top">
          <div class="ft-cols">
            <div class="ft-col">
              <h3>Site</h3>
              <ul>
                {FOOTER_COPY.siteLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="ft-col">
              <h3>Systems</h3>
              <ul>
                {FOOTER_COPY.buildLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="ft-col">
              <h3>Contact &amp; Legal</h3>
              <ul>
                <li>
                  <a href={spawntelFunnelUrl('footer')} data-spawntel-cta="footer">Book a Call</a>
                </li>
                <li><a href={FOOTER_COPY.mailto}>Email me</a></li>
                <li><a href="/privacy/">Privacy Policy</a></li>
              </ul>
            </div>
          </div>

          <div class="ft-col ft-follow">
            <h3>Follow</h3>
            <ul class="ft-socials" aria-label="Social accounts">
              {SOCIAL_LINKS.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${s.label} (${s.handle})`}
                    title={`${s.label} (${s.handle})`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={s.iconSvg} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="ft-bottom">
          <span>&copy; {new Date().getFullYear()} {FOOTER_COPY.copyrightHolder}. All rights reserved.</span>
          <a href="#top">Back to top &uarr;</a>
        </div>
      </div>

      <div class="ft-mark-wrap" aria-hidden="true">
        <svg class="ft-mark" viewBox="0 0 1200 218" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="beneru-mark-fill" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#3E3654" stop-opacity="0.76" />
              <stop offset="58%" stop-color="#201C2C" stop-opacity="0.48" />
              <stop offset="100%" stop-color="#101012" stop-opacity="0.04" />
            </linearGradient>
            <linearGradient id="beneru-mark-stroke" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#9A88CA" stop-opacity="0.48" />
              <stop offset="72%" stop-color="#4A3F66" stop-opacity="0.16" />
              <stop offset="100%" stop-color="#101012" stop-opacity="0" />
            </linearGradient>
          </defs>
          <text
            x="600"
            y="198"
            text-anchor="middle"
            textLength="1160"
            lengthAdjust="spacing"
            fill="url(#beneru-mark-fill)"
            stroke="url(#beneru-mark-stroke)"
            stroke-width="2"
          >
            {FOOTER_COPY.wordmark}
          </text>
        </svg>
      </div>
    </footer>

    <script>
      // Scroll reveal: IntersectionObserver only.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Section scroll-spy on homepage using IntersectionObserver.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
      if ('IntersectionObserver' in window && navLinks.length > 0) {
        const sectionIds = Array.from(new Set(Array.from(navLinks).map((a) => a.dataset.sectionLink).filter(Boolean))) as string[];
        const topClearIds = ['hero', 'proof'];
        const observedIds = [...topClearIds, ...sectionIds];
        const sections = observedIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
        if (sectionIds.some((id) => document.getElementById(id))) {
          const spy = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const activeId = entry.target.id;
                  const isClear = topClearIds.includes(activeId);
                  navLinks.forEach((link) => {
                    if (!isClear && link.dataset.sectionLink === activeId) {
                      link.setAttribute('aria-current', 'location');
                    } else {
                      link.removeAttribute('aria-current');
                    }
                  });
                }
              });
            },
            { rootMargin: '-28% 0px -55% 0px', threshold: 0 },
          );
          sections.forEach((sec) => spy.observe(sec));
        } else if (location.pathname.startsWith('/work/')) {
          navLinks.forEach((link) => {
            if (link.dataset.sectionLink === 'work') {
              link.setAttribute('aria-current', 'page');
            }
          });
        }
      }

      // Mobile menu: close on link click, Escape key, or outside click.
      const menus = document.querySelectorAll<HTMLDetailsElement>('.mobile-menu');
      menus.forEach((menu) => {
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menus.forEach((menu) => {
            if (menu.hasAttribute('open')) {
              menu.removeAttribute('open');
              menu.querySelector('summary')?.focus();
            }
          });
        }
      });
      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (!target) return;
        menus.forEach((menu) => {
          if (menu.hasAttribute('open') && !menu.contains(target)) {
            menu.removeAttribute('open');
          }
        });
      });

      // Notify Reuben once per visitor session when someone clicks through to spawntel.com.
      const FUNNEL_PING_KEY = 'beneru_spawntel_ping';
      document.querySelectorAll<HTMLAnchorElement>('[data-spawntel-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem(FUNNEL_PING_KEY)) return;
            sessionStorage.setItem(FUNNEL_PING_KEY, '1');
          } catch {
            // Continue without sessionStorage if blocked by privacy settings.
          }
          const payload = JSON.stringify({
            placement: link.dataset.spawntelCta || 'cta',
            page: location.pathname,
            referrer: document.referrer || '',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/funnel-click', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/funnel-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 11, 12, 0.76);
    -webkit-backdrop-filter: var(--blur-nav);
    backdrop-filter: var(--blur-nav);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    width: var(--site-w);
    margin-inline: auto;
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .wordmark {
    justify-self: start;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.055em;
    line-height: 1;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }

  .wordmark-dot {
    color: var(--violet-bright);
    font-size: 1.45em;
    line-height: 0;
    margin-left: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-2);
    padding: 6px 2px;
    transition: color 0.16s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'],
  .nav-links a[aria-current='location'] {
    color: var(--ink);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-cta {
    height: 42px;
    padding: 0 7px 0 18px;
    font-size: 13.5px;
  }

  .header-cta .cta-btn__circle {
    width: 26px;
    height: 26px;
  }

  /* Mobile circular + toggle */
  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    box-shadow: var(--shadow-violet);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out), filter 0.16s ease;
  }

  .mobile-menu summary:hover {
    filter: brightness(1.12);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .plus-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.24s var(--ease-out);
  }

  .mobile-menu[open] .plus-icon {
    transform: rotate(45deg);
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(84vw, 276px);
    display: grid;
    gap: 4px;
    padding: 8px;
    border-radius: 20px;
    background: rgba(18, 18, 22, 0.96);
    -webkit-backdrop-filter: var(--blur-nav);
    backdrop-filter: var(--blur-nav);
    border: 1px solid var(--border-strong);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.72);
  }

  .mobile-panel a {
    padding: 11px 14px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current='location'],
  .mobile-panel a[aria-current='page'] {
    background: rgba(103, 0, 255, 0.16);
    color: #FFFFFF;
  }

  .mobile-panel .mobile-email {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    font-size: 13px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nav-links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      height: 40px;
      padding: 0 6px 0 15px;
      font-size: 13px;
      gap: 9px;
    }
    .mobile-menu summary {
      width: 40px;
      height: 40px;
    }
  }

  /* ---------- Footer ---------- */
  .ft {
    position: relative;
    z-index: 2;
    background: #101012;
    color: var(--ink);
    padding-top: clamp(52px, 6.5vw, 84px);
    overflow: hidden;
    border-top: 1px solid rgba(103, 0, 255, 0.24);
    box-shadow: 0 -24px 80px -40px rgba(103, 0, 255, 0.35);
  }

  .ft-wrap {
    width: var(--site-w);
    margin-inline: auto;
  }

  .ft-top {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1.15fr);
    gap: 36px;
  }

  .ft-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .ft-col h3 {
    font-family: var(--font-sans);
    color: var(--ink-muted);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0 0 16px;
  }

  .ft-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft-col a {
    color: rgba(255, 255, 255, 0.88);
    font-size: 15px;
    transition: color 0.16s ease;
  }

  .ft-col a:hover {
    color: #FFFFFF;
  }

  .ft-col .ft-socials {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ft-socials a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #242429;
    color: rgba(255, 255, 255, 0.9);
    display: grid;
    place-items: center;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.2s var(--ease-out);
  }

  .ft-socials a:hover {
    background: var(--primary);
    color: #FFFFFF;
    transform: translateY(-3px);
  }

  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(48px, 6vw, 72px);
    font-size: 13px;
    color: var(--ink-muted);
  }

  .ft-bottom a {
    color: rgba(255, 255, 255, 0.85);
  }

  .ft-bottom a:hover {
    color: #FFFFFF;
  }

  .ft-mark-wrap {
    width: 100%;
    max-width: 1400px;
    padding-inline: clamp(8px, 1.5vw, 22px);
    margin: clamp(14px, 2.4vw, 28px) auto 0;
    line-height: 0;
    user-select: none;
    pointer-events: none;
  }

  .ft-mark {
    width: 100%;
    height: auto;
    display: block;
  }

  .ft-mark text {
    font-family: var(--font-heading);
    font-size: 244px;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  @media (max-width: 980px) {
    .ft-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 571px) {
    .ft-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  /* Accessibility: Skip to Content */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1.5rem;
    background: var(--primary);
    color: #FFFFFF;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    z-index: 1000;
    transition: top 0.2s var(--ease-out);
  }

  .skip-to-content:focus {
    top: 1rem;
  }
</style>
