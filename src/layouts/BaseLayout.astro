---
import '../styles/global.css';
import { spawntelFunnelUrl } from '../../shared/funnel';
import { SOCIAL_LINKS } from '../../shared/socials';
import { FOOTER_COPY, NAV_ITEMS, SEO_DEFAULTS, SITE_IDENTITY } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = SEO_DEFAULTS.title,
  description = SEO_DEFAULTS.description,
  image = SEO_DEFAULTS.ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href,
  noindex = false,
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site || SITE_IDENTITY.siteUrl).href;
const ogImage = new URL(image, Astro.site || SITE_IDENTITY.siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      name: SITE_IDENTITY.personName,
      alternateName: [...SITE_IDENTITY.alternateNames],
      url: SITE_IDENTITY.siteUrl,
      image: `${SITE_IDENTITY.siteUrl}/images/founder/reuben-studio.webp`,
      email: SITE_IDENTITY.email,
      jobTitle: SITE_IDENTITY.role,
      worksFor: {
        '@type': 'Organization',
        name: SITE_IDENTITY.companyName,
        url: SITE_IDENTITY.companyUrl,
      },
      knowsAbout: [...SEO_DEFAULTS.knowsAbout],
      sameAs: SOCIAL_LINKS.map((s) => s.url),
      description: SEO_DEFAULTS.personDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_IDENTITY.siteUrl}/#website`,
      url: SITE_IDENTITY.siteUrl,
      name: SITE_IDENTITY.brandName,
      publisher: {
        '@id': `${SITE_IDENTITY.siteUrl}/#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Beneru (Reuben Magallanes)" />
    <meta name="publisher" content="Beneru" />
    <meta name="keywords" content={SEO_DEFAULTS.keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0D0814" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Beneru" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Schema.org Structured Data for Reuben Magallanes (Beneru) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="json-ld" />

    <!-- Spawntel Brand Guidelines Typography: Poppins + General Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a href="#main" class="skip-to-content">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="wordmark" aria-label="Beneru home">
          <img src="/PFP.webp" alt="" width="28" height="28" class="wordmark-av" decoding="async" />
          <span class="wordmark-text">
            {SITE_IDENTITY.wordmark}<span class="wordmark-dot" aria-hidden="true">.</span>
          </span>
        </a>

        <nav aria-label="Primary" class="nav-pill" data-primary-nav>
          {NAV_ITEMS.map((item) => (
            <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a
            href={spawntelFunnelUrl('header')}
            class="cta-btn header-cta"
            data-spawntel-cta="header"
          >
            <span>Book a Call</span>
            <span class="cta-btn__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>

          <details class="mobile-menu">
            <summary aria-label="Toggle navigation menu">
              <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16" />
                <path d="M4 12h16" />
                <path d="M4 17h16" />
              </svg>
            </summary>
            <nav aria-label="Mobile" class="mobile-panel">
              {NAV_ITEMS.map((item) => (
                <a href={item.href} data-section-link={item.sectionId}>{item.label}</a>
              ))}
              <a href="/privacy/">Privacy Policy</a>
              <a href={SITE_IDENTITY.mailto} class="mobile-email">{SITE_IDENTITY.email}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="site-wrap">
        <div class="ft-grid">
          <div class="ft-brand">
            <a href="/" class="wordmark ft-wordmark">
              <img src="/PFP.webp" alt="" width="30" height="30" class="wordmark-av" loading="lazy" />
              <span class="wordmark-text">
                {SITE_IDENTITY.wordmark}<span class="wordmark-dot" aria-hidden="true">.</span>
              </span>
            </a>
            <p class="ft-desc">
              Personal brand of {SITE_IDENTITY.personName} ({SITE_IDENTITY.shortName}), {SITE_IDENTITY.role} at {SITE_IDENTITY.companyName}. {SITE_IDENTITY.niche}.
            </p>
            <ul class="ft-socials" aria-label="Social accounts">
              {SOCIAL_LINKS.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${s.label} (${s.handle})`}
                    title={`${s.label} (${s.handle})`}
                  >
                    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" set:html={s.iconSvg} />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="ft-col">
            <h3>Navigation</h3>
            <ul>
              {FOOTER_COPY.siteLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="ft-col">
            <h3>Documented Builds</h3>
            <ul>
              {FOOTER_COPY.buildLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="ft-col">
            <h3>Connect</h3>
            <ul>
              <li>
                <a href={spawntelFunnelUrl('footer')} data-spawntel-cta="footer">Book a Call on Spawntel</a>
              </li>
              <li><a href={FOOTER_COPY.mailto}>{FOOTER_COPY.email}</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
            </ul>
          </div>
        </div>

        <div class="ft-bottom">
          <span>&copy; {new Date().getFullYear()} {FOOTER_COPY.copyrightHolder}. Built on Cloudflare Workers.</span>
          <a href="#top" class="ft-top-link">Back to top &uarr;</a>
        </div>
      </div>
    </footer>

    <script>
      // Scroll reveal: IntersectionObserver only.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Section scroll-spy on homepage using IntersectionObserver.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
      if ('IntersectionObserver' in window && navLinks.length > 0) {
        const sectionIds = Array.from(new Set(Array.from(navLinks).map((a) => a.dataset.sectionLink).filter(Boolean))) as string[];
        const topClearIds = ['hero', 'proof'];
        const observedIds = [...topClearIds, ...sectionIds];
        const sections = observedIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
        if (sectionIds.some((id) => document.getElementById(id))) {
          const spy = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const activeId = entry.target.id;
                  const isClear = topClearIds.includes(activeId);
                  navLinks.forEach((link) => {
                    if (!isClear && link.dataset.sectionLink === activeId) {
                      link.setAttribute('aria-current', 'location');
                    } else {
                      link.removeAttribute('aria-current');
                    }
                  });
                }
              });
            },
            { rootMargin: '-28% 0px -55% 0px', threshold: 0 },
          );
          sections.forEach((sec) => spy.observe(sec));
        } else if (location.pathname.startsWith('/work/')) {
          navLinks.forEach((link) => {
            if (link.dataset.sectionLink === 'work') {
              link.setAttribute('aria-current', 'page');
            }
          });
        }
      }

      // Mobile menu: close on link click, Escape key, or outside click.
      const menus = document.querySelectorAll<HTMLDetailsElement>('.mobile-menu');
      menus.forEach((menu) => {
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menus.forEach((menu) => {
            if (menu.hasAttribute('open')) {
              menu.removeAttribute('open');
              menu.querySelector('summary')?.focus();
            }
          });
        }
      });
      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (!target) return;
        menus.forEach((menu) => {
          if (menu.hasAttribute('open') && !menu.contains(target)) {
            menu.removeAttribute('open');
          }
        });
      });

      // Notify Reuben once per visitor session when someone clicks through to spawntel.com.
      const FUNNEL_PING_KEY = 'beneru_spawntel_ping';
      document.querySelectorAll<HTMLAnchorElement>('[data-spawntel-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem(FUNNEL_PING_KEY)) return;
            sessionStorage.setItem(FUNNEL_PING_KEY, '1');
          } catch {
            // Continue without sessionStorage if blocked by privacy settings.
          }
          const payload = JSON.stringify({
            placement: link.dataset.spawntelCta || 'cta',
            page: location.pathname,
            referrer: document.referrer || '',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/funnel-click', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/funnel-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(13, 8, 20, 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    width: var(--site-w);
    margin-inline: auto;
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .wordmark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }

  .wordmark-av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(183, 155, 255, 0.35);
    flex-shrink: 0;
  }

  .wordmark-text {
    font-family: var(--font-heading);
    font-size: 15.5px;
    font-weight: 800;
    letter-spacing: 0.055em;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
  }

  .wordmark-dot {
    color: var(--violet-bright);
    font-size: 1.4em;
    line-height: 0;
    margin-left: 0.02em;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-full);
    background: var(--surface-1);
    border: 1px solid var(--border);
  }

  .nav-pill a {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .nav-pill a:hover {
    color: var(--ink);
  }

  .nav-pill a[aria-current='page'],
  .nav-pill a[aria-current='location'] {
    background: rgba(103, 0, 255, 0.22);
    color: #FFFFFF;
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-cta {
    height: 40px;
    padding: 0 18px;
    font-size: 13.5px;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .mobile-menu summary:hover {
    background: var(--surface-2);
    border-color: var(--border-violet);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(84vw, 276px);
    display: grid;
    gap: 4px;
    padding: 8px;
    border-radius: 18px;
    background: #171222;
    border: 1px solid var(--border-strong);
    box-shadow: 0 22px 54px rgba(0, 0, 0, 0.72);
  }

  .mobile-panel a {
    padding: 11px 14px;
    border-radius: 11px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-body);
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current='location'],
  .mobile-panel a[aria-current='page'] {
    background: rgba(103, 0, 255, 0.2);
    color: #FFFFFF;
  }

  .mobile-panel .mobile-email {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 11px 11px;
    font-size: 13px;
    color: var(--ink-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nav-pill {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      height: 38px;
      padding: 0 14px;
      font-size: 13px;
      gap: 7px;
    }
    .mobile-menu summary {
      width: 38px;
      height: 38px;
    }
  }

  /* ---------- Footer ---------- */
  .ft {
    position: relative;
    background: var(--bg-deep);
    border-top: 1px solid var(--border);
    padding: clamp(48px, 6vw, 76px) 0 clamp(28px, 4vw, 40px);
  }

  .ft-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(32px, 4.5vw, 48px);
    border-bottom: 1px solid var(--border);
  }

  .ft-brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ft-desc {
    margin: 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .ft-socials {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ft-socials a {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--surface-1);
    border: 1px solid var(--border);
    color: var(--ink-body);
    display: grid;
    place-items: center;
    transition: background-color 0.16s ease, border-color 0.16s ease, transform 0.16s var(--ease-out);
  }

  .ft-socials a:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .ft-col h3 {
    font-family: var(--font-sans);
    color: var(--violet-soft);
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 14px;
  }

  .ft-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .ft-col a {
    color: var(--ink-2);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }

  .ft-col a:hover {
    color: var(--ink);
  }

  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 24px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .ft-top-link {
    color: var(--ink-body);
    font-weight: 500;
  }

  .ft-top-link:hover {
    color: var(--violet-soft);
  }

  @media (max-width: 960px) {
    .ft-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ft-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .ft-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Accessibility: Skip to Content */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1.5rem;
    background: var(--primary);
    color: #FFFFFF;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    z-index: 1000;
    transition: top 0.2s var(--ease-out);
  }

  .skip-to-content:focus {
    top: 1rem;
  }
</style>
