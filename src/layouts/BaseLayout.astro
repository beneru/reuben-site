---
import '../styles/global.css';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { spawntelFunnelUrl } from '../../shared/funnel';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const { title, description, image = '/PFP.png', canonical = new URL(Astro.url.pathname, Astro.site || 'https://beneru.spawntel.com').href } = Astro.props;
const navItems = [
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Articles', href: '/articles' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'https://beneru.spawntel.com').href;
const ogImage = new URL(image, Astro.site || 'https://beneru.spawntel.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Beneru (Reuben Magallanes)" />
    <meta name="publisher" content="Beneru" />
    <meta name="keywords" content="Beneru, AI Marketing Direction, Reuben Magallanes, Ben Magallanes, Beneru AI, Spawntel, Employmo, AI automation, marketing automation Philippines, content multiplication, inbound lead capture" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/PFP.png" />
    <link rel="apple-touch-icon" href="/PFP.png" />
    <link rel="canonical" href={canonical} />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Beneru" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <title>{title}</title>

    <!-- Schema.org Structured Data for Beneru & Reuben Magallanes -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://beneru.spawntel.com/#person",
            "name": "Beneru",
            "alternateName": ["Reuben Magallanes", "Ben Magallanes", "Beneru AI"],
            "url": "https://beneru.spawntel.com",
            "image": "https://beneru.spawntel.com/PFP.png",
            "jobTitle": "Founder & AI Marketing Director",
            "worksFor": {
              "@type": "Organization",
              "name": "Spawntel",
              "url": "https://spawntel.com"
            },
            "sameAs": [
              "https://instagram.com/Beneru.ai",
              "https://spawntel.com"
            ],
            "description": "Founder of Spawntel and builder of Beneru, providing AI marketing direction, automated content distribution, and intelligent growth systems."
          },
          {
            "@type": "WebSite",
            "@id": "https://beneru.spawntel.com/#website",
            "url": "https://beneru.spawntel.com",
            "name": "Beneru",
            "alternateName": "Beneru AI",
            "publisher": {
              "@id": "https://beneru.spawntel.com/#person"
            }
          }
        ]
      }
    </script>
    <slot name="json-ld" />
    <meta name="theme-color" content="#FCFCFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0B14" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <AmbientBackdrop />
    <a href="#main" class="skip-to-content">Skip to content</a>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand-logo" aria-label="Beneru home">
          <picture class="brand-avatar-frame">
            <source srcset="/PFP.webp" type="image/webp" />
            <img src="/PFP.png" alt="" width="32" height="32" class="brand-avatar" loading="eager" />
          </picture>
          <span>Beneru</span>
        </a>

        <nav aria-label="Primary" class="nav-links">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a href={spawntelFunnelUrl('header')} class="btn btn-primary header-cta" data-spawntel-cta="header">Book on Spawntel</a>
          <details class="mobile-menu">
            <summary aria-label="Open menu">
              <span class="burger" aria-hidden="true"><span></span><span></span></span>
            </summary>
            <nav aria-label="Mobile" class="mobile-panel">
              {navItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              ))}
              <a href="mailto:hello@beneru.spawntel.com">hello@beneru.spawntel.com</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-brand">
          <div class="footer-brand-title">
            <picture class="footer-avatar-frame">
              <source srcset="/PFP.webp" type="image/webp" />
              <img src="/PFP.png" alt="" width="28" height="28" class="footer-avatar" loading="lazy" />
            </picture>
            <strong>Beneru</strong>
          </div>
          <p>AI marketing direction and automated growth workflows by Reuben Magallanes.</p>
          <a class="footer-mail" href="mailto:hello@beneru.spawntel.com">hello@beneru.spawntel.com</a>
        </div>
        <nav class="footer-col" aria-label="Footer">
          <span class="footer-label">Site</span>
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-col">
          <span class="footer-label">Elsewhere</span>
          <a href="https://instagram.com/Beneru.ai" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={spawntelFunnelUrl('footer')} data-spawntel-cta="footer">Spawntel.com</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Beneru (Reuben Magallanes). All rights reserved.</p>
      </div>
    </footer>

    <!-- Cookie & Privacy Consent Notice (DPA 2012 / GDPR compliance) -->
    <CookieConsent />

    <script>
      // Scroll reveal: IntersectionObserver only, no scroll listeners.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Close the mobile menu after picking a link.
      document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
      });

      // Notify Reuben once per visitor session when someone clicks through to spawntel.com.
      const FUNNEL_PING_KEY = 'beneru_spawntel_ping';
      document.querySelectorAll<HTMLAnchorElement>('[data-spawntel-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem(FUNNEL_PING_KEY)) return;
            sessionStorage.setItem(FUNNEL_PING_KEY, '1');
          } catch {
            // Continue without sessionStorage if blocked by privacy settings.
          }
          const payload = JSON.stringify({
            placement: link.dataset.spawntelCta || 'cta',
            page: location.pathname,
            referrer: document.referrer || '',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/funnel-click', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/funnel-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--glass-bg-strong) 84%, var(--glass-tint));
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--glass-border-subtle);
    box-shadow: inset 0 -1px 0 0 rgba(255, 255, 255, 0.35), 0 4px 20px -12px rgba(42, 16, 102, 0.14);
  }

  .header-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 68px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .brand-logo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: -0.03em;
    justify-self: start;
  }

  .brand-logo:hover { color: var(--ink); }

  .brand-avatar-frame,
  .footer-avatar-frame {
    display: inline-flex;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--accent);
  }

  .brand-avatar-frame { width: 32px; height: 32px; transition: transform 0.25s var(--ease-out); }
  .brand-logo:hover .brand-avatar-frame { transform: rotate(-6deg) scale(1.06); }
  .footer-avatar-frame { width: 28px; height: 28px; }

  .brand-avatar,
  .footer-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-2);
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-full);
    transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--ink);
    background: var(--glass-tint);
  }

  .nav-links a[aria-current='page'] {
    color: var(--ink);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta {
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem;
  }

  /* Mobile menu: native <details>, no framework needed */
  .mobile-menu { display: none; position: relative; }

  .mobile-menu summary {
    list-style: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid var(--glass-border-subtle);
    box-shadow: var(--glass-highlight), var(--shadow-sm);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .burger { display: grid; gap: 5px; }
  .burger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s var(--ease-out);
  }
  .mobile-menu[open] .burger span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .mobile-menu[open] .burger span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(80vw, 280px);
    display: grid;
    padding: 0.5rem;
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
  }

  .mobile-panel a {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    color: var(--ink);
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current='page'] { background: var(--glass-tint); }

  .mobile-panel a:last-child {
    margin-top: 0.25rem;
    border-top: 1px solid var(--rule);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  @media (max-width: 860px) {
    .header-container { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 380px) {
    .header-cta { padding: 0.55rem 0.85rem; }
  }

  /* Footer */
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--glass-border-subtle);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.45);
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer-brand-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
  }

  .footer-brand p {
    color: var(--ink-2);
    margin: 0.75rem 0 1rem;
    max-width: 34ch;
  }

  .footer-mail {
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-label {
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-bottom: 0.25rem;
  }

  .footer-col a { color: var(--ink-2); font-weight: 500; }
  .footer-col a:hover { color: var(--accent-ink); }

  .footer-bottom {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .footer-bottom p { margin: 0; }

  @media (max-width: 640px) {
    .footer-container { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }

  /* Accessibility: Skip to Content */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1.5rem;
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.875rem;
    z-index: 1000;
    transition: top 0.2s var(--ease-out);
  }
  .skip-to-content:focus { top: 1rem; color: var(--on-accent); }
</style>
